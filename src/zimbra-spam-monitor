# ==============================================================================
# HELPER FUNCTIONS & CONFIGURATION MANAGEMENT
# ==============================================================================
load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        local tmp_cfg
        tmp_cfg=$(mktemp 2>/dev/null || echo "/tmp/zsm_cfg_$$")
        tr -d '\r' < "$CONFIG_FILE" > "$tmp_cfg"
        # shellcheck disable=SC1090
        source "$tmp_cfg"
        rm -f "$tmp_cfg"
    fi
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    local log_dir
    log_dir=$(dirname "$MONITOR_LOG_FILE")
    mkdir -p "$log_dir" 2>/dev/null || true
}

ensure_config_file_exists() {
