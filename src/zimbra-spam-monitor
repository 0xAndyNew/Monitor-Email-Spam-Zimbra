lower_priority_self() {
    # Lower only this monitor process priority so Zimbra/Postfix always get CPU/IO first
    if command -v renice >/dev/null 2>&1; then
        renice +10 $$ >/dev/null 2>&1 || true
    fi
    if command -v ionice >/dev/null 2>&1; then
        ionice -c3 -p $$ >/dev/null 2>&1 || true
    fi
}

make_safe_tmp() {
    local prefix="${1:-zsm}"
    local tmpf=""
    (
        umask 077
        if command -v mktemp >/dev/null 2>&1; then
            mktemp "/tmp/${prefix}.XXXXXX" 2>/dev/null || mktemp 2>/dev/null
        else
            local fallback="${STATE_DIR}/.${prefix}.$$.$RANDOM"
            : > "$fallback"
            chmod 600 "$fallback" 2>/dev/null || true
            echo "$fallback"
        fi
    )
}

run_with_timeout() {
    local secs="$1"
    shift
    if command -v timeout >/dev/null 2>&1 && [[ "$secs" =~ ^[0-9]+$ ]] && (( secs > 0 )); then
        timeout "$secs" "$@"
    else
        "$@"
    fi
}

