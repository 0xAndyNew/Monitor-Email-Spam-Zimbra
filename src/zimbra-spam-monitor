submenu_logs_and_service() {
    while true; do
        load_config
        local svc_label="ON (Running)"
        [[ "$MONITOR_ENABLED" != "true" ]] && svc_label="PAUSED (Disabled)"

        local choice
        choice=$(ui_select_menu "LOGS, SERVICE, RBL & AUDIT" \
            "Log file: ${MONITOR_LOG_FILE}" \
            "1" "View Last 25 Monitor Log Lines" \
            "2" "Service Status       : ${svc_label} (Select to Toggle)" \
            "3" "Check Server IP RBL  (Read-only DNSBL blacklist check)" \
            "4" "Security Audit       (100% Read-only Zimbra posture check)" \
            "0" "Back")

        case "$choice" in
            1)
                local log_txt="(No log entries yet)"
                if [[ -f "$MONITOR_LOG_FILE" ]]; then
                    log_txt=$(tail -n 25 "$MONITOR_LOG_FILE" 2>/dev/null || echo "(Empty)")
                fi
                ui_msg_box "RECENT MONITOR LOGS" "$log_txt"
                ;;
            2)
                if [[ "$MONITOR_ENABLED" == "true" ]]; then
                    update_cfg_var "MONITOR_ENABLED" "false"
                else
                    update_cfg_var "MONITOR_ENABLED" "true"
                fi
                ;;
            3)
                local rbl_out
                rbl_out=$(run_rbl_check "manual" 2>&1 || true)
                ui_msg_box "SELF-RBL REPUTATION CHECK" "$rbl_out"
                ;;
            4)
                local aud_out
                aud_out=$(run_security_audit 2>&1 || true)
                ui_msg_box "READ-ONLY SECURITY AUDIT" "$aud_out"
                ;;
            0|"") break ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# MAIN CONTROL PANEL (6 CLEAN ITEMS - 100% BACKWARD COMPATIBLE SHORTCUTS)
# ------------------------------------------------------------------------------
run_interactive_menu() {
    while true; do
        load_config
        resolve_zimbra_settings

        local mon_badge="ON"
        [[ "$MONITOR_ENABLED" != "true" ]] && mon_badge="PAUSED"

        local lock_badge="ON"
        [[ "$AUTO_LOCK_ON_CRITICAL" != "true" ]] && lock_badge="OFF"

        local cron_badge
        cron_badge=$(get_current_cron_interval)

        local tg_badge="ON"
        [[ "$TELEGRAM_ENABLED" != "true" || -z "$TELEGRAM_BOT_TOKEN" ]] && tg_badge="OFF"
        local em_badge="ON"
        [[ "$EMAIL_ENABLED" != "true" ]] && em_badge="OFF"

        local choice
        choice=$(ui_select_menu "ZIMBRA SPAM MONITOR v${VERSION}" \
            "Service: ${mon_badge} | Check: ${cron_badge} | Auto-Lock: ${lock_badge} | TG: ${tg_badge} | Mail: ${em_badge}" \
            "1" "Live Status & Queue" \
            "2" "Alerts & Test          (Telegram / Email / Webhook / Test)" \
            "3" "Spam Limits & Schedule (Limit: ${WARN_RECIPIENTS}/${CRIT_RECIPIENTS} | ${LOOKBACK_MINUTES}m | 1h: ${WARN_HOURLY_MESSAGES}/${CRIT_HOURLY_MESSAGES})" \
            "4" "Unlock & Auto-Lock     (Auto-Lock: ${lock_badge} | Queue Control)" \
            "5" "Whitelist & Limits     (Trusted & Custom Per-User Limits)" \
            "6" "Logs, RBL & Audit      (Service: ${mon_badge} | Read-Only Audit)" \
            "0" "Exit")

        case "$choice" in
            1)
                local st_out
                st_out=$(show_status 2>&1 || true)
                if [[ -n "$(detect_tui_bin)" ]]; then
                    ui_msg_box "LIVE SYSTEM STATUS" "$st_out"
                else
                    echo "$st_out"
                    read -r -p " Press Enter to return to menu..." _ || true
                fi
                ;;
            2) submenu_notifications ;;
            3) submenu_thresholds ;;
            4) submenu_lock_control ;;
            5) submenu_whitelist ;;
            6) submenu_logs_and_service ;;
            0|"")
                echo "Exited Zimbra Spam Monitor."
                break
                ;;
        esac
    done
}

