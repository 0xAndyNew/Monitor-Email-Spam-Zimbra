# MAIN CONTROL PANEL (6 CLEAN ITEMS)
# ------------------------------------------------------------------------------
run_interactive_menu() {
    while true; do
        load_config
        resolve_zimbra_settings

        local mon_badge="ON"
        [[ "$MONITOR_ENABLED" != "true" ]] && mon_badge="PAUSED"

        local lock_badge="ON"
        [[ "$AUTO_LOCK_ON_CRITICAL" != "true" ]] && lock_badge="OFF"

        local cron_badge
        cron_badge=$(get_current_cron_interval)

        local tg_badge="ON"
        [[ "$TELEGRAM_ENABLED" != "true" || -z "$TELEGRAM_BOT_TOKEN" ]] && tg_badge="OFF"
        local em_badge="ON"
        [[ "$EMAIL_ENABLED" != "true" ]] && em_badge="OFF"

        local choice
        choice=$(ui_select_menu "ZIMBRA SPAM MONITOR v${VERSION}" \
            "Service: ${mon_badge} | Check: ${cron_badge} | Auto-Lock: ${lock_badge} | TG: ${tg_badge} | Mail: ${em_badge}" \
            "1" "Live Status & Queue" \
            "2" "Alerts & Test          (Telegram / Email / Send Test)" \
            "3" "Spam Limits & Schedule (Limit: ${WARN_RECIPIENTS}/${CRIT_RECIPIENTS} | ${LOOKBACK_MINUTES}m | Repeat: ${ALERT_COOLDOWN_MINUTES}m)" \
            "4" "Unlock & Auto-Lock     (Auto-Lock: ${lock_badge})" \
            "5" "Whitelist              (Trusted Emails & Domains)" \
            "6" "Logs & Service ON/OFF  (Service: ${mon_badge})" \
            "0" "Exit")

        case "$choice" in
            1)
                local st_out
                st_out=$(show_status 2>&1 || true)
                if [[ -n "$(detect_tui_bin)" ]]; then
                    ui_msg_box "LIVE SYSTEM STATUS" "$st_out"
                else
                    echo "$st_out"
                    read -r -p " Press Enter to return to menu..." _ || true
                fi
                ;;
            2) submenu_notifications ;;
            3) submenu_thresholds ;;
            4) submenu_lock_control ;;
            5) submenu_whitelist ;;
            6) submenu_logs_and_service ;;
            0|"")
                echo "Exited Zimbra Spam Monitor."
                break
                ;;
        esac
    done
}

show_help() {
    cat <<EOF
Zimbra Outbound Spam Monitor v${VERSION}
Multi-signal outbound spam detection, Telegram & Email alerting, and automatic account locking for Zimbra.

Usage:
  zimbra-spam-monitor                        Open Interactive Control Panel (TUI / Menu)
  zimbra-spam-monitor --menu                 Open Interactive Control Panel (TUI Dialog)
  zimbra-spam-monitor --text-menu            Open Number Selection Menu (Text mode)
  zimbra-spam-monitor --run                  Run background scan cycle (used by Cron)
  zimbra-spam-monitor --status               Show live ${LOOKBACK_MINUTES}-min metrics & Postfix Queue table
  zimbra-spam-monitor --test                 Send a test notification to Telegram & Email
  zimbra-spam-monitor --unlock <email>       Unlock a locked Zimbra account & clear prior history
  zimbra-spam-monitor --whitelist-add <mail> Add an email or @domain.com to Whitelist
  zimbra-spam-monitor --help                 Show this help message
EOF
}

# ==============================================================================
# ENTRYPOINT
# ==============================================================================
if [[ $# -eq 0 ]]; then
    if [[ -t 0 && -t 1 ]]; then
        ACTION="--menu"
    else
        ACTION="--run"
    fi
else
    ACTION="$1"
fi

case "$ACTION" in
    --menu|-m|--configure|configure|config|menu)
        run_interactive_menu
        ;;
    --text-menu)
        ZSM_UI_MODE="text"
        run_interactive_menu
        ;;
    --run|run)
        run_monitor_cycle
        ;;
    --status|status)
        show_status
        ;;
    --test|test)
        run_test_alert
        ;;
    --unlock|unlock)
        unlock_account "${2:-}"
        ;;
    --whitelist-add)
        if [[ -z "${2:-}" ]]; then
            echo "Usage: zimbra-spam-monitor --whitelist-add <email@domain.com>"
            exit 1
        fi
        load_config
        echo "${2}" >> "$WHITELIST_FILE"
        echo "[OK] Added ${2} to whitelist (${WHITELIST_FILE})."
        ;;
    --version|-v)
        echo "zimbra-spam-monitor version ${VERSION}"
        ;;
    --help|-h|*)
        show_help
        ;;
esac
