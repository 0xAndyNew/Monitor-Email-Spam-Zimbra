                while IFS= read -r line; do
                    local clean
                    clean=$(echo "$line" | tr -d '\r' | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//')
                    [[ -z "$clean" ]] && continue
                    wl_items+=("$idx" "$clean")
                    wl_map[$idx]="$clean"
                    idx=$(( idx + 1 ))
                done < "$WHITELIST_FILE"

                if (( idx == 1 )); then
                    ui_msg_box "WHITELIST EMPTY" "There are no entries to remove."
                else
                    wl_items+=("0" "Back")
                    local del_idx
                    del_idx=$(ui_select_menu "REMOVE WHITELIST ENTRY" \
                        "Select entry to remove from whitelist:" \
                        "${wl_items[@]}")
                    if [[ -n "$del_idx" && "$del_idx" != "0" && -n "${wl_map[$del_idx]:-}" ]]; then
                        local target_del="${wl_map[$del_idx]}"
                        grep -v -F "$target_del" "$WHITELIST_FILE" > "${WHITELIST_FILE}.tmp" 2>/dev/null || true
                        mv -f "${WHITELIST_FILE}.tmp" "$WHITELIST_FILE"
                        ui_msg_box "REMOVED" "Removed '${target_del}' from whitelist."
                    fi
                fi
                ;;
            0|"")
                break
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# SUBMENU [6]: CRON CHECK SCHEDULE
# ------------------------------------------------------------------------------
submenu_cron_schedule() {
    local cur_cron
    cur_cron=$(get_current_cron_interval)

    local choice
    choice=$(ui_select_menu "CHANGE CRON CHECK SCHEDULE" \
        "Current Schedule: ${cur_cron} (${CRON_FILE})" \
        "1" "Every 1 minute    (*/1 * * * *)" \
        "2" "Every 2 minutes   (*/2 * * * *)" \
        "3" "Every 5 minutes   (*/5 * * * * - Recommended)" \
        "4" "Every 10 minutes  (*/10 * * * *)" \
        "5" "Every 15 minutes  (*/15 * * * *)" \
        "6" "Every 30 minutes  (*/30 * * * *)" \
        "7" "Pause Automatic Cron Schedule" \
        "0" "Back to Main Menu")

    case "$choice" in
        1) set_cron_interval_minutes "1";  ui_msg_box "SCHEDULE UPDATED" "Scan interval set to: Every 1 minute." ;;
        2) set_cron_interval_minutes "2";  ui_msg_box "SCHEDULE UPDATED" "Scan interval set to: Every 2 minutes." ;;
        3) set_cron_interval_minutes "5";  ui_msg_box "SCHEDULE UPDATED" "Scan interval set to: Every 5 minutes." ;;
        4) set_cron_interval_minutes "10"; ui_msg_box "SCHEDULE UPDATED" "Scan interval set to: Every 10 minutes." ;;
        5) set_cron_interval_minutes "15"; ui_msg_box "SCHEDULE UPDATED" "Scan interval set to: Every 15 minutes." ;;
        6) set_cron_interval_minutes "30"; ui_msg_box "SCHEDULE UPDATED" "Scan interval set to: Every 30 minutes." ;;
        7) set_cron_interval_minutes "disable"; ui_msg_box "SCHEDULE PAUSED" "Automatic cron scan has been paused." ;;
    esac
}

# ------------------------------------------------------------------------------
# MAIN CONTROL PANEL
# ------------------------------------------------------------------------------
run_interactive_menu() {
    while true; do
        load_config
        resolve_zimbra_settings

        local mon_badge="ENABLED"
        [[ "$MONITOR_ENABLED" != "true" ]] && mon_badge="DISABLED"

        local lock_badge="ON"
        [[ "$AUTO_LOCK_ON_CRITICAL" != "true" ]] && lock_badge="OFF"

        local cron_badge
        cron_badge=$(get_current_cron_interval)

        local tg_badge="TG:ON"
        [[ "$TELEGRAM_ENABLED" != "true" || -z "$TELEGRAM_BOT_TOKEN" ]] && tg_badge="TG:OFF/Unset"
        local em_badge="Mail:${RESOLVED_EMAIL_TO}"
        [[ "$EMAIL_ENABLED" != "true" ]] && em_badge="Mail:OFF"

        local choice
        choice=$(ui_select_menu "ZIMBRA SPAM MONITOR CONTROL PANEL v${VERSION}" \
            "Status: [${mon_badge}] | Cron: [${cron_badge}] | Auto-Lock: [${lock_badge}]" \
            "1" "View System Status & Top Senders" \
            "2" "Configure Alerts & Test (${tg_badge} | ${em_badge})" \
            "3" "Edit Spam Thresholds (${LOOKBACK_MINUTES}m: ${WARN_SENT_PER_WINDOW}/${CRIT_SENT_PER_WINDOW} | 60m: ${WARN_SENT_PER_HOUR}/${CRIT_SENT_PER_HOUR})" \
            "4" "Auto-Lock Settings & Unlock Accounts (Auto-Lock: ${lock_badge})" \
            "5" "Manage Sender Whitelist (View / Add / Remove)" \
            "6" "Change Cron Check Schedule (${cron_badge})" \
            "7" "Enable / Disable Monitoring Service (Current: ${mon_badge})" \
            "8" "View Recent Monitor Logs (/var/log/zimbra-spam-monitor.log)" \
            "0" "Exit")

        case "$choice" in
            1)
                local st_out
                st_out=$(show_status 2>&1 || true)
                if [[ -n "$(detect_tui_bin)" ]]; then
                    ui_msg_box "CURRENT SYSTEM STATUS" "$st_out"
                else
                    echo "$st_out"
                    read -r -p " Press Enter to return to menu..." _ || true
                fi
                ;;
            2)
                submenu_notifications
                ;;
            3)
                submenu_thresholds
                ;;
            4)
                submenu_lock_control
                ;;
            5)
                submenu_whitelist
                ;;
            6)
                submenu_cron_schedule
                ;;
            7)
                if [[ "$MONITOR_ENABLED" == "true" ]]; then
                    update_cfg_var "MONITOR_ENABLED" "false"
                    ui_msg_box "MONITORING DISABLED" "Monitoring is now PAUSED (MONITOR_ENABLED=false)."
                else
                    update_cfg_var "MONITOR_ENABLED" "true"
                    ui_msg_box "MONITORING ENABLED" "Monitoring is now ACTIVE (MONITOR_ENABLED=true)."
                fi
                ;;
            8)
                local log_txt="(No log entries yet)"
                if [[ -f "$MONITOR_LOG_FILE" ]]; then
                    log_txt=$(tail -n 25 "$MONITOR_LOG_FILE" 2>/dev/null || echo "(Empty)")
                fi
                ui_msg_box "LAST 25 LOG LINES (${MONITOR_LOG_FILE})" "$log_txt"
                ;;
            0|"")
                echo "Exited Zimbra Spam Monitor Control Panel."
                break
                ;;
        esac
    done
}

show_help() {
    cat <<EOF
Zimbra Outbound Spam Monitor v${VERSION}
Outbound spam detection, Telegram & Email alerting, and automatic account locking for Zimbra.

Usage:
  zimbra-spam-monitor                        Open Interactive Control Panel (TUI / Menu)
  zimbra-spam-monitor --menu                 Open Interactive Control Panel (TUI Dialog)
  zimbra-spam-monitor --text-menu            Open Number Selection Menu (Text mode)
  zimbra-spam-monitor --run                  Run background scan cycle (used by Cron)
  zimbra-spam-monitor --status               Show current Top Senders & Postfix Queue table
  zimbra-spam-monitor --test                 Send a test notification to Telegram & Email
  zimbra-spam-monitor --unlock <email>       Unlock a locked Zimbra account & clear cooldown
  zimbra-spam-monitor --whitelist-add <mail> Add an email or @domain.com to Whitelist
  zimbra-spam-monitor --help                 Show this help message
EOF
}

# ==============================================================================
# ENTRYPOINT
# ==============================================================================
if [[ $# -eq 0 ]]; then
    if [[ -t 0 && -t 1 ]]; then
        ACTION="--menu"
    else
        ACTION="--run"
    fi
else
    ACTION="$1"
fi

case "$ACTION" in
    --menu|-m|--configure|configure|config|menu)
        run_interactive_menu
        ;;
    --text-menu)
        ZSM_UI_MODE="text"
        run_interactive_menu
        ;;
    --run|run)
        run_monitor_cycle
        ;;
    --status|status)
        show_status
        ;;
    --test|test)
        run_test_alert
        ;;
    --unlock|unlock)
        unlock_account "${2:-}"
        ;;
    --whitelist-add)
        if [[ -z "${2:-}" ]]; then
            echo "Usage: zimbra-spam-monitor --whitelist-add <email@domain.com>"
            exit 1
        fi
        load_config
        echo "${2}" >> "$WHITELIST_FILE"
        echo "[OK] Added ${2} to whitelist (${WHITELIST_FILE})."
        ;;
    --version|-v)
        echo "zimbra-spam-monitor version ${VERSION}"
        ;;
    --help|-h|*)
        show_help
        ;;
esac
