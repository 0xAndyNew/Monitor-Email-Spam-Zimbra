  <code>Active: ${active_queue} | Deferred: ${def_queue} | Hold: ${hold_queue}</code>

<b>[2] SYSTEM OUTBOUND (LAST ${LOOKBACK_MINUTES}M)</b>
<b>Total Traffic:</b> <b>${sys_tot}</b> emails
  <code>Sent: ${sys_snt} | Deferred: ${sys_def} | Bounced: ${sys_bnc}</code>
<code>==============================</code>
EOF
)
            q_mail_body=$(cat <<EOF
============================================================
         ZIMBRA QUEUE WARNING
============================================================
Server        : ${srv_host} (${srv_ip})
Alert Time    : ${now_str}

------------------------------------------------------------
[1] REMAINING MAIL QUEUE
------------------------------------------------------------
System Queue  : ${total_queue} emails (Limit: ${WARN_TOTAL_QUEUE})
                Active: ${active_queue} | Deferred: ${def_queue} | Hold: ${hold_queue}

------------------------------------------------------------
[2] SYSTEM OUTBOUND (LAST ${LOOKBACK_MINUTES} MINS)
------------------------------------------------------------
Total Traffic : ${sys_tot} emails
                Sent: ${sys_snt} | Deferred: ${sys_def} | Bounced: ${sys_bnc}
============================================================
EOF
)
            q_gjson=$(printf '{"version":"%s","event":"queue_warning","severity":"WARNING","server":"%s","server_ip":"%s","alert_time":"%s","total_queue":%d,"active":%d,"deferred":%d,"hold":%d}' \
                "$VERSION" "$(json_escape "$srv_host")" "$(json_escape "$srv_ip")" "$(json_escape "$now_str")" "$total_queue" "$active_queue" "$def_queue" "$hold_queue")
            q_wh_json=$(build_webhook_payload "$q_mail_body" "$q_gjson")
            log_json_event "$q_gjson"
            dispatch_notifications "sys_queue" "$q_tg_msg" "[Zimbra Queue Warning] ${total_queue} queued emails on ${srv_host}" "$q_mail_body" "$total_queue" "$q_wh_json" || true
            record_alert_state "__SYSTEM_TOTAL_QUEUE__" "WARNING"
        fi
    fi

    # 6. Post-scan checks (run AFTER remediation so DNS latency never delays account locking)
    run_rbl_check "auto"
    maybe_send_daily_summary "$tmp_roll_sum" "$srv_host" "$srv_ip" "$total_queue"
    trim_attacker_ip_log

    printf '%s\n' "$now_epoch" > "$last_run_file" 2>/dev/null || true
    _cleanup_run_cycle
    trap - EXIT INT TERM
}

# ==============================================================================
# STATUS DASHBOARD, TEST ALERT & UNLOCK COMMANDS
# ==============================================================================
show_status() {
    load_config
    resolve_zimbra_settings

    local now_epoch="${ZSM_NOW_EPOCH:-$(date +%s)}"
    local local_ips awk_bin
    local_ips=$(get_local_ips)
    awk_bin=$(find_awk_bin)

    local tmp_log_stats tmp_sys_sum tmp_bkt_stats tmp_aux_web tmp_aux_auth tmp_q_stats tmp_q_sum tmp_roll_sum
    tmp_log_stats=$(make_safe_tmp "zsm_st_log")
    tmp_sys_sum=$(make_safe_tmp "zsm_st_sys")
    tmp_bkt_stats=$(make_safe_tmp "zsm_st_bkt")
    tmp_aux_web=$(make_safe_tmp "zsm_st_aw")
    tmp_aux_auth=$(make_safe_tmp "zsm_st_aa")
    tmp_q_stats=$(make_safe_tmp "zsm_st_q")
    tmp_q_sum=$(make_safe_tmp "zsm_st_qsum")
    tmp_roll_sum=$(make_safe_tmp "zsm_st_roll")

    analyze_aux_zimbra_logs "$tmp_aux_web" "$tmp_aux_auth" "$now_epoch" "$local_ips" "$awk_bin"
    analyze_zimbra_log "$tmp_log_stats" "$tmp_sys_sum" "$tmp_bkt_stats" "" "$tmp_aux_web" "" "$LOOKBACK_MINUTES"
    analyze_postfix_queue "$tmp_q_stats" "$tmp_q_sum"
    update_and_summarize_rolling_history "$tmp_bkt_stats" "$tmp_roll_sum" "true"

    local sys_summary sys_tot sys_snt sys_def sys_bnc
    sys_summary=$(cat "$tmp_sys_sum" 2>/dev/null || echo "0|0|0|0")
    IFS='|' read -r sys_tot sys_snt sys_def sys_bnc <<< "$sys_summary"

    local q_summary total_queue active_queue def_queue hold_queue
    q_summary=$(cat "$tmp_q_sum" 2>/dev/null || echo "0|0|0|0")
    IFS='|' read -r total_queue active_queue def_queue hold_queue <<< "$q_summary"

    local outbox_cnt=0
    if [[ -d "$STATE_DIR/outbox" ]]; then
        outbox_cnt=$(find "$STATE_DIR/outbox" -maxdepth 1 -name '*.msg' 2>/dev/null | wc -l | tr -d ' ')
    fi

    local locked_cnt=0 locked_preview="None"
    if [[ -s "$STATE_DIR/locked_accounts.db" ]]; then
        locked_cnt=$(grep -c '[^[:space:]]' "$STATE_DIR/locked_accounts.db" 2>/dev/null || echo "0")
        locked_preview=$(awk -F'|' 'NF>=1 && $1!="" {printf "%s%s", (c++ ? ", " : ""), $1; if (c>=4) exit}' "$STATE_DIR/locked_accounts.db" 2>/dev/null || echo "None")
        (( locked_cnt > 4 )) && locked_preview="${locked_preview} (+$(( locked_cnt - 4 )) more)"
    fi

    echo "=============================================================================="
    echo " ZIMBRA SPAM MONITOR v${VERSION} - LIVE SYSTEM STATUS (LAST ${LOOKBACK_MINUTES} MINS)"
    echo "=============================================================================="
    echo " Zimbra Server   : $(get_server_hostname) ($(get_server_ip))"
    echo " Monitor Status  : ${MONITOR_ENABLED} | Range: ${LOOKBACK_MINUTES}m | Cooldown: ${ALERT_COOLDOWN_MINUTES}m | Auto-Lock: ${AUTO_LOCK_ON_CRITICAL}"
    echo " Alert Channels  : TG=${TELEGRAM_ENABLED} | Mail=${EMAIL_ENABLED} (${RESOLVED_EMAIL_TO}) | Webhook=${WEBHOOK_ENABLED} | Outbox=${outbox_cnt}"
    echo " Locked Accounts : ${locked_cnt} (${locked_preview})"
    echo " System Outbound : ${sys_tot} emails (Sent: ${sys_snt} | Deferred: ${sys_def} | Bounced: ${sys_bnc})"
    echo " Postfix Queue   : ${total_queue} emails (Active: ${active_queue} | Deferred: ${def_queue} | Hold: ${hold_queue})"
    echo "------------------------------------------------------------------------------"
    printf " %-26s | %-5s | %-13s | %-6s | %-3s | %-10s\n" "SENDER (${LOOKBACK_MINUTES}m)" "MSGS" "RCPTS (UNIQ)" "FAIL%" "IPs" "SPAM/SPOOF"
    echo "------------------------------------------------------------------------------"
    if [[ -s "$tmp_log_stats" ]]; then
        head -n 15 "$tmp_log_stats" | while IFS='|' read -r s m r ur ud snt def bnc ipc ripc spf amv rbl orig lst ips tsp; do
            local fl=$(( def + bnc ))
            local fp_x10=0
            if (( r > 0 )); then
                fp_x10=$(( (fl * 1000 + r / 2) / r ))
            fi
            local fp_str="$(( fp_x10 / 10 )).$(( fp_x10 % 10 ))%"
            local rcpt_col="${r} (${ur})"
            local sig_col="$(( amv + rbl )) / ${spf}"
            printf " %-26s | %-5s | %-13s | %-6s | %-3s | %-10s\n" "$s" "$m" "$rcpt_col" "$fp_str" "$ipc" "$sig_col"
        done
    else
        echo " (No outbound email traffic in the last ${LOOKBACK_MINUTES} minutes)"
    fi
    echo "------------------------------------------------------------------------------"
    printf " %-32s | %-12s | %-28s\n" "SENDERS IN POSTFIX QUEUE" "LIVE (HOLD)" "STATUS / REASON"
    echo "------------------------------------------------------------------------------"
    if [[ -s "$tmp_q_stats" ]]; then
        head -n 10 "$tmp_q_stats" | while IFS='|' read -r u ql qh qr; do
            local qcol="${ql} (${qh})"
            printf " %-32s | %-12s | %-28s\n" "$u" "$qcol" "$qr"
        done
    else
        echo " (Mail queue is clean)"
    fi
    echo "=============================================================================="

    rm -f "$tmp_log_stats" "$tmp_sys_sum" "$tmp_bkt_stats" "$tmp_aux_web" "$tmp_aux_auth" "$tmp_q_stats" "$tmp_q_sum" "$tmp_roll_sum"
}

