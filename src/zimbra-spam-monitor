# ==============================================================================
# MAIN CHECK CYCLE (--run)
# ==============================================================================
_RUN_CLEANUP_FILES=()
_RUN_LOCK_DIR=""

_cleanup_run_cycle() {
    local f
    for f in "${_RUN_CLEANUP_FILES[@]}"; do
        [[ -n "$f" ]] && rm -f "$f" 2>/dev/null || true
    done
    if [[ -n "$_RUN_LOCK_DIR" && -d "$_RUN_LOCK_DIR" ]]; then
        rm -rf "$_RUN_LOCK_DIR" 2>/dev/null || true
    fi
    exec 9>&- 2>/dev/null || true
}

run_monitor_cycle() {
    lower_priority_self
    load_config
    if [[ "$MONITOR_ENABLED" != "true" ]]; then
        return 0
    fi

    mkdir -p "$STATE_DIR" 2>/dev/null || true
    _TG_SENT_IN_CYCLE=0
    _RUN_CLEANUP_FILES=()
    _RUN_LOCK_DIR=""

    # Atomic non-blocking process lock: flock on Linux, POSIX mkdir fallback elsewhere
    local lock_file="$STATE_DIR/monitor.lock"
    if command -v flock >/dev/null 2>&1; then
        exec 9>"$lock_file"
        if ! flock -n 9; then
            log_msg "WARN" "Previous scan is still running (flock); skipping cycle."
            return 0
        fi
    else
        local lock_dir="$STATE_DIR/monitor.lock.d"
        if ! mkdir "$lock_dir" 2>/dev/null; then
            local old_pid=""
            old_pid=$(cat "$lock_dir/pid" 2>/dev/null || echo "")
            if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
                log_msg "WARN" "Previous scan (PID $old_pid) is still running; skipping cycle."
                return 0
            fi
            rm -rf "$lock_dir" 2>/dev/null || true
            if ! mkdir "$lock_dir" 2>/dev/null; then
                return 0
            fi
        fi
        printf '%s\n' "$$" > "$lock_dir/pid" 2>/dev/null || true
        _RUN_LOCK_DIR="$lock_dir"
    fi
    trap '_cleanup_run_cycle' EXIT INT TERM

    resolve_zimbra_settings
    load_whitelist_cache

    # 1. Retry any previously failed alerts stored in outbox before scanning
    flush_alert_outbox

    # 2. Check monitor log health (alerts if zimbra.log missing or stale)
    check_monitor_health

    local now_epoch="${ZSM_NOW_EPOCH:-$(date +%s)}"
    local srv_host srv_ip now_str now_date
    srv_host=$(get_server_hostname)
    srv_ip=$(get_server_ip)
    now_str=$(date -d "@$now_epoch" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date '+%Y-%m-%d %H:%M:%S')
    now_date=$(date -d "@$now_epoch" '+%Y-%m-%d' 2>/dev/null || date '+%Y-%m-%d')

    # Compute history_scan_mins so changing cron schedule never leaves blind gaps in 1h/24h history
    local history_scan_mins="$LOOKBACK_MINUTES"
    local last_run_file="$STATE_DIR/last_run.ts"
    if [[ -f "$last_run_file" ]]; then
        local last_run_ts
        last_run_ts=$(cat "$last_run_file" 2>/dev/null || echo "0")
        if [[ "$last_run_ts" =~ ^[0-9]+$ ]] && (( now_epoch > last_run_ts )); then
            local gap_mins=$(( (now_epoch - last_run_ts + 59) / 60 ))
            if (( gap_mins > history_scan_mins && gap_mins <= 60 )); then
                history_scan_mins="$gap_mins"
            fi
        fi
    fi

    local tmp_log_stats tmp_sys_sum tmp_bkt_stats tmp_qid_map tmp_sasl_fail
    local tmp_aux_web tmp_aux_auth tmp_q_stats tmp_q_sum tmp_roll_sum tmp_merged
    tmp_log_stats=$(make_safe_tmp "zsm_log")
    tmp_sys_sum=$(make_safe_tmp "zsm_syssum")
    tmp_bkt_stats=$(make_safe_tmp "zsm_bkt")
    tmp_qid_map=$(make_safe_tmp "zsm_qmap")
    tmp_sasl_fail=$(make_safe_tmp "zsm_sfail")
    tmp_aux_web=$(make_safe_tmp "zsm_auxw")
    tmp_aux_auth=$(make_safe_tmp "zsm_auxa")
    tmp_q_stats=$(make_safe_tmp "zsm_q")
    tmp_q_sum=$(make_safe_tmp "zsm_qsum")
    tmp_roll_sum=$(make_safe_tmp "zsm_rsum")
    tmp_merged=$(make_safe_tmp "zsm_merged")
    _RUN_CLEANUP_FILES=("$tmp_log_stats" "$tmp_sys_sum" "$tmp_bkt_stats" "$tmp_qid_map" "$tmp_sasl_fail" \
                        "$tmp_aux_web" "$tmp_aux_auth" "$tmp_q_stats" "$tmp_q_sum" "$tmp_roll_sum" "$tmp_merged")

    local local_ips awk_bin
    local_ips=$(get_local_ips)
    awk_bin=$(find_awk_bin)

    # 3. Run single-server aux log reader + main zimbra.log engine + Postfix queue + rolling 1h/24h
    analyze_aux_zimbra_logs "$tmp_aux_web" "$tmp_aux_auth" "$now_epoch" "$local_ips" "$awk_bin"
    analyze_zimbra_log "$tmp_log_stats" "$tmp_sys_sum" "$tmp_bkt_stats" "$tmp_qid_map" "$tmp_aux_web" "$tmp_sasl_fail" "$history_scan_mins"
    analyze_postfix_queue "$tmp_q_stats" "$tmp_q_sum"
    update_and_summarize_rolling_history "$tmp_bkt_stats" "$tmp_roll_sum" "false"

    local sys_summary sys_tot sys_snt sys_def sys_bnc
    sys_summary=$(cat "$tmp_sys_sum" 2>/dev/null || echo "0|0|0|0")
    IFS='|' read -r sys_tot sys_snt sys_def sys_bnc <<< "$sys_summary"

    local q_summary total_queue active_queue def_queue hold_queue
    q_summary=$(cat "$tmp_q_sum" 2>/dev/null || echo "0|0|0|0")
    IFS='|' read -r total_queue active_queue def_queue hold_queue <<< "$q_summary"

    # Merge 5m log metrics + queue live/held + 1h/24h rolling totals + auth-after-fail signals
    "$awk_bin" -F'|' \
        -v f_log="$tmp_log_stats" \
        -v f_q="$tmp_q_stats" \
        -v f_roll="$tmp_roll_sum" \
        -v f_auth="$tmp_aux_auth" '
    FILENAME == f_log {
        s = $1; if (s == "") next
        users[s] = 1
        m[s]=$2; r[s]=$3; ur[s]=$4; ud[s]=$5
        snt[s]=$6; def[s]=$7; bnc[s]=$8
        ipc[s]=$9; ripc[s]=$10; spf[s]=$11; amv[s]=$12; rbl[s]=$13
        orig[s]=$14; lst[s]=$15; ips[s]=$16; tsp[s]=$17
        next
    }
    FILENAME == f_q {
        s = $1; if (s == "") next
        users[s] = 1
        qlive[s] = $2 + 0
        qhold[s] = $3 + 0
        next
    }
    FILENAME == f_roll {
        s = $1; if (s == "") next
        h1m[s] = $2 + 0; h1r[s] = $3 + 0
        d24m[s] = $4 + 0; d24r[s] = $5 + 0
        # Only pull user into evaluation if 1h/24h volume is non-trivial (saves loop work)
        if (h1m[s] > 0 || d24m[s] > 0) users[s] = 1
        next
    }
    FILENAME == f_auth && $1 == "AUTH_AFTER_FAIL" {
        s = tolower($2); if (s == "") next
        users[s] = 1
        aaf_ip[s] = $3
        aaf_cnt[s] = $4 + 0
        next
    }
    END {
        for (u in users) {
            printf "%s|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%s|%d|%s|%d|%s|%s\n",
                u,
                m[u]+0, r[u]+0, ur[u]+0, ud[u]+0,
                snt[u]+0, def[u]+0, bnc[u]+0,
                ipc[u]+0, ripc[u]+0, spf[u]+0, amv[u]+0, rbl[u]+0,
                qlive[u]+0, qhold[u]+0,
                h1m[u]+0, h1r[u]+0, d24m[u]+0, d24r[u]+0,
                (orig[u] != "" ? orig[u] : "Queued/Unknown"),
                lst[u]+0,
                (aaf_ip[u] != "" ? aaf_ip[u] : ""),
                aaf_cnt[u]+0,
                (ips[u] != "" ? ips[u] : "queued/unknown"),
                (tsp[u] != "" ? tsp[u] : "-")
        }
    }
    ' "$tmp_log_stats" "$tmp_q_stats" "$tmp_roll_sum" "$tmp_aux_auth" \
        | sort -t'|' -k3,3nr -k14,14nr -k16,16nr > "$tmp_merged"

    local alerts_triggered=0
    local detail_alerts_sent=0
    local locks_performed_in_cycle=0
    local overflow_count=0
    local overflow_lines=""
    local overflow_html=""

    while IFS='|' read -r sender msgs rcpts uniq_rcpts uniq_doms snt def bnc ip_cnt real_ip_cnt spoof_cnt amavis_cnt rbl_cnt q_cnt q_hold h1_msgs h1_rcpts d24_msgs d24_rcpts s_origin last_sub_ts aaf_ip aaf_cnt s_ips s_tspan; do
        [[ -z "$sender" ]] && continue

        # Skip fully whitelisted accounts/domains
        if is_whitelisted "$sender"; then
            continue
        fi

        # Resolve effective thresholds (per-account custom limit if configured in whitelist.conf)
        local eff_warn_rcpts="$WARN_RECIPIENTS"
        local eff_crit_rcpts="$CRIT_RECIPIENTS"
        local eff_warn_msgs="$WARN_MESSAGES_SENT"
        local eff_crit_msgs="$CRIT_MESSAGES_SENT"
        local eff_warn_uniq="$WARN_UNIQUE_RECIPIENTS"
        local eff_crit_uniq="$CRIT_UNIQUE_RECIPIENTS"
        local custom_lim=""
        if custom_lim=$(get_custom_limits "$sender"); then
            IFS='|' read -r eff_warn_rcpts eff_crit_rcpts <<< "$custom_lim"
            # For custom per-account limits (email WARN CRIT), honor the exact WARN/CRIT volume
            # across msgs, recipients, and unique recipients so 1-rcpt bulk senders work intuitively.
            eff_warn_msgs="$eff_warn_rcpts"
            eff_crit_msgs="$eff_crit_rcpts"
            eff_warn_uniq="$eff_warn_rcpts"
            eff_crit_uniq="$eff_crit_rcpts"
        fi

        local failed_cnt=$(( def + bnc ))
        local fail_pct_x10=0
        local fail_pct_str="0.0"
        if (( rcpts > 0 )); then
            fail_pct_x10=$(( (failed_cnt * 1000 + rcpts / 2) / rcpts ))
            fail_pct_str="$(( fail_pct_x10 / 10 )).$(( fail_pct_x10 % 10 ))"
        fi

        local severity="NORMAL"
        local reasons=""
        local has_non_spam_crit=0

        # Special handling for local-pickup-uid:* (local script / webshell sending with external From)
        if [[ "$sender" == local-pickup-uid:* ]]; then
            if (( msgs >= WARN_PICKUP_EXTERNAL_MESSAGES )); then
                severity="CRITICAL"
                reasons="Local Pickup External From (${msgs}>=${WARN_PICKUP_EXTERNAL_MESSAGES})"
                has_non_spam_crit=1
            fi
        else
            # 1. Messages Sent (5m)
            if (( msgs >= eff_crit_msgs )); then
                severity="CRITICAL"; has_non_spam_crit=1
                reasons=$(append_reason "$reasons" "Msgs (${msgs}>=${eff_crit_msgs})")
            elif (( msgs >= eff_warn_msgs )); then
                [[ "$severity" == "NORMAL" ]] && severity="WARNING"
                reasons=$(append_reason "$reasons" "Msgs (${msgs}>=${eff_warn_msgs})")
            fi

            # 2. Total Recipients (5m, requires CRIT_MIN_MESSAGES_FOR_BULK to protect single CC/BCC)
            if (( rcpts >= eff_crit_rcpts && msgs >= CRIT_MIN_MESSAGES_FOR_BULK )); then
                severity="CRITICAL"; has_non_spam_crit=1
                reasons=$(append_reason "$reasons" "Rcpts (${rcpts}>=${eff_crit_rcpts})")
            elif (( rcpts >= eff_warn_rcpts )); then
                [[ "$severity" == "NORMAL" ]] && severity="WARNING"
                reasons=$(append_reason "$reasons" "Rcpts (${rcpts}>=${eff_warn_rcpts})")
            fi

            # 3. Unique Recipients across External Domains (5m)
            if (( uniq_doms >= MIN_EXTERNAL_DOMAINS_FOR_UNIQUE )); then
                if (( uniq_rcpts >= eff_crit_uniq && msgs >= CRIT_MIN_MESSAGES_FOR_BULK )); then
                    severity="CRITICAL"; has_non_spam_crit=1
                    reasons=$(append_reason "$reasons" "Unique Rcpts (${uniq_rcpts}>=${eff_crit_uniq})")
                elif (( uniq_rcpts >= eff_warn_uniq )); then
                    [[ "$severity" == "NORMAL" ]] && severity="WARNING"
                    reasons=$(append_reason "$reasons" "Unique Rcpts (${uniq_rcpts}>=${eff_warn_uniq})")
                fi
            fi

            # 4. Failed Rate ((Deferred + Bounced + Expired) / Recipients %)
            # Requires CRIT_MIN_MESSAGES_FOR_BULK so 1 single BCC email deferred by a DNS/ISP hiccup stays WARNING
            if (( rcpts >= CRIT_MIN_RECIPIENTS_FOR_FAIL_RATE && msgs >= CRIT_MIN_MESSAGES_FOR_BULK && fail_pct_x10 >= CRIT_FAILED_RATE_PCT * 10 )); then
                severity="CRITICAL"; has_non_spam_crit=1
                reasons=$(append_reason "$reasons" "Failed Rate (${fail_pct_str}%>=${CRIT_FAILED_RATE_PCT}%)")
            elif (( rcpts >= MIN_RECIPIENTS_FOR_FAIL_RATE && fail_pct_x10 >= WARN_FAILED_RATE_PCT * 10 )); then
                [[ "$severity" == "NORMAL" ]] && severity="WARNING"
                reasons=$(append_reason "$reasons" "Failed Rate (${fail_pct_str}%>=${WARN_FAILED_RATE_PCT}%)")
            fi

            # 5. Distinct Source /24 Subnets (Botnet detection, mobile-4G-safe)
            if (( ip_cnt >= CRIT_SOURCE_IPS && msgs >= CRIT_MIN_MESSAGES_FOR_IPS )); then
                severity="CRITICAL"; has_non_spam_crit=1
                reasons=$(append_reason "$reasons" "Source IPs (${ip_cnt}>=${CRIT_SOURCE_IPS})")
            elif (( ip_cnt >= WARN_SOURCE_IPS && msgs >= WARN_MIN_MESSAGES_FOR_IPS )); then
                [[ "$severity" == "NORMAL" ]] && severity="WARNING"
                reasons=$(append_reason "$reasons" "Source IPs (${ip_cnt}>=${WARN_SOURCE_IPS})")
            fi

            # 6. External Sender Spoofing (per unique message)
            if (( spoof_cnt >= CRIT_SPOOF_COUNT )); then
                severity="CRITICAL"; has_non_spam_crit=1
                reasons=$(append_reason "$reasons" "Spoof From (${spoof_cnt}>=${CRIT_SPOOF_COUNT})")
            elif (( spoof_cnt >= WARN_SPOOF_COUNT )); then
                [[ "$severity" == "NORMAL" ]] && severity="WARNING"
                reasons=$(append_reason "$reasons" "Spoof From (${spoof_cnt}>=${WARN_SPOOF_COUNT})")
            fi

            # 7. Amavis SPAM/INFECTED/BANNED & Remote RBL Rejections
            # Auto-forward safeguard: non-SASL local/webmail origin with ONLY Amavis/RBL stays WARNING
            local spam_sig=$(( amavis_cnt + rbl_cnt ))
            local is_sasl_origin=0
            [[ "$s_origin" == *SASL* ]] && is_sasl_origin=1
            if (( spam_sig >= CRIT_SPAM_SIGNALS )); then
                if (( is_sasl_origin == 1 || has_non_spam_crit == 1 || spoof_cnt >= WARN_SPOOF_COUNT )); then
                    severity="CRITICAL"
                else
                    [[ "$severity" == "NORMAL" ]] && severity="WARNING"
                    reasons=$(append_reason "$reasons" "Local/Forward Safeguard")
                fi
                (( amavis_cnt > 0 )) && reasons=$(append_reason "$reasons" "Amavis SPAM (${amavis_cnt})")
                (( rbl_cnt > 0 )) && reasons=$(append_reason "$reasons" "RBL/Spam Reject (${rbl_cnt})")
            elif (( spam_sig >= WARN_SPAM_SIGNALS )); then
                [[ "$severity" == "NORMAL" ]] && severity="WARNING"
                (( amavis_cnt > 0 )) && reasons=$(append_reason "$reasons" "Amavis SPAM (${amavis_cnt})")
                (( rbl_cnt > 0 )) && reasons=$(append_reason "$reasons" "RBL/Spam Reject (${rbl_cnt})")
            fi

            # 8. Account Postfix Queue (Active + Deferred ONLY; already-HELD messages excluded!)
            if (( q_cnt >= CRIT_QUEUE_PER_USER )); then
                if (( msgs == 0 )) && was_recently_unlocked "$sender"; then
                    [[ "$severity" == "NORMAL" ]] && severity="WARNING"
                    reasons=$(append_reason "$reasons" "Leftover Queue (${q_cnt}>=${CRIT_QUEUE_PER_USER})")
                else
                    severity="CRITICAL"; has_non_spam_crit=1
                    reasons=$(append_reason "$reasons" "Account Queue (${q_cnt}>=${CRIT_QUEUE_PER_USER})")
                fi
            elif (( q_cnt >= WARN_QUEUE_PER_USER )); then
                [[ "$severity" == "NORMAL" ]] && severity="WARNING"
                reasons=$(append_reason "$reasons" "Account Queue (${q_cnt}>=${WARN_QUEUE_PER_USER})")
            fi

            # 9. Multi-Window Low-and-Slow Detection (1h CRIT/WARN + 24h WARN-only)
            local eff_h1_warn_m="$WARN_HOURLY_MESSAGES"
            local eff_h1_crit_m="$CRIT_HOURLY_MESSAGES"
            local eff_h1_warn_r="$WARN_HOURLY_RECIPIENTS"
            local eff_h1_crit_r="$CRIT_HOURLY_RECIPIENTS"
            if [[ -n "$custom_lim" ]]; then
                eff_h1_warn_r=$(( eff_warn_rcpts * 5 ))
                eff_h1_crit_r=$(( eff_crit_rcpts * 5 ))
                eff_h1_warn_m=$(( eff_warn_msgs * 5 ))
                eff_h1_crit_m=$(( eff_crit_msgs * 5 ))
            fi

            if (( h1_msgs >= eff_h1_crit_m )); then
                severity="CRITICAL"; has_non_spam_crit=1
                reasons=$(append_reason "$reasons" "1h Msgs (${h1_msgs}>=${eff_h1_crit_m})")
            elif (( h1_msgs >= eff_h1_warn_m )); then
                [[ "$severity" == "NORMAL" ]] && severity="WARNING"
                reasons=$(append_reason "$reasons" "1h Msgs (${h1_msgs}>=${eff_h1_warn_m})")
            fi

            if (( h1_rcpts >= eff_h1_crit_r && h1_msgs >= CRIT_MIN_MESSAGES_FOR_BULK )); then
                severity="CRITICAL"; has_non_spam_crit=1
                reasons=$(append_reason "$reasons" "1h Rcpts (${h1_rcpts}>=${eff_h1_crit_r})")
            elif (( h1_rcpts >= eff_h1_warn_r )); then
                [[ "$severity" == "NORMAL" ]] && severity="WARNING"
                reasons=$(append_reason "$reasons" "1h Rcpts (${h1_rcpts}>=${eff_h1_warn_r})")
            fi

            if (( d24_msgs >= WARN_DAILY_MESSAGES )); then
                [[ "$severity" == "NORMAL" ]] && severity="WARNING"
                reasons=$(append_reason "$reasons" "24h Msgs (${d24_msgs}>=${WARN_DAILY_MESSAGES})")
            elif (( d24_rcpts >= WARN_DAILY_RECIPIENTS )); then
                [[ "$severity" == "NORMAL" ]] && severity="WARNING"
                reasons=$(append_reason "$reasons" "24h Rcpts (${d24_rcpts}>=${WARN_DAILY_RECIPIENTS})")
            fi

            # 10. Auth-After-Fail Compromise Early Warning (never auto-locks by itself)
            if [[ -n "$aaf_ip" ]] && (( aaf_cnt >= AUTH_FAIL_BEFORE_SUCCESS_MIN )); then
                [[ "$severity" == "NORMAL" ]] && severity="WARNING"
                reasons=$(append_reason "$reasons" "Login After ${aaf_cnt} Fails (${aaf_ip})")
                if [[ "$s_ips" == "webmail/local" || "$s_ips" == "queued/unknown" ]]; then
                    s_ips="$aaf_ip"
                fi
            fi

            # 11. Transparent Composite Risk Score (0-100) for multi-weak-signal evasion
            local risk_score=0 risk_sigs=0 risk_qual_sigs=0 r_pct=0
            if [[ "$RISK_SCORE_ENABLED" == "true" ]]; then
                if (( eff_warn_msgs > 0 && msgs > 0 )); then
                    r_pct=$(( (msgs * 100) / eff_warn_msgs ))
                    (( r_pct > 100 )) && r_pct=100
                    if (( r_pct >= 50 )); then risk_score=$(( risk_score + (15 * r_pct) / 100 )); risk_sigs=$(( risk_sigs + 1 )); fi
                fi
                if (( eff_warn_rcpts > 0 && rcpts > 0 )); then
                    r_pct=$(( (rcpts * 100) / eff_warn_rcpts ))
                    (( r_pct > 100 )) && r_pct=100
                    if (( r_pct >= 50 )); then risk_score=$(( risk_score + (15 * r_pct) / 100 )); risk_sigs=$(( risk_sigs + 1 )); fi
                fi
                if (( eff_warn_uniq > 0 && uniq_doms >= MIN_EXTERNAL_DOMAINS_FOR_UNIQUE && uniq_rcpts > 0 )); then
                    r_pct=$(( (uniq_rcpts * 100) / eff_warn_uniq ))
                    (( r_pct > 100 )) && r_pct=100
                    if (( r_pct >= 50 )); then risk_score=$(( risk_score + (15 * r_pct) / 100 )); risk_sigs=$(( risk_sigs + 1 )); fi
                fi
                if (( WARN_QUEUE_PER_USER > 0 && q_cnt > 0 )); then
                    r_pct=$(( (q_cnt * 100) / WARN_QUEUE_PER_USER ))
                    (( r_pct > 100 )) && r_pct=100
                    if (( r_pct >= 50 )); then risk_score=$(( risk_score + (15 * r_pct) / 100 )); risk_sigs=$(( risk_sigs + 1 )); fi
                fi
                if (( WARN_FAILED_RATE_PCT > 0 && rcpts >= MIN_RECIPIENTS_FOR_FAIL_RATE && fail_pct_x10 > 0 )); then
                    r_pct=$(( (fail_pct_x10 * 10) / WARN_FAILED_RATE_PCT ))
                    (( r_pct > 100 )) && r_pct=100
                    if (( r_pct >= 50 )); then risk_score=$(( risk_score + (20 * r_pct) / 100 )); risk_sigs=$(( risk_sigs + 1 )); risk_qual_sigs=$(( risk_qual_sigs + 1 )); fi
                fi
                if (( WARN_SOURCE_IPS > 0 && msgs >= WARN_MIN_MESSAGES_FOR_IPS && ip_cnt > 0 )); then
                    r_pct=$(( (ip_cnt * 100) / WARN_SOURCE_IPS ))
                    (( r_pct > 100 )) && r_pct=100
                    if (( r_pct >= 50 )); then risk_score=$(( risk_score + (20 * r_pct) / 100 )); risk_sigs=$(( risk_sigs + 1 )); risk_qual_sigs=$(( risk_qual_sigs + 1 )); fi
                fi
                if (( WARN_SPOOF_COUNT > 0 && spoof_cnt > 0 )); then
                    r_pct=$(( (spoof_cnt * 100) / WARN_SPOOF_COUNT ))
                    (( r_pct > 100 )) && r_pct=100
                    if (( r_pct >= 50 )); then risk_score=$(( risk_score + (25 * r_pct) / 100 )); risk_sigs=$(( risk_sigs + 1 )); risk_qual_sigs=$(( risk_qual_sigs + 1 )); fi
                fi
                if (( WARN_SPAM_SIGNALS > 0 && spam_sig > 0 )); then
                    r_pct=$(( (spam_sig * 100) / WARN_SPAM_SIGNALS ))
                    (( r_pct > 100 )) && r_pct=100
                    if (( r_pct >= 50 )); then risk_score=$(( risk_score + (25 * r_pct) / 100 )); risk_sigs=$(( risk_sigs + 1 )); risk_qual_sigs=$(( risk_qual_sigs + 1 )); fi
                fi
                if [[ -n "$aaf_ip" ]] && (( aaf_cnt >= AUTH_FAIL_BEFORE_SUCCESS_MIN )); then
                    risk_score=$(( risk_score + 20 )); risk_sigs=$(( risk_sigs + 1 )); risk_qual_sigs=$(( risk_qual_sigs + 1 ))
                fi
                (( risk_score > 100 )) && risk_score=100

                if (( risk_score >= CRIT_RISK_SCORE && risk_sigs >= 3 && risk_qual_sigs >= 1 )); then
                    if [[ "$severity" != "CRITICAL" ]]; then
                        severity="CRITICAL"
                        reasons=$(append_reason "$reasons" "Risk Score (${risk_score}/100 >= ${CRIT_RISK_SCORE})")
                    fi
                elif (( risk_score >= WARN_RISK_SCORE && risk_sigs >= 2 )); then
                    if [[ "$severity" == "NORMAL" ]]; then
                        severity="WARNING"
                        reasons=$(append_reason "$reasons" "Risk Score (${risk_score}/100 >= ${WARN_RISK_SCORE})")
                    fi
                fi
            fi
        fi

        # Desync self-healing for accounts manually unlocked outside zimbra-spam-monitor (e.g. Zimbra Web UI)
        local need_force_relock="false"
        if is_account_already_locked "$sender" && (( msgs > 0 && last_sub_ts > 0 )); then
            local lock_ep
            lock_ep=$(get_locked_account_epoch "$sender")
            if [[ "$lock_ep" =~ ^[0-9]+$ ]] && (( lock_ep > 0 && last_sub_ts > lock_ep + LOCK_RELOCK_GRACE_SECONDS )); then
                if [[ "$severity" == "CRITICAL" ]]; then
                    need_force_relock="true"
                else
                    # Account was clearly unlocked externally and is sending normal mail: clear stale lock record
                    remove_locked_account_record "$sender"
                    log_msg "INFO" "Cleared stale lock record for ${sender} (unlocked externally, sending normal traffic)"
                fi
            fi
        fi

        [[ "$severity" == "NORMAL" ]] && continue

        # DECOUPLED REMEDIATION (runs BEFORE cooldown check so failed locks & holds retry every cycle!)
        local action_taken="NOT LOCKED (Active - Alert Only)"
        local lock_rc=0
        local held_now=0
        if [[ "$severity" == "CRITICAL" ]]; then
            local need_new_lock=0
            if [[ "$AUTO_LOCK_ON_CRITICAL" == "true" ]] && is_valid_email_account "$sender" && ! is_protected_system_account "$sender"; then
                if [[ "$need_force_relock" == "true" ]] || ! is_account_already_locked "$sender"; then
                    need_new_lock=1
                fi
            fi

            if (( need_new_lock == 1 && MAX_LOCKS_PER_CYCLE > 0 && locks_performed_in_cycle >= MAX_LOCKS_PER_CYCLE )); then
                action_taken="NOT LOCKED (Safety cap: MAX_LOCKS_PER_CYCLE=${MAX_LOCKS_PER_CYCLE} reached - check for outage)"
                log_msg "WARN" "Skipped auto-lock for ${sender}: MAX_LOCKS_PER_CYCLE (${MAX_LOCKS_PER_CYCLE}) reached in this cycle"
            else
                action_taken=$(lock_zimbra_account "$sender" "$need_force_relock") || lock_rc=$?
                if (( need_new_lock == 1 && lock_rc == 0 )); then
                    locks_performed_in_cycle=$(( locks_performed_in_cycle + 1 ))
                fi
            fi

            held_now=$(hold_sender_queue "$sender" "$tmp_qid_map" "false")
            if [[ "$held_now" =~ ^[0-9]+$ ]] && (( held_now > 0 )); then
                action_taken="${action_taken} | Held ${held_now} queued"
            fi
            # Record attacker IPs passively to attacker_ips.log (zero OS firewall mutation)
            if [[ "$s_ips" != "webmail/local" && "$s_ips" != "queued/unknown" ]]; then
                local ip_tok
                for ip_tok in $(printf '%s' "$s_ips" | sed 's/ (+.*//' | tr ',' ' '); do
                    record_attacker_ip "$ip_tok" "$sender" "CRITICAL: ${reasons:0:80}"
                done
            fi
        elif is_account_already_locked "$sender"; then
            action_taken=$(format_already_locked_msg "$sender")
        fi

        alerts_triggered=$(( alerts_triggered + 1 ))

        # Notification Cooldown check (bypassed on RE-LOCKED persistent session / re-compromise)
        if [[ "$need_force_relock" != "true" ]] && ! should_send_alert "$sender" "$severity"; then
            log_msg "INFO" "Cooldown active; skipping duplicate alert for $sender [$severity] (state: $action_taken)"
            continue
        fi

        local spam_time_str="$now_str"
        if [[ -n "$s_tspan" && "$s_tspan" != "-" ]]; then
            spam_time_str="${now_date} (${s_tspan})"
        fi

        local ip_display="$s_ips"
        if (( real_ip_cnt > 1 && ip_cnt != real_ip_cnt )); then
            ip_display="${s_ips} (${real_ip_cnt} IPs / ${ip_cnt} /24 nets)"
        elif (( ip_cnt > 1 )); then
            ip_display="${s_ips} (${ip_cnt} IPs)"
        elif (( ip_cnt == 1 )); then
            ip_display="${s_ips} (1 IP)"
        fi

        local reasons_disp="$reasons"
        (( ${#reasons_disp} > 400 )) && reasons_disp="${reasons_disp:0:397}..."

        log_msg "$severity" "Spam detected: user=$sender | origin=$s_origin | score=${risk_score:-0}/100 | reason=[$reasons_disp] | msgs=$msgs (1h=$h1_msgs) | rcpts=$rcpts ($uniq_rcpts uniq) | fail=${fail_pct_str}% | queue=$q_cnt (hold=$q_hold) | action=$action_taken"

        local gjson
        gjson=$(printf '{"version":"%s","event":"spam_alert","severity":"%s","server":"%s","server_ip":"%s","alert_time":"%s","spam_time":"%s","sender":"%s","origin":"%s","account_state":"%s","risk_score":%d,"source_ips":"%s","reasons":"%s","metrics":{"msgs_5m":%d,"rcpts_5m":%d,"uniq_rcpts_5m":%d,"uniq_doms_5m":%d,"sent_5m":%d,"deferred_5m":%d,"bounced_5m":%d,"failed_pct":"%s","msgs_1h":%d,"rcpts_1h":%d,"msgs_24h":%d,"amavis":%d,"spoof":%d,"rbl":%d,"queue_live":%d,"queue_hold":%d}}' \
            "$VERSION" "$severity" "$(json_escape "$srv_host")" "$(json_escape "$srv_ip")" \
            "$(json_escape "$now_str")" "$(json_escape "$spam_time_str")" "$(json_escape "$sender")" \
            "$(json_escape "$s_origin")" "$(json_escape "$action_taken")" "${risk_score:-0}" \
            "$(json_escape "$ip_display")" "$(json_escape "$reasons_disp")" \
            "$msgs" "$rcpts" "$uniq_rcpts" "$uniq_doms" "$snt" "$def" "$bnc" "$fail_pct_str" \
            "$h1_msgs" "$h1_rcpts" "$d24_msgs" "$amavis_cnt" "$spoof_cnt" "$rbl_cnt" "$q_cnt" "$q_hold")
        log_json_event "$gjson"

        # Batch overflow alerts if > MAX_ALERTS_PER_CYCLE to prevent Telegram 429 floods
        if (( detail_alerts_sent >= MAX_ALERTS_PER_CYCLE )); then
            overflow_count=$(( overflow_count + 1 ))
            overflow_lines="${overflow_lines}  - [${severity}] ${sender} (${msgs} msgs / ${rcpts} rcpts | Q:${q_cnt} | ${action_taken})"$'\n'
            overflow_html="${overflow_html}  - <b>[${severity}]</b> <code>$(html_escape "$sender")</code> (${msgs}m/${rcpts}r | ${action_taken:0:24})"$'\n'
            record_alert_state "$sender" "$severity"
            continue
        fi

        local next_steps_txt="" next_steps_html=""
        if [[ "$severity" == "CRITICAL" ]]; then
            local extra_note=""
            if [[ "$need_force_relock" == "true" ]]; then
                extra_note=" (Note: persistent SMTP session or external unlock detected; consider Hold Queue)"
            fi
            next_steps_txt=$'\n'"Next Steps    : 1) Reset password  2) Check mail filters/forwarding  3) Check active sessions${extra_note}"
            next_steps_html=$'\n'"<b>Next Steps   :</b> Reset password, check mail filters/forwarding &amp; sessions$(html_escape "$extra_note")"
        fi

        local tg_msg
        tg_msg=$(cat <<EOF
<b>[ZIMBRA SPAM ${severity}]</b>
<code>==============================</code>
<b>Server       :</b> <code>$(html_escape "$srv_host")</code> (${srv_ip})
