# ==============================================================================
# SINGLE-PASS WHITELIST & PER-ACCOUNT CUSTOM LIMITS LOADER
# Format in whitelist.conf:
#   user@domain.com                 -> Full bypass (backward-compatible)
#   @domain.com                     -> Full domain bypass
#   user@domain.com 500 1000        -> Custom WARN/CRIT recipient limits
#   @domain.com 300 600             -> Custom domain WARN/CRIT recipient limits
# ==============================================================================
load_whitelist_cache() {
    _WL_BYPASS_EMAIL=()
    _WL_BYPASS_DOMAIN=()
    _WL_LIMIT_EMAIL=()
    _WL_LIMIT_DOMAIN=()
    _WL_LOADED=1
    [[ ! -f "$WHITELIST_FILE" ]] && return 0

    local raw_line line key w_lim c_lim
    while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
        line="${raw_line%%#*}"
        line="${line//$'\r'/}"
        # Trim leading/trailing whitespace using pure Bash (zero forks)
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue

        # Normalize "email:500/1000" or "email 500 1000"
        line="${line//:/ }"
        line="${line//\// }"
        read -r key w_lim c_lim _ <<< "$line"
        key="${key,,}"
        [[ -z "$key" ]] && continue

        if [[ -n "$w_lim" && -n "$c_lim" && "$w_lim" =~ ^[0-9]+$ && "$c_lim" =~ ^[0-9]+$ ]]; then
            if [[ "$key" == @* ]]; then
                _WL_LIMIT_DOMAIN["$key"]="${w_lim}|${c_lim}"
            else
                _WL_LIMIT_EMAIL["$key"]="${w_lim}|${c_lim}"
            fi
        else
            if [[ "$key" == @* ]]; then
                _WL_BYPASS_DOMAIN["$key"]=1
            else
                _WL_BYPASS_EMAIL["$key"]=1
            fi
        fi
    done < "$WHITELIST_FILE"
}

is_whitelisted() {
    local email="${1,,}"
    [[ -z "$email" ]] && return 0
    (( _WL_LOADED == 0 )) && load_whitelist_cache

    if [[ -n "${_WL_BYPASS_EMAIL[$email]:-}" ]]; then
        return 0
    fi
    if [[ "$email" == *@* ]]; then
        local domain="@${email#*@}"
        if [[ -n "${_WL_BYPASS_DOMAIN[$domain]:-}" ]]; then
            return 0
        fi
    fi
    return 1
}

get_custom_limits() {
    local email="${1,,}"
    (( _WL_LOADED == 0 )) && load_whitelist_cache

    if [[ -n "${_WL_LIMIT_EMAIL[$email]:-}" ]]; then
        echo "${_WL_LIMIT_EMAIL[$email]}"
        return 0
    fi
    if [[ "$email" == *@* ]]; then
        local domain="@${email#*@}"
        if [[ -n "${_WL_LIMIT_DOMAIN[$domain]:-}" ]]; then
            echo "${_WL_LIMIT_DOMAIN[$domain]}"
            return 0
        fi
    fi
    return 1
}

# ==============================================================================
# ALERT COOLDOWN, UNLOCK CUTOFF, LOCKED HISTORY & ROLLING 1H/24H BUCKETS
# ==============================================================================
should_send_alert() {
    local sender="${1,,}"
    local severity="$2"
    local custom_cooldown_mins="${3:-$ALERT_COOLDOWN_MINUTES}"
    local state_file="$STATE_DIR/cooldown.db"
    local now_ts="${ZSM_NOW_EPOCH:-$(date +%s)}"
    local cooldown_sec=$(( custom_cooldown_mins * 60 ))

    [[ ! -f "$state_file" ]] && return 0

    local prev_line
    prev_line=$(awk -F'|' -v s="$sender" 'tolower($1) == s || tolower($1) == ("^" s) {line=$0} END {if (line != "") print line}' "$state_file" 2>/dev/null || true)
    [[ -z "$prev_line" ]] && return 0

    local prev_sev prev_ts
    IFS='|' read -r _ prev_sev prev_ts _ <<< "$prev_line"

    # Escalation from WARNING to CRITICAL always bypasses cooldown
    if [[ "$severity" == "CRITICAL" && "$prev_sev" != "CRITICAL" ]]; then
        return 0
    fi

    if [[ -n "$prev_ts" && "$prev_ts" =~ ^[0-9]+$ ]] && (( now_ts >= prev_ts && now_ts - prev_ts < cooldown_sec )); then
        return 1
    fi
    return 0
}

record_alert_state() {
    local sender="${1,,}"
    local severity="$2"
    local state_file="$STATE_DIR/cooldown.db"
    local now_ts="${ZSM_NOW_EPOCH:-$(date +%s)}"

    mkdir -p "$STATE_DIR" 2>/dev/null || true
    if [[ -f "$state_file" ]]; then
        awk -F'|' -v s="$sender" 'tolower($1) != s && tolower($1) != ("^" s)' "$state_file" > "${state_file}.tmp" 2>/dev/null || true
        mv -f "${state_file}.tmp" "$state_file"
    fi
    printf '%s|%s|%s\n' "$sender" "$severity" "$now_ts" >> "$state_file"
}

is_account_already_locked() {
    local sender="${1,,}"
    local locked_file="$STATE_DIR/locked_accounts.db"
    [[ ! -f "$locked_file" ]] && return 1
    awk -F'|' -v s="$sender" 'tolower($1) == s {found=1; exit} END {exit(found ? 0 : 1)}' "$locked_file" 2>/dev/null
