    local entry_ep entry_str
    entry_ep=$(awk -F'|' -v s="$sender" 'tolower($1) == s {ep=$3} END {if (ep != "") print ep}' "$locked_file" 2>/dev/null || true)
    if [[ -n "$entry_ep" && "$entry_ep" =~ ^[0-9]+$ ]]; then
        echo "$entry_ep"
