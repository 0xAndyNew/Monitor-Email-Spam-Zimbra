# ==============================================================================
# ENTRYPOINT
# ==============================================================================
if [[ $# -eq 0 ]]; then
    if [[ -t 0 && -t 1 ]]; then
        ACTION="--menu"
    else
        ACTION="--run"
    fi
else
    ACTION="$1"
fi

case "$ACTION" in
    --menu|-m|--configure|configure|config|menu)
        run_interactive_menu
        ;;
    --text-menu)
        ZSM_UI_MODE="text"
        run_interactive_menu
        ;;
    --run|run)
        run_monitor_cycle
        ;;
    --status|status)
        show_status
        ;;
    --test|test)
        run_test_alert
        ;;
    --unlock|unlock)
        unlock_account "${2:-}"
        ;;
    --whitelist-add)
        if [[ -z "${2:-}" ]]; then
            echo "Usage: zimbra-spam-monitor --whitelist-add <email@domain.com> [warn_limit crit_limit]"
            exit 1
        fi
        load_config
        shift
        upsert_whitelist_entry "$*"
        echo "[OK] Added '$*' to whitelist (${WHITELIST_FILE})."
        ;;
    --check-rbl|check-rbl)
        run_rbl_check "manual"
        ;;
    --audit|audit)
        run_security_audit
        ;;
    --version|-v)
        echo "zimbra-spam-monitor version ${VERSION}"
        ;;
    --help|-h|*)
        show_help
        ;;
esac
