# SUBMENU [5]: WHITELIST & PER-ACCOUNT CUSTOM LIMITS
# ------------------------------------------------------------------------------
remove_whitelist_exact() {
    local target_del="$1"
    [[ ! -f "$WHITELIST_FILE" || -z "$target_del" ]] && return 0
    local tmp_wl
    tmp_wl=$(make_safe_tmp "zsm_wl")
    awk -v tgt="${target_del,,}" '
        {
            raw = $0
            sub(/\r$/, "", raw)
            clean = raw
            sub(/#.*/, "", clean)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", clean)
            if (tolower(clean) == tgt) next
            print $0
        }
    ' "$WHITELIST_FILE" > "$tmp_wl"
    mv -f "$tmp_wl" "$WHITELIST_FILE"
    _WL_LOADED=0
}

# Upsert entry in whitelist.conf: removes any existing entry with the same email/@domain key before adding
upsert_whitelist_entry() {
    local entry_line="$1"
    [[ -z "$entry_line" ]] && return 0
    mkdir -p "$(dirname "$WHITELIST_FILE")" 2>/dev/null || true
    touch "$WHITELIST_FILE" 2>/dev/null || true

    local norm_line="${entry_line//:/ }"
    norm_line="${norm_line//\// }"
    local entry_key=""
    read -r entry_key _ <<< "$norm_line"
    entry_key="${entry_key,,}"
    [[ -z "$entry_key" ]] && return 0

    local tmp_wl
    tmp_wl=$(make_safe_tmp "zsm_wlu")
    awk -v k="$entry_key" '
        {
            raw = $0
            sub(/\r$/, "", raw)
            clean = raw
            sub(/#.*/, "", clean)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", clean)
            if (clean != "") {
                gsub(/[:\/]/, " ", clean)
                split(clean, parts, /[[:space:]]+/)
                if (tolower(parts[1]) == k) next
            }
            print $0
        }
    ' "$WHITELIST_FILE" > "$tmp_wl"
    printf '%s\n' "$entry_line" >> "$tmp_wl"
    mv -f "$tmp_wl" "$WHITELIST_FILE"
    _WL_LOADED=0
}

submenu_whitelist() {
    while true; do
        load_config
        mkdir -p "$(dirname "$WHITELIST_FILE")" 2>/dev/null || true
        touch "$WHITELIST_FILE" 2>/dev/null || true

        local count_wl
        count_wl=$(grep -v '^[[:space:]]*#' "$WHITELIST_FILE" 2>/dev/null | grep -c '[^[:space:]]' || true)

        local choice
        choice=$(ui_select_menu "WHITELIST & CUSTOM LIMITS (${count_wl} ENTRIES)" \
            "Full bypass (email / @domain) OR custom limit (email WARN CRIT):" \
            "1" "View Entries" \
            "2" "Add Full Bypass  (email or @domain.com)" \
            "3" "Remove Entry     (Exact match)" \
            "4" "Add Custom Limit (e.g. marketing@dom.com 500 1000)" \
            "0" "Back")

        case "$choice" in
            1)
                local list_txt
                list_txt=$(grep -v '^[[:space:]]*#' "$WHITELIST_FILE" 2>/dev/null | sed '/^[[:space:]]*$/d' || true)
                [[ -z "$list_txt" ]] && list_txt="(Whitelist is empty)"
                ui_msg_box "WHITELIST & CUSTOM LIMIT ENTRIES" "$list_txt"
                ;;
            2)
                local new_wl
                new_wl=$(ui_input_box "ADD TO WHITELIST" "Enter email (marketing@domain.com) or domain (@domain.com):" "")
                if [[ -n "$new_wl" ]]; then
                    upsert_whitelist_entry "$new_wl"
                    ui_msg_box "WHITELIST UPDATED" "Added '${new_wl}' to whitelist."
                fi
                ;;
            3)
                local wl_items=()
                local wl_map=()
                local idx=1
                while IFS= read -r line; do
                    local clean
                    clean=$(echo "$line" | tr -d '\r' | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//')
                    [[ -z "$clean" ]] && continue
                    wl_items+=("$idx" "$clean")
                    wl_map[$idx]="$clean"
                    idx=$(( idx + 1 ))
                done < "$WHITELIST_FILE"

                if (( idx == 1 )); then
                    ui_msg_box "WHITELIST EMPTY" "There are no entries to remove."
                else
                    wl_items+=("0" "Back")
                    local del_idx
                    del_idx=$(ui_select_menu "REMOVE WHITELIST ENTRY" \
                        "Select entry to remove (exact match):" \
                        "${wl_items[@]}")
                    if [[ -n "$del_idx" && "$del_idx" != "0" && -n "${wl_map[$del_idx]:-}" ]]; then
                        local target_del="${wl_map[$del_idx]}"
                        remove_whitelist_exact "$target_del"
                        ui_msg_box "REMOVED" "Removed '${target_del}' from whitelist."
                    fi
                fi
                ;;
            4)
                local cl_acc cl_warn cl_crit
                cl_acc=$(ui_input_box "CUSTOM LIMIT ACCOUNT" "Enter email (e.g. marketing@domain.com) or @domain.com:" "")
                if [[ -n "$cl_acc" ]]; then
                    cl_warn=$(ui_input_box "CUSTOM WARN LIMIT (${LOOKBACK_MINUTES}m)" "Warning recipient limit for ${cl_acc}:" "500")
                    cl_crit=$(ui_input_box "CUSTOM CRIT LIMIT (${LOOKBACK_MINUTES}m)" "Critical lock recipient limit for ${cl_acc}:" "1000")
                    if [[ "$cl_warn" =~ ^[0-9]+$ && "$cl_crit" =~ ^[0-9]+$ ]]; then
                        upsert_whitelist_entry "${cl_acc} ${cl_warn} ${cl_crit}"
                        ui_msg_box "CUSTOM LIMIT ADDED" "Saved '${cl_acc} ${cl_warn} ${cl_crit}' in ${WHITELIST_FILE}."
                    fi
                fi
                ;;
            0|"") break ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# SUBMENU [6]: LOGS, SERVICE ON/OFF, SELF-RBL & READ-ONLY AUDIT
