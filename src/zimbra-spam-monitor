# ------------------------------------------------------------------------------
# BẢNG ĐIỀU KHIỂN CHÍNH (MAIN CONTROL PANEL)
# ------------------------------------------------------------------------------
run_interactive_menu() {
    while true; do
        load_config
        resolve_zimbra_Settings

        local mon_badge="ĐANG BẬT"
        [[ "$MONITOR_ENABLED" != "true" ]] && mon_badge="ĐANG TẮT"

        local lock_badge="BẬT"
        [[ "$AUTO_LOCK_ON_CRITICAL" != "true" ]] && lock_badge="TẮT"

        local cron_badge
        cron_badge=$(get_current_cron_interval)

        local tg_badge="TG:BẬT"
        [[ "$TELEGRAM_ENABLED" != "true" || -z "$TELEGRAM_BOT_TOKEN" ]] && tg_badge="TG:Chưa cài/Tắt"
        local em_badge="Mail:${RESOLVED_EMAIL_TO}"
        [[ "$EMAIL_ENABLED" != "true" ]] && em_badge="Mail:TẮT"

        local choice
        choice=$(ui_select_menu "BẢNG ĐIỀU KHIỂN ZIMBRA SPAM MONITOR v${VERSION}" \
            "Trạng thái: [${mon_badge}] | Chu kỳ: [${cron_badge}] | Khóa tự động: [${lock_badge}]" \
            "1" "Xem Bảng Trạng Thái & Top Tài Khoản Gửi Mail hiện tại" \
            "2" "Cấu hình Cảnh báo & Test (${tg_badge} | ${em_badge})" \
            "3" "Chỉnh sửa Ngưỡng Cảnh Báo Spam (${LOOKBACK_MINUTES}p: ${WARN_SENT_PER_WINDOW}/${CRIT_SENT_PER_WINDOW} | 1h: ${WARN_SENT_PER_HOUR}/${CRIT_SENT_PER_HOUR})" \
            "4" "Cài đặt Tự Động Khóa & Mở Khóa Tài Khoản (Auto-Lock: ${lock_badge})" \
            "5" "Quản lý Danh Sách Miễn Trừ - Whitelist (Thêm / Chọn xóa)" \
            "6" "Thay đổi Chu Kỳ Quét Tự Động Cron (${cron_badge})" \
            "7" "Bật / Tắt toàn bộ hệ thống Giám Sát (Hiện tại: ${mon_badge})" \
            "8" "Xem Nhật Ký Hoạt Động gần nhất (/var/log/zimbra-spam-monitor.log)" \
            "0" "Thoát")

        case "$choice" in
            1)
                local st_out
                st_out=$(show_status 2>&1 || true)
                if [[ -n "$(detect_tui_bin)" ]]; then
                    ui_msg_box "TRẠNG THÁI HỆ THỐNG HIỆN TẠI" "$st_out"
                else
                    echo "$st_out"
                    read -r -p " Nhấn phím Enter để quay lại Menu..." _
                fi
                ;;
            2)
                submenu_notifications
                ;;
            3)
                submenu_thresholds
                ;;
            4)
                submenu_lock_control
                ;;
            5)
                submenu_whitelist
                ;;
            6)
                submenu_cron_schedule
                ;;
            7)
                if [[ "$MONITOR_ENABLED" == "true" ]]; then
                    update_cfg_var "MONITOR_ENABLED" "false"
                    ui_msg_box "ĐÃ TẮT GIÁM SÁT" "Hệ thống giám sát đã chuyển sang trạng thái TẠM DỪNG (MONITOR_ENABLED=false)."
                else
                    update_cfg_var "MONITOR_ENABLED" "true"
                    ui_msg_box "ĐÃ BẬT GIÁM SÁT" "Hệ thống giám sát đã được BẬT trở lại (MONITOR_ENABLED=true)."
                fi
                ;;
            8)
                local log_txt="(Chưa có dữ liệu log)"
                if [[ -f "$MONITOR_LOG_FILE" ]]; then
                    log_txt=$(tail -n 25 "$MONITOR_LOG_FILE" 2>/dev/null || echo "(Trống)")
                fi
                ui_msg_box "25 DÒNG LOG GẦN NHẤT (${MONITOR_LOG_FILE})" "$log_txt"
                ;;
            0|"")
                echo "Đã thoát bảng điều khiển Zimbra Spam Monitor."
                break
                ;;
        esac
    done
}

show_help() {
    cat <<EOF
Zimbra Outbound Spam Monitor v${VERSION}
Công cụ giám sát, cảnh báo (Telegram + Email) và tự động khóa tài khoản spam cho Zimbra.

Cách sử dụng:
  zimbra-spam-monitor                        Mở Giao diện Bảng điều khiển (Chọn bằng phím mũi tên / số)
  zimbra-spam-monitor --menu                 Mở Giao diện Bảng điều khiển (TUI Hộp thoại / Menu)
  zimbra-spam-monitor --text-menu            Mở Giao diện Menu chọn bằng số (Text mode)
  zimbra-spam-monitor --configure            Mở Giao diện Bảng điều khiển cấu hình
  zimbra-spam-monitor --run                  Chạy chu kỳ quét ngầm (Được gọi tự động bởi Cron)
  zimbra-spam-monitor --status               Xem thống kê Top tài khoản gửi mail & hàng đợi hiện tại
  zimbra-spam-monitor --edit-config          Mở trực tiếp file /etc/zimbra-spam-monitor/config.conf bằng nano/vi
  zimbra-spam-monitor --test                 Gửi tin nhắn thử nghiệm qua Telegram và Email
  zimbra-spam-monitor --unlock <email>       Mở khóa nhanh tài khoản Zimbra bị khóa tự động
  zimbra-spam-monitor --whitelist-add <mail> Thêm tài khoản vào danh sách miễn trừ (Whitelist)
  zimbra-spam-monitor --help                 Hiển thị hướng dẫn này
EOF
}

# ==============================================================================
# ĐIỂM VÀO CHƯƠNG TRÌNH (ENTRYPOINT)
# ==============================================================================
# Nếu quản trị viên gõ trực tiếp 'zimbra-spam-monitor' trên terminal -> Mở ngay Giao diện Chọn!
# Nếu được gọi không có tham số từ tiến trình nền (không có tty) -> Chạy --run.
if [[ $# -eq 0 ]]; then
    if [[ -t 0 && -t 1 ]]; then
        ACTION="--menu"
    else
        ACTION="--run"
    fi
else
    ACTION="$1"
fi

case "$ACTION" in
    --menu|-m|--configure|configure|config|menu)
        run_interactive_menu
        ;;
    --text-menu)
        ZSM_UI_MODE="text"
        run_interactive_menu
        ;;
    --run|run)
        run_monitor_cycle
        ;;
    --status|status)
        show_status
        ;;
    --edit-config|edit)
        ensure_config_file_exists
        EDITOR_CMD="${EDITOR:-nano}"
        if ! command -v "$EDITOR_CMD" >/dev/null 2>&1; then
            EDITOR_CMD="vi"
        fi
        "$EDITOR_CMD" "$CONFIG_FILE"
        ;;
    --test|test)
        run_test_alert
        ;;
    --unlock|unlock)
        unlock_account "${2:-}"
        ;;
    --whitelist-add)
        if [[ -z "${2:-}" ]]; then
            echo "Sử dụng: zimbra-spam-monitor --whitelist-add <email@domain.com>"
            exit 1
        fi
        load_config
        echo "${2}" >> "$WHITELIST_FILE"
        echo "[OK] Đã thêm ${2} vào danh sách miễn trừ (${WHITELIST_FILE})."
        ;;
    --version|-v)
        echo "zimbra-spam-monitor version ${VERSION}"
        ;;
    --help|-h|*)
        show_help
        ;;
esac
