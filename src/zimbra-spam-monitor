was_recently_unlocked() {
    local sender="${1,,}"
    local cutoff_file="$STATE_DIR/unlock_cutoff.db"
    [[ ! -f "$cutoff_file" ]] && return 1
    local uts now_ts
    uts=$(awk -F'|' -v s="$sender" 'tolower($1) == s {t=$2} END {if (t != "") print t}' "$cutoff_file" 2>/dev/null || true)
    [[ -z "$uts" || ! "$uts" =~ ^[0-9]+$ ]] && return 1
    now_ts="${ZSM_NOW_EPOCH:-$(date +%s)}"
