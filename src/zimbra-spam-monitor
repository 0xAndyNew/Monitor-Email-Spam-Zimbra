    echo "=============================================================================="

    rm -f "$tmp_log_stats" "$tmp_q_stats" "$tmp_q_sum"
}

run_test_alert() {
    load_config
    resolve_zimbra_Settings
    local srv_host srv_ip now_str
    srv_host=$(get_server_hostname)
    srv_ip=$(get_server_ip)
    now_str=$(date '+%Y-%m-%d %H:%M:%S')

    echo "Đang kiểm tra gửi cảnh báo thử nghiệm từ ${srv_host} (${srv_ip})..."
    echo " - File cấu hình đang dùng : ${CONFIG_FILE}"
    echo " - Telegram Enabled        : ${TELEGRAM_ENABLED} (Chat ID: ${TELEGRAM_CHAT_ID:-Chưa điền})"
    echo " - Email Enabled           : ${EMAIL_ENABLED} (Gửi tới: ${RESOLVED_EMAIL_TO})"

    local test_tg_msg
    test_tg_msg=$(cat <<EOF
✅ <b>[ZIMBRA SPAM MONITOR - TEST KẾT NỐI]</b>
━━━━━━━━━━━━━━━━━━━━━━
🖥 <b>Server:</b> <code>$(html_escape "$srv_host")</code> (${srv_ip})
🕒 <b>Thời gian:</b> ${now_str}
