━━━━━━━━━━━━━━━━━━━━━━
<i>Hệ thống giám sát Email Spam Zimbra đang hoạt động tốt!</i>
EOF
)

    local tg_rc=0
    if [[ "$TELEGRAM_ENABLED" == "true" ]]; then
        if send_telegram_alert "$test_tg_msg"; then
            echo " [OK] Đã gửi tin nhắn thử nghiệm qua Telegram thành công!"
        else
            echo " [LỖI] Gửi Telegram thất bại. Vui lòng kiểm tra TELEGRAM_BOT_TOKEN và TELEGRAM_CHAT_ID."
            tg_rc=1
        fi
    fi

    local mail_rc=0
    if [[ "$EMAIL_ENABLED" == "true" ]]; then
        local test_mail_body="Đây là email kiểm tra kết nối từ hệ thống Zimbra Spam Monitor trên máy chủ ${srv_host} (${srv_ip}) lúc ${now_str}. Hệ thống hoạt động bình thường."
