                val=$(ui_input_box "NGƯỠNG TỔNG QUEUE TOÀN SERVER" "Tổng số lượng mail trong Queue toàn hệ thống để cảnh báo nghẽn:" "$WARN_TOTAL_QUEUE")
                [[ "$val" =~ ^[0-9]+$ ]] && update_cfg_num "WARN_TOTAL_QUEUE" "$val"
                ;;
            10)
                val=$(ui_input_box "THỜI GIAN COOLDOWN (PHÚT)" "Số phút chờ giữa 2 lần gửi cảnh báo cùng mức cho cùng 1 tài khoản:" "$ALERT_COOLDOWN_MINUTES")
                [[ "$val" =~ ^[0-9]+$ ]] && update_cfg_num "ALERT_COOLDOWN_MINUTES" "$val"
                ;;
            11)
                if [[ "$COUNT_INTERNAL_TO_INTERNAL" == "true" ]]; then
                    update_cfg_var "COUNT_INTERNAL_TO_INTERNAL" "false"
                else
                    update_cfg_var "COUNT_INTERNAL_TO_INTERNAL" "true"
                fi
                ;;
            0|"")
                break
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# MENU CON 4: TỰ ĐỘNG KHÓA & MỞ KHÓA TÀI KHOẢN (CHỌN TỪ DANH SÁCH)
# ------------------------------------------------------------------------------
submenu_lock_control() {
    while true; do
        load_config
        local lock_label="ĐANG BẬT (Tự động khóa khi chạm mức CRITICAL)"
        [[ "$AUTO_LOCK_ON_CRITICAL" != "true" ]] && lock_label="ĐANG TẮT (Chỉ gửi cảnh báo, không khóa)"

        local hold_label="ĐANG TẮT"
        [[ "$AUTO_HOLD_QUEUE_ON_CRITICAL" == "true" ]] && hold_label="ĐANG BẬT (Tự động Hold mail trong Queue)"

        local choice
        choice=$(ui_select_menu "TỰ ĐỘNG KHÓA & MỞ KHÓA TÀI KHOẢN" \
            "Quản lý cơ chế tự động khóa và mở khóa tài khoản Zimbra:" \
            "1" "Tự động khóa khi CRITICAL : ${lock_label}" \
            "2" "Tạm giữ Queue khi CRITICAL: ${hold_label}" \
            "3" "Chọn mở khóa tài khoản vừa bị khóa tự động (Từ danh sách)" \
            "4" "Nhập địa chỉ Email bất kỳ để mở khóa (active)" \
            "0" "Quay lại Menu chính")

        case "$choice" in
            1)
                if [[ "$AUTO_LOCK_ON_CRITICAL" == "true" ]]; then
                    update_cfg_var "AUTO_LOCK_ON_CRITICAL" "false"
                else
                    update_cfg_var "AUTO_LOCK_ON_CRITICAL" "true"
                fi
                ;;
            2)
                if [[ "$AUTO_HOLD_QUEUE_ON_CRITICAL" == "true" ]]; then
                    update_cfg_var "AUTO_HOLD_QUEUE_ON_CRITICAL" "false"
                else
                    update_cfg_var "AUTO_HOLD_QUEUE_ON_CRITICAL" "true"
                fi
                ;;
            3)
                local locked_file="$STATE_DIR/locked_accounts.db"
                if [[ ! -s "$locked_file" ]]; then
                    ui_msg_box "DANH SÁCH TRỐNG" "Hiện tại chưa có tài khoản nào trong danh sách bị khóa tự động bởi hệ thống."
                else
                    local menu_args=()
                    local idx=1
                    local acc_map=()
                    while IFS='|' read -r acc ltime; do
                        [[ -z "$acc" ]] && continue
                        menu_args+=("$idx" "${acc} (Khóa lúc: ${ltime})")
                        acc_map[$idx]="$acc"
                        idx=$(( idx + 1 ))
                    done < "$locked_file"
                    menu_args+=("0" "Quay lại")

                    local sel_idx
                    sel_idx=$(ui_select_menu "CHỌN TÀI KHOẢN CẦN MỞ KHÓA" \
                        "Chọn tài khoản anh muốn mở khóa (chuyển về active):" \
                        "${menu_args[@]}")
                    if [[ -n "$sel_idx" && "$sel_idx" != "0" && -n "${acc_map[$sel_idx]:-}" ]]; then
                        local target_acc="${acc_map[$sel_idx]}"
                        local u_out
                        u_out=$(unlock_account "$target_acc" 2>&1 || true)
                        ui_msg_box "KẾT QUẢ MỞ KHÓA" "$u_out"
                    fi
                fi
                ;;
            4)
                local manual_acc
                manual_acc=$(ui_input_box "MỞ KHÓA TÀI KHOẢN" "Nhập địa chỉ email cần mở khóa (Ví dụ: user@domain.com):" "")
                if [[ -n "$manual_acc" ]]; then
                    local u_out
                    u_out=$(unlock_account "$manual_acc" 2>&1 || true)
                    ui_msg_box "KẾT QUẢ MỞ KHÓA" "$u_out"
                fi
                ;;
            0|"")
                break
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# MENU CON 5: QUẢN LÝ DANH SÁCH MIỄN TRỪ (WHITELIST) BẰNG CÁCH CHỌN
# ------------------------------------------------------------------------------
submenu_whitelist() {
    while true; do
        load_config
        mkdir -p "$(dirname "$WHITELIST_FILE")" 2>/dev/null || true
        touch "$WHITELIST_FILE" 2>/dev/null || true

        local count_wl
        count_wl=$(grep -v '^[[:space:]]*#' "$WHITELIST_FILE" 2>/dev/null | grep -c '[^[:space:]]' || true)

        local choice
        choice=$(ui_select_menu "QUẢN LÝ DANH SÁCH MIỄN TRỪ (WHITELIST)" \
            "Hiện đang có ${count_wl} mục trong Whitelist (${WHITELIST_FILE}):" \
            "1" "Xem danh sách các Email / Domain đang được miễn trừ" \
            "2" "Thêm Email hoặc @domain.com mới vào Whitelist" \
            "3" "Chọn xóa Email / Domain khỏi Whitelist (Chọn từ danh sách)" \
            "0" "Quay lại Menu chính")

        case "$choice" in
            1)
                local list_txt
                list_txt=$(grep -v '^[[:space:]]*#' "$WHITELIST_FILE" 2>/dev/null | sed '/^[[:space:]]*$/d' || true)
                if [[ -z "$list_txt" ]]; then
                    list_txt="(Danh sách Whitelist hiện đang trống)"
                fi
                ui_msg_box "DANH SÁCH WHITELIST HIỆN TẠI" "$list_txt"
                ;;
            2)
                local new_wl
                new_wl=$(ui_input_box "THÊM VÀO WHITELIST" "Nhập địa chỉ email (vd: marketing@domain.com) hoặc cả tên miền (@domain.com):" "")
                if [[ -n "$new_wl" ]]; then
                    echo "$new_wl" >> "$WHITELIST_FILE"
                    ui_msg_box "ĐÃ THÊM WHITELIST" "Đã thêm '${new_wl}' vào danh sách miễn trừ thành công!"
                fi
                ;;
            3)
                local wl_items=()
                local wl_map=()
                local idx=1
                while IFS= read -r line; do
                    local clean
                    clean=$(echo "$line" | tr -d '\r' | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//')
                    [[ -z "$clean" ]] && continue
                    wl_items+=("$idx" "$clean")
                    wl_map[$idx]="$clean"
                    idx=$(( idx + 1 ))
                done < "$WHITELIST_FILE"

                if (( idx == 1 )); then
                    ui_msg_box "WHITELIST TRỐNG" "Không có mục nào trong Whitelist để xóa."
                else
                    wl_items+=("0" "Quay lại")
                    local del_idx
                    del_idx=$(ui_select_menu "CHỌN MỤC CẦN XÓA KHỎI WHITELIST" \
                        "Chọn địa chỉ anh muốn gỡ khỏi danh sách miễn trừ:" \
                        "${wl_items[@]}")
                    if [[ -n "$del_idx" && "$del_idx" != "0" && -n "${wl_map[$del_idx]:-}" ]]; then
                        local target_del="${wl_map[$del_idx]}"
                        grep -v -F "$target_del" "$WHITELIST_FILE" > "${WHITELIST_FILE}.tmp" 2>/dev/null || true
                        mv -f "${WHITELIST_FILE}.tmp" "$WHITELIST_FILE"
                        ui_msg_box "ĐÃ XÓA" "Đã xóa '${target_del}' khỏi Whitelist."
                    fi
                fi
                ;;
            0|"")
                break
                ;;
        esac
    done
}

