    [[ ! -f "$hist_file" ]] && return 0
    awk -F'|' -v s="$sender" 'tolower($2) != s' "$hist_file" > "${hist_file}.tmp" 2>/dev/null || true
    mv -f "${hist_file}.tmp" "$hist_file"
}

clear_alert_state() {
    local sender="${1,,}"
    local state_file="$STATE_DIR/cooldown.db"
    if [[ -f "$state_file" ]]; then
        awk -F'|' -v s="$sender" 'tolower($1) != s && tolower($1) != ("^" s)' "$state_file" > "${state_file}.tmp" 2>/dev/null || true
        mv -f "${state_file}.tmp" "$state_file"
    fi
    remove_locked_account_record "$sender"
    clear_rolling_history_for_user "$sender"
    record_unlock_cutoff "$sender"
}

# Merge per-5m-submission-bucket stats into rolling_history.db using max(old, new)
# Guarantees idempotency regardless of cron frequency (1m/2m/5m) and prunes > 24h.
update_and_summarize_rolling_history() {
    local bkt_file="$1"
    local out_summary="$2"
    local read_only="${3:-false}"
    local hist_file="$STATE_DIR/rolling_history.db"
    local unlock_file="$STATE_DIR/unlock_cutoff.db"
    local now_ts="${ZSM_NOW_EPOCH:-$(date +%s)}"
    local awk_bin
    awk_bin=$(find_awk_bin)

    : > "$out_summary"
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    [[ ! -f "$hist_file" ]] && : > "$hist_file"

    local tmp_new_hist
    tmp_new_hist=$(make_safe_tmp "zsm_rhist")

    "$awk_bin" -F'|' \
        -v now_ts="$now_ts" \
        -v unlock_file="$unlock_file" \
        -v hist_out="$tmp_new_hist" '
    BEGIN {
        cut_24h = now_ts - 86400
        cut_1h  = now_ts - 3600
        if (unlock_file != "") {
            while ((getline uline < unlock_file) > 0) {
                split(uline, up, "|")
                if (up[1] != "" && up[2] != "") ut[tolower(up[1])] = up[2] + 0
            }
            close(unlock_file)
        }
    }
    NF >= 4 {
        b = $1 + 0
        s = tolower($2)
        m = $3 + 0
        r = $4 + 0
        if (s == "" || b < cut_24h || b > now_ts + 300) next
        if ((s in ut) && (b + 300) <= ut[s]) next
        if (FILENAME == ARGV[1] && (s in ut) && b <= ut[s]) next
        key = b "|" s
        if (!(key in bm) || m > bm[key]) bm[key] = m
        if (!(key in br) || r > br[key]) br[key] = r
        b_seen[key] = 1
    }
    END {
        for (key in b_seen) {
            split(key, kp, "|")
            b = kp[1] + 0
            s = kp[2]
            m = bm[key] + 0
            r = br[key] + 0
            printf "%d|%s|%d|%d\n", b, s, m, r > hist_out
            all_u[s] = 1
            d24_m[s] += m
            d24_r[s] += r
            if (b >= cut_1h - 299) {
                h1_m[s] += m
                h1_r[s] += r
            }
        }
        close(hist_out)
        for (s in all_u) {
            printf "%s|%d|%d|%d|%d\n", s, h1_m[s]+0, h1_r[s]+0, d24_m[s]+0, d24_r[s]+0
        }
    }
    ' "$hist_file" "$bkt_file" > "$out_summary" 2>/dev/null || true

    if [[ "$read_only" != "true" && -f "$tmp_new_hist" ]]; then
        mv -f "$tmp_new_hist" "$hist_file" 2>/dev/null || rm -f "$tmp_new_hist"
    else
        rm -f "$tmp_new_hist"
    fi
}

# ==============================================================================
# AUTO-REMEDIATION ON CRITICAL (SINGLE-ACCOUNT LOCK, CACHE FLUSH & QUEUE HOLD)
# Strictly injection-safe (validated email passed via stdin, bounded by timeout)
# ==============================================================================
format_already_locked_msg() {
    local account="$1"
    local lock_ts
    lock_ts=$(get_locked_account_time "$account")
    if [[ -n "$lock_ts" ]]; then
        echo "ALREADY LOCKED (Since ${lock_ts} | Skipped duplicate zmprov)"
    else
        echo "ALREADY LOCKED (Skipped duplicate zmprov call)"
    fi
}

is_protected_system_account() {
    local acct="${1,,}"
    local local_part="${acct%@*}"
    case "$local_part" in
        spam.*|ham.*|virus-quarantine.*|galsync.*)
            return 0
            ;;
    esac
    if [[ -n "${PROTECTED_ACCOUNTS:-}" ]]; then
        local p
        for p in ${PROTECTED_ACCOUNTS//,/ }; do
            p="${p,,}"
            [[ -z "$p" ]] && continue
            if [[ "$p" == "$acct" ]] || [[ "$p" == @* && "$acct" == *"$p" ]]; then
                return 0
            fi
        done
    fi
    return 1
}

# Return codes for lock_flush: 0 = locked+flushed, 10 = locked (flush failed), 127 = zmprov missing, other = failed
zmprov_account_action() {
    local action="$1"   # "lock", "lock_flush", "unlock", or "flush"
    local account="$2"

    if ! is_valid_email_account "$account"; then
        log_msg "WARN" "Refused zmprov ${action} for invalid account identifier: ${account}"
        return 2
    fi

    if [[ -n "$ZSM_ZMPROV_CMD" ]]; then
        case "$action" in
            lock)
                run_with_timeout "$ZMPROV_TIMEOUT_SECONDS" "$ZSM_ZMPROV_CMD" ma "$account" zimbraAccountStatus locked >/dev/null 2>&1
                return $?
                ;;
            lock_flush)
                run_with_timeout "$ZMPROV_TIMEOUT_SECONDS" "$ZSM_ZMPROV_CMD" ma "$account" zimbraAccountStatus locked >/dev/null 2>&1 || return $?
                if run_with_timeout "$ZMPROV_TIMEOUT_SECONDS" "$ZSM_ZMPROV_CMD" fc account "$account" >/dev/null 2>&1; then
                    return 0
                fi
                return 10
                ;;
            unlock)
                run_with_timeout "$ZMPROV_TIMEOUT_SECONDS" "$ZSM_ZMPROV_CMD" ma "$account" zimbraAccountStatus active >/dev/null 2>&1
                return $?
                ;;
            flush)
                run_with_timeout "$ZMPROV_TIMEOUT_SECONDS" "$ZSM_ZMPROV_CMD" fc account "$account" >/dev/null 2>&1
                return $?
                ;;
        esac
        return 1
    fi

    if [[ ! -x /opt/zimbra/bin/zmprov ]]; then
        return 127
    fi

    # Pass validated account via stdin to eliminate all shell quote/command injection vectors.
    # For lock_flush, batch lock + verify + flush into 1 single JVM invocation (50% less CPU/RAM).
    case "$action" in
        lock)
            printf '%s\n' "$account" | run_with_timeout "$ZMPROV_TIMEOUT_SECONDS" \
                su - zimbra -c 'IFS= read -r a && exec /opt/zimbra/bin/zmprov ma "$a" zimbraAccountStatus locked' >/dev/null 2>&1
            ;;
        lock_flush)
            local zm_out="" zm_rc=0
            zm_out=$(printf 'ma %s zimbraAccountStatus locked\nga %s zimbraAccountStatus\nfc account %s\n' "$account" "$account" "$account" | \
                run_with_timeout "$ZMPROV_TIMEOUT_SECONDS" su - zimbra -c 'exec /opt/zimbra/bin/zmprov' 2>&1) || zm_rc=$?
            if printf '%s\n' "$zm_out" | grep -q 'zimbraAccountStatus: locked'; then
                if printf '%s\n' "$zm_out" | grep -q 'ERROR:'; then
                    return 10
                fi
                return 0
            fi
            (( zm_rc == 0 )) && zm_rc=1
            return "$zm_rc"
            ;;
        unlock)
            printf '%s\n' "$account" | run_with_timeout "$ZMPROV_TIMEOUT_SECONDS" \
                su - zimbra -c 'IFS= read -r a && exec /opt/zimbra/bin/zmprov ma "$a" zimbraAccountStatus active' >/dev/null 2>&1
            ;;
        flush)
            printf '%s\n' "$account" | run_with_timeout "$ZMPROV_TIMEOUT_SECONDS" \
                su - zimbra -c 'IFS= read -r a && exec /opt/zimbra/bin/zmprov fc account "$a"' >/dev/null 2>&1
            ;;
    esac
}

# Return codes: 0 = locked/already locked/disabled/protected cleanly; 1 = lock attempted and FAILED (will retry next cycle)
lock_zimbra_account() {
    local account="$1"
    local force_relock="${2:-false}"

    if ! is_valid_email_account "$account"; then
        echo "NOT LOCKED (Invalid or non-mailbox identity - manual check required)"
        return 0
    fi

    if is_protected_system_account "$account"; then
        log_msg "WARN" "Skipped auto-lock for protected/system account: ${account} (alert only)"
        echo "NOT LOCKED (Protected system account - alert only)"
        return 0
    fi

    if [[ "$AUTO_LOCK_ON_CRITICAL" != "true" ]]; then
        if is_account_already_locked "$account"; then
            format_already_locked_msg "$account"
        else
            echo "NOT LOCKED (Active - Auto-lock disabled)"
        fi
        return 0
    fi

    if [[ "$force_relock" != "true" ]] && is_account_already_locked "$account"; then
        format_already_locked_msg "$account"
        return 0
    fi

    if [[ "$force_relock" == "true" ]]; then
        log_msg "CRITICAL" "Re-locking account still sending after prior lock: $account"
    else
        log_msg "CRITICAL" "Auto-locking compromised spam account: $account"
    fi

    local rc=0 flush_note=""
    if [[ "$FLUSH_CACHE_ON_LOCK" == "true" ]]; then
        zmprov_account_action "lock_flush" "$account" || rc=$?
        if (( rc == 0 )); then
            flush_note=" + cache flushed"
        elif (( rc == 10 )); then
            rc=0
        fi
    else
        zmprov_account_action "lock" "$account" || rc=$?
    fi

    if (( rc == 0 )); then
        record_locked_account "$account"
        if [[ "$force_relock" == "true" ]]; then
            echo "RE-LOCKED (Still sending after prior lock - re-locked via zmprov${flush_note})"
        else
            echo "LOCKED (Auto-locked now via zmprov${flush_note})"
        fi
        return 0
    elif (( rc == 127 )); then
        echo "LOCK FAILED (/opt/zimbra/bin/zmprov not found)"
        return 1
    else
        echo "LOCK FAILED (zmprov error rc=${rc} - will retry next cycle)"
        return 1
    fi
}

# Holds queued messages matching EITHER envelope sender OR correlated SASL Queue-IDs (catches spoofed From)
hold_sender_queue() {
    local sender="$1"
    local qid_map_file="${2:-}"
    local force_manual="${3:-false}"

    if [[ "$force_manual" != "true" && "$AUTO_HOLD_QUEUE_ON_CRITICAL" != "true" ]]; then
        return 0
    fi
    if ! is_valid_email_account "$sender"; then
        return 0
    fi

    local pq_bin ps_bin
    pq_bin=$(find_postqueue_bin)
    ps_bin=$(find_postsuper_bin)
    [[ -z "$pq_bin" || -z "$ps_bin" ]] && return 0

    local qids_to_hold
    qids_to_hold=$(run_with_timeout "$POSTQUEUE_TIMEOUT_SECONDS" "$pq_bin" -p 2>/dev/null | awk -v target="${sender,,}" -v qmap="$qid_map_file" '
        BEGIN {
            if (qmap != "") {
                while ((getline line < qmap) > 0) {
                    split(line, p, "|")
                    if (tolower(p[2]) == target && p[1] != "") match_qid[p[1]] = 1
                }
                close(qmap)
            }
        }
        /^[0-9A-Za-z]+[*!]?[[:space:]]+[0-9]+[[:space:]]/ {
            qid_raw = $1
            if (index(qid_raw, "!") > 0) next
            qid = qid_raw
            sub(/[*!]$/, "", qid)
            s = tolower($7)
            if (s == target || (qid in match_qid)) {
                print qid
            }
        }
    ' || true)

    if [[ -n "$qids_to_hold" ]]; then
        local cnt
        cnt=$(printf '%s\n' "$qids_to_hold" | wc -l | tr -d ' ')
        printf '%s\n' "$qids_to_hold" | "$ps_bin" -h - >/dev/null 2>&1 || true
        log_msg "CRITICAL" "Placed ${cnt} queued message(s) from ${sender} on HOLD"
        echo "$cnt"
    else
        echo "0"
    fi
}

release_sender_held_queue() {
    local sender="$1"
    if ! is_valid_email_account "$sender"; then
        echo "0"
        return 1
    fi
    local pq_bin ps_bin
    pq_bin=$(find_postqueue_bin)
    ps_bin=$(find_postsuper_bin)
    [[ -z "$pq_bin" || -z "$ps_bin" ]] && echo "0" && return 1

    local qids_held
    qids_held=$(run_with_timeout "$POSTQUEUE_TIMEOUT_SECONDS" "$pq_bin" -p 2>/dev/null | awk -v target="${sender,,}" '
        /^[0-9A-Za-z]+![[:space:]]+[0-9]+[[:space:]]/ {
            qid = $1; sub(/!$/, "", qid)
            if (tolower($7) == target) print qid
        }
    ' || true)

    if [[ -n "$qids_held" ]]; then
        local cnt
        cnt=$(printf '%s\n' "$qids_held" | wc -l | tr -d ' ')
        printf '%s\n' "$qids_held" | "$ps_bin" -H - >/dev/null 2>&1 || true
        log_msg "INFO" "Admin released ${cnt} held message(s) for ${sender}"
        echo "$cnt"
    else
        echo "0"
    fi
}

# ==============================================================================
# TELEGRAM, EMAIL, WEBHOOK NOTIFICATIONS & OUTBOX RETRY QUEUE
# Credentials passed exclusively via curl stdin (--config -) - hidden from ps aux
# ==============================================================================
html_escape() {
    local s="$1"
    s="${s//&/&amp;}"
    s="${s//</&lt;}"
    s="${s//>/&gt;}"
    printf '%s' "$s"
}

send_telegram_alert() {
    local message_html="$1"
    if [[ "$TELEGRAM_ENABLED" != "true" ]]; then
        return 0
    fi
    if [[ -z "$TELEGRAM_BOT_TOKEN" || -z "$TELEGRAM_CHAT_ID" ]]; then
        log_msg "WARN" "Telegram is enabled, but TELEGRAM_BOT_TOKEN or TELEGRAM_CHAT_ID is empty"
        return 1
    fi

    # Respect Telegram ~20 msg/min group limit across bursts
    if (( _TG_SENT_IN_CYCLE > 0 )) && [[ "$ZSM_TG_RATE_SLEEP" =~ ^[0-9]+$ ]] && (( ZSM_TG_RATE_SLEEP > 0 )); then
        sleep "$ZSM_TG_RATE_SLEEP"
    fi

    # Enforce Telegram 4096-char cap safely (preserve valid HTML by trimming plain lines if oversized)
    if (( ${#message_html} > 3950 )); then
        message_html="${message_html:0:3900}"
        message_html="${message_html%$'\n'*}"
        message_html="${message_html}"$'\n'"<i>... (truncated to fit Telegram 4096-char limit)</i>"
    fi

    local tmp_msg
    tmp_msg=$(make_safe_tmp "zsm_tgmsg")
    printf '%s' "$message_html" > "$tmp_msg"

    local url_esc
    url_esc=$(curl_cfg_escape "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage")

    local resp=""
    local attempt=1
    while (( attempt <= 2 )); do
        resp=$(printf 'url = "%s"\n' "$url_esc" | "$ZSM_CURL_CMD" -sS -m 15 --config - -X POST \
            -d "chat_id=${TELEGRAM_CHAT_ID}" \
            -d "parse_mode=HTML" \
            -d "disable_web_page_preview=true" \
            --data-urlencode "text@${tmp_msg}" 2>&1 || true)

        if echo "$resp" | grep -q '"ok":true'; then
            rm -f "$tmp_msg"
            _TG_SENT_IN_CYCLE=$(( _TG_SENT_IN_CYCLE + 1 ))
            log_msg "INFO" "Telegram alert sent successfully to Chat ID ${TELEGRAM_CHAT_ID}"
            return 0
        fi

        # Handle Telegram HTTP 429 retry_after politely once
        if (( attempt == 1 )) && echo "$resp" | grep -q '"retry_after"'; then
            local wait_sec
            wait_sec=$(echo "$resp" | sed -n 's/.*"retry_after":[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n 1)
            if [[ "$wait_sec" =~ ^[0-9]+$ ]] && (( wait_sec > 0 )); then
                (( wait_sec > 15 )) && wait_sec=15
                (( ZSM_TG_RATE_SLEEP == 0 )) && wait_sec=0
                (( wait_sec > 0 )) && sleep "$wait_sec"
                attempt=$(( attempt + 1 ))
                continue
            fi
        fi
        break
    done

    rm -f "$tmp_msg"
    log_msg "ERROR" "Failed to send Telegram alert: ${resp:0:200}"
    return 1
}

send_email_via_local_sendmail() {
    local subject="$1"
    local body_text="$2"
    local sm_bin
    sm_bin=$(find_sendmail_bin)
    if [[ -z "$sm_bin" ]]; then
        log_msg "ERROR" "sendmail binary not found on system"
        return 1
    fi

    local email_payload
    email_payload=$(cat <<EOF
From: Zimbra Spam Monitor <${RESOLVED_EMAIL_FROM}>
To: ${RESOLVED_EMAIL_TO}
Subject: ${subject}
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

${body_text}
EOF
)
    if printf "%s\n" "$email_payload" | "$sm_bin" -f "$RESOLVED_EMAIL_FROM" -t -i >/dev/null 2>&1; then
        log_msg "INFO" "Email alert sent (Local Postfix) to ${RESOLVED_EMAIL_TO}"
        return 0
    else
        log_msg "ERROR" "Failed to send Email via Local Postfix"
        return 1
    fi
}

send_email_via_external_smtp() {
    local subject="$1"
    local body_text="$2"

    if [[ -z "$SMTP_HOST" || -z "$SMTP_USER" || -z "$SMTP_PASS" ]]; then
        log_msg "WARN" "Incomplete external SMTP settings (SMTP_HOST / SMTP_USER / SMTP_PASS)"
        return 1
    fi

    local proto="smtp"
    [[ "$SMTP_PORT" == "465" ]] && proto="smtps"
    local smtp_url="${proto}://${SMTP_HOST}:${SMTP_PORT}"

    local tls_flag=""
    [[ "$SMTP_TLS" == "true" ]] && tls_flag="--ssl-reqd"

    local tmp_mail
    tmp_mail=$(make_safe_tmp "zsm_mail")
    cat <<EOF > "$tmp_mail"
From: Zimbra Spam Monitor <${SMTP_USER}>
To: ${RESOLVED_EMAIL_TO}
Subject: ${subject}
Date: $(date -R 2>/dev/null || date)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

${body_text}
EOF

    local rcpt_args=()
    IFS=',' read -ra ADDR_LIST <<< "$RESOLVED_EMAIL_TO"
    for addr in "${ADDR_LIST[@]}"; do
        addr="${addr#"${addr%%[![:space:]]*}"}"
        addr="${addr%"${addr##*[![:space:]]}"}"
        [[ -n "$addr" ]] && rcpt_args+=(--mail-rcpt "$addr")
    done

    local url_esc cred_esc
    url_esc=$(curl_cfg_escape "$smtp_url")
    cred_esc=$(curl_cfg_escape "${SMTP_USER}:${SMTP_PASS}")

    # Pass SMTP URL and credentials via stdin (--config -) so password never appears in ps aux
    # shellcheck disable=SC2086
    if printf 'url = "%s"\nuser = "%s"\n' "$url_esc" "$cred_esc" | \
        "$ZSM_CURL_CMD" -sS -m 20 --config - $tls_flag \
        --mail-from "$SMTP_USER" \
        "${rcpt_args[@]}" \
        -T "$tmp_mail" >/dev/null 2>&1; then
        rm -f "$tmp_mail"
        log_msg "INFO" "Email alert sent (External SMTP ${SMTP_HOST}) to ${RESOLVED_EMAIL_TO}"
        return 0
    else
        rm -f "$tmp_mail"
        log_msg "ERROR" "Failed to send Email via External SMTP (${SMTP_HOST}:${SMTP_PORT})"
        return 1
    fi
}

send_email_alert() {
    local subject="$1"
    local body_text="$2"
    local total_queue="${3:-0}"

    if [[ "$EMAIL_ENABLED" != "true" ]]; then
        return 0
    fi

    resolve_zimbra_settings

    if [[ "$EMAIL_DELIVERY_MODE" == "smtp" ]]; then
        send_email_via_external_smtp "$subject" "$body_text"
        return $?
    elif [[ "$EMAIL_DELIVERY_MODE" == "local" ]]; then
        send_email_via_local_sendmail "$subject" "$body_text"
        return $?
    else
        if (( total_queue >= WARN_TOTAL_QUEUE )) && [[ -n "$SMTP_HOST" && -n "$SMTP_USER" ]]; then
            if send_email_via_external_smtp "$subject" "$body_text"; then
                return 0
            fi
        fi
        if send_email_via_local_sendmail "$subject" "$body_text"; then
            return 0
        fi
        if [[ -n "$SMTP_HOST" && -n "$SMTP_USER" ]]; then
            send_email_via_external_smtp "$subject" "$body_text"
            return $?
        fi
        return 1
    fi
}

send_webhook_alert() {
    local payload_json="$1"
    if [[ "$WEBHOOK_ENABLED" != "true" ]]; then
        return 0
    fi
    if [[ -z "$WEBHOOK_URL" ]]; then
        log_msg "WARN" "Webhook is enabled, but WEBHOOK_URL is empty"
        return 1
    fi

    local tmp_wh
    tmp_wh=$(make_safe_tmp "zsm_wh")
    printf '%s' "$payload_json" > "$tmp_wh"

    local url_esc
    url_esc=$(curl_cfg_escape "$WEBHOOK_URL")

    local resp
    resp=$(printf 'url = "%s"\n' "$url_esc" | "$ZSM_CURL_CMD" -sS -m 15 --config - -X POST \
        -H "Content-Type: application/json" \
        --data-binary "@${tmp_wh}" 2>&1)
    local rc=$?
    rm -f "$tmp_wh"

    if (( rc == 0 )); then
        log_msg "INFO" "Webhook alert sent (${WEBHOOK_FORMAT})"
        return 0
    else
        log_msg "ERROR" "Failed to send Webhook alert: ${resp:0:200}"
        return 1
    fi
}

build_webhook_payload() {
    local plain_text="$1"
    local generic_json="$2"
    case "$WEBHOOK_FORMAT" in
        slack)
            printf '{"text":"%s"}' "$(json_escape "$plain_text")"
            ;;
        discord)
            local short_txt="$plain_text"
            (( ${#short_txt} > 1920 )) && short_txt="${short_txt:0:1900}..."
            printf '{"content":"```\\n%s\\n```"}' "$(json_escape "$short_txt")"
            ;;
        *)
            printf '%s' "$generic_json"
            ;;
    esac
}

queue_outbox_message() {
    local dedup_id="$1"
    local channel="$2"
    local subject="$3"
    local total_queue="$4"
    local payload="$5"
    local now_ts="${ZSM_NOW_EPOCH:-$(date +%s)}"
    local outbox_dir="$STATE_DIR/outbox"
    mkdir -p "$outbox_dir" 2>/dev/null || true

    local safe_id
    safe_id=$(printf '%s' "${dedup_id}_${channel}" | tr -c 'a-zA-Z0-9._-' '_')
    local fpath="${outbox_dir}/${safe_id}.msg"
    local created_ts="$now_ts"
    local attempts=1
    if [[ -f "$fpath" ]]; then
        local old_c old_a
        old_c=$(sed -n 's/^CREATED_TS=//p' "$fpath" | head -n 1)
        old_a=$(sed -n 's/^ATTEMPTS=//p' "$fpath" | head -n 1)
        [[ "$old_c" =~ ^[0-9]+$ ]] && created_ts="$old_c"
        [[ "$old_a" =~ ^[0-9]+$ ]] && attempts="$old_a"
    fi

    (
        umask 077
        {
            printf 'CHANNEL=%s\n' "$channel"
            printf 'ATTEMPTS=%s\n' "$attempts"
            printf 'CREATED_TS=%s\n' "$created_ts"
            printf 'TOTAL_QUEUE=%s\n' "$total_queue"
            printf 'SUBJECT=%s\n' "${subject//$'\n'/ }"
            printf '%s\n' "---PAYLOAD---"
            printf '%s' "$payload"
        } > "$fpath"
    )
    log_msg "WARN" "Queued failed ${channel} alert to outbox for retry (${safe_id})"
}

flush_alert_outbox() {
    local outbox_dir="$STATE_DIR/outbox"
    [[ ! -d "$outbox_dir" ]] && return 0

    local now_ts="${ZSM_NOW_EPOCH:-$(date +%s)}"
    local processed=0
    local fpath
    for fpath in "$outbox_dir"/*.msg; do
        [[ ! -f "$fpath" ]] && continue
        (( processed >= 10 )) && break

        local channel attempts created_ts total_q subject payload
        channel=$(sed -n 's/^CHANNEL=//p' "$fpath" | head -n 1)
        attempts=$(sed -n 's/^ATTEMPTS=//p' "$fpath" | head -n 1)
        created_ts=$(sed -n 's/^CREATED_TS=//p' "$fpath" | head -n 1)
        total_q=$(sed -n 's/^TOTAL_QUEUE=//p' "$fpath" | head -n 1)
        subject=$(sed -n 's/^SUBJECT=//p' "$fpath" | head -n 1)
        payload=$(awk 'found {print} /^---PAYLOAD---$/ {found=1}' "$fpath")

        [[ ! "$attempts" =~ ^[0-9]+$ ]] && attempts=1
        [[ ! "$created_ts" =~ ^[0-9]+$ ]] && created_ts="$now_ts"
        [[ ! "$total_q" =~ ^[0-9]+$ ]] && total_q=0

        # Drop expired (> 60 mins) or exhausted (>= 6 retries) outbox messages
        if (( attempts >= 6 )) || (( now_ts > created_ts && now_ts - created_ts > 3600 )); then
            log_msg "WARN" "Dropping expired outbox alert $(basename "$fpath") after ${attempts} attempts"
            rm -f "$fpath"
            continue
        fi

        local ok=1
        case "$channel" in
            telegram) send_telegram_alert "$payload" && ok=0 ;;
            email)    send_email_alert "$subject" "$payload" "$total_q" && ok=0 ;;
            webhook)  send_webhook_alert "$payload" && ok=0 ;;
            *)        rm -f "$fpath"; continue ;;
        esac

        if (( ok == 0 )); then
            log_msg "INFO" "Delivered queued outbox alert $(basename "$fpath") on retry #${attempts}"
            rm -f "$fpath"
        else
            local next_att=$(( attempts + 1 ))
            awk -v na="$next_att" 'NR==2 && /^ATTEMPTS=/ {print "ATTEMPTS=" na; next} {print}' "$fpath" > "${fpath}.tmp" 2>/dev/null && mv -f "${fpath}.tmp" "$fpath"
        fi
        processed=$(( processed + 1 ))
    done
}

# Dispatches across all enabled channels; queues failures to outbox; returns 0 if >=1 succeeded
dispatch_notifications() {
    local dedup_id="$1"
    local tg_html="$2"
    local mail_subj="$3"
    local mail_body="$4"
    local total_q="$5"
    local wh_json="${6:-}"

    local any_enabled=0
    local any_ok=0

    if [[ "$TELEGRAM_ENABLED" == "true" ]]; then
        any_enabled=1
        if send_telegram_alert "$tg_html"; then
            any_ok=1
        elif [[ -n "$TELEGRAM_BOT_TOKEN" && -n "$TELEGRAM_CHAT_ID" ]]; then
            queue_outbox_message "$dedup_id" "telegram" "$mail_subj" "$total_q" "$tg_html"
        fi
    fi

    if [[ "$EMAIL_ENABLED" == "true" ]]; then
        any_enabled=1
        if send_email_alert "$mail_subj" "$mail_body" "$total_q"; then
            any_ok=1
        else
            queue_outbox_message "$dedup_id" "email" "$mail_subj" "$total_q" "$mail_body"
        fi
    fi

    if [[ "$WEBHOOK_ENABLED" == "true" && -n "$wh_json" ]]; then
        any_enabled=1
        if send_webhook_alert "$wh_json"; then
            any_ok=1
        elif [[ -n "$WEBHOOK_URL" ]]; then
            queue_outbox_message "$dedup_id" "webhook" "$mail_subj" "$total_q" "$wh_json"
        fi
    fi

    if (( any_enabled == 0 || any_ok == 1 )); then
        return 0
    fi
    return 1
}

# ==============================================================================
# ZIMBRA LOG (/var/log/zimbra.log, mailbox.log, audit.log) & POSTFIX QUEUE ENGINE
# Ultra-low RAM/CPU via Early Timestamp Pruning, per-second mktime() cache,
# C-speed grep pre-filters, and logrotate (.1) continuity.
# ==============================================================================
parse_first_line_epoch() {
    local sample_line="$1"
    local now_epoch="$2"
    local cur_year="$3"
    local awk_bin="$4"
    [[ -z "$sample_line" ]] && echo "0" && return 0

    printf '%s\n' "$sample_line" | "$awk_bin" -v now_epoch="$now_epoch" -v cur_year="$cur_year" '
    BEGIN {
        split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", mnames, " ")
        for (i = 1; i <= 12; i++) m_map[mnames[i]] = sprintf("%02d", i)
    }
    {
        if (match($0, /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9][T ][0-9][0-9]:[0-9][0-9]:[0-9][0-9]/)) {
            s = substr($0, 1, 19)
            print mktime(substr(s,1,4) " " substr(s,6,2) " " substr(s,9,2) " " substr(s,12,2) " " substr(s,15,2) " " substr(s,18,2))
            exit
        }
        if (($1 in m_map) && ($2 ~ /^[0-9]+$/) && ($3 ~ /^[0-9][0-9]:[0-9][0-9]:[0-9][0-9]$/)) {
            split($3, hms, ":")
            ts = mktime(cur_year " " m_map[$1] " " sprintf("%02d", $2 + 0) " " hms[1] " " hms[2] " " hms[3])
            if (ts > now_epoch + 86400) {
                ts = mktime((cur_year - 1) " " m_map[$1] " " sprintf("%02d", $2 + 0) " " hms[1] " " hms[2] " " hms[3])
            }
            print ts
            exit
        }
        print 0
    }' 2>/dev/null || echo "0"
}

find_rotated_zimbra_log() {
    if [[ -r "${ZIMBRA_LOG_FILE}.1" ]]; then
        echo "${ZIMBRA_LOG_FILE}.1"
        return 0
    fi
    # Check dateext uncompressed rotated log (e.g. zimbra.log-20261108)
    local latest=""
    latest=$(ls -1t "${ZIMBRA_LOG_FILE}"-[0-9]* 2>/dev/null | grep -Ev '\.(gz|bz2|xz|zst)$' | head -n 1 || true)
    if [[ -n "$latest" && -r "$latest" ]]; then
        echo "$latest"
    fi
}

stream_zimbra_log_window() {
    local prune_cutoff="$1"
    local now_epoch="$2"
    local cur_year="$3"
    local awk_bin="$4"

    # Fast 1-line check (reads ~100 bytes): detects recent logrotate without double-reading file
    local file_first_line file_first_ts
    file_first_line=$(head -n 1 "$ZIMBRA_LOG_FILE" 2>/dev/null || true)
    file_first_ts=$(parse_first_line_epoch "$file_first_line" "$now_epoch" "$cur_year" "$awk_bin")

    if [[ "$file_first_ts" =~ ^[0-9]+$ ]] && (( file_first_ts > 0 && file_first_ts >= prune_cutoff )); then
        local prev_log
        prev_log=$(find_rotated_zimbra_log)
        if [[ -n "$prev_log" ]]; then
            tail -n "$LOG_TAIL_LINES" "$prev_log" 2>/dev/null
        fi
        tail -n "$LOG_MAX_TAIL_LINES" "$ZIMBRA_LOG_FILE" 2>/dev/null
        return 0
    fi

    # Only probe for spam-storm expansion (> LOG_TAIL_LINES within window) if file exceeds ~200 bytes/line * LOG_TAIL_LINES
    local fsize=0
    local probe_bytes=$(( LOG_TAIL_LINES * 200 ))
    fsize=$(stat -c %s "$ZIMBRA_LOG_FILE" 2>/dev/null || wc -c < "$ZIMBRA_LOG_FILE" 2>/dev/null || echo "0")
    if [[ "$fsize" =~ ^[0-9]+$ ]] && (( fsize > probe_bytes && LOG_MAX_TAIL_LINES > LOG_TAIL_LINES )); then
        local first_tail_line first_ts
        first_tail_line=$(tail -n "$LOG_TAIL_LINES" "$ZIMBRA_LOG_FILE" 2>/dev/null | head -n 1 || true)
        first_ts=$(parse_first_line_epoch "$first_tail_line" "$now_epoch" "$cur_year" "$awk_bin")
        if [[ "$first_ts" =~ ^[0-9]+$ ]] && (( first_ts > 0 && first_ts >= prune_cutoff )); then
            tail -n "$LOG_MAX_TAIL_LINES" "$ZIMBRA_LOG_FILE" 2>/dev/null
            return 0
        fi
    fi

    tail -n "$LOG_TAIL_LINES" "$ZIMBRA_LOG_FILE" 2>/dev/null
}

# Single-server auxiliary log reader (mailbox.log for real Webmail IPs; audit.log for Brute-Force & Auth-After-Fail)
# Pre-filtered with C-speed grep so RAM < 3MB and CPU < 0.03s even on busy servers.
analyze_aux_zimbra_logs() {
    local webmail_ips_out="$1"
    local auth_events_out="$2"
    local now_epoch="$3"
    local local_ips="$4"
    local awk_bin="$5"

    : > "$webmail_ips_out"
    : > "$auth_events_out"

    local win_cutoff=$(( now_epoch - LOOKBACK_MINUTES * 60 ))

    # 1. mailbox.log: real originating IP (oip= / ip=) for Webmail/SOAP/ActiveSync SendMsg
    if [[ -r "$ZIMBRA_MAILBOX_LOG_FILE" ]]; then
        tail -n "$AUX_LOG_TAIL_LINES" "$ZIMBRA_MAILBOX_LOG_FILE" 2>/dev/null | \
            grep -F "smtp - Sending message" 2>/dev/null | \
            "$awk_bin" -v win_cutoff="$win_cutoff" -v now_epoch="$now_epoch" -v local_ips="$local_ips" '
            BEGIN {
                n = split(local_ips, arr, /[[:space:],]+/)
                for (i = 1; i <= n; i++) if (arr[i] != "") is_lip[arr[i]] = 1
                is_lip["127.0.0.1"] = 1; is_lip["::1"] = 1
                prev_k = ""; prev_ts = 0
            }
            {
                k = substr($0, 1, 19)
                if (k == prev_k) {
                    ts = prev_ts
                } else if (k ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9]$/) {
                    ts = mktime(substr(k,1,4) " " substr(k,6,2) " " substr(k,9,2) " " substr(k,12,2) " " substr(k,15,2) " " substr(k,18,2))
                    prev_k = k; prev_ts = ts
                } else {
                    ts = 0
                }
                if (ts > 0 && (ts < win_cutoff || ts > now_epoch + 300)) next

                acct = ""
                if (match($0, /name=[^;\] ]+/)) {
                    acct = tolower(substr($0, RSTART + 5, RLENGTH - 5))
                }
                if (acct == "" || index(acct, "@") == 0) next

                cip = ""
                if (match($0, /oip=[0-9a-fA-F.:]+/)) {
                    cip = substr($0, RSTART + 4, RLENGTH - 4)
                }
                if ((cip == "" || (cip in is_lip)) && match($0, /[;\[]ip=[0-9a-fA-F.:]+/)) {
                    cip = substr($0, RSTART + 4, RLENGTH - 4)
                }
                if (cip != "" && !(cip in is_lip)) {
                    pair = acct "|" cip
                    if (!(pair in seen)) {
                        seen[pair] = 1
                        print pair
                    }
                }
            }' >> "$webmail_ips_out" 2>/dev/null || true
    fi

    # 2. audit.log: failed auth brute-force & successful Auth after repeated failures (compromise signal)
    if [[ -r "$ZIMBRA_AUDIT_LOG_FILE" ]]; then
        tail -n "$AUX_LOG_TAIL_LINES" "$ZIMBRA_AUDIT_LOG_FILE" 2>/dev/null | \
            grep -E "cmd=Auth|authentication failed|invalid password" 2>/dev/null | \
            "$awk_bin" -v win_cutoff="$win_cutoff" -v now_epoch="$now_epoch" -v local_ips="$local_ips" \
                -v fail_min="$AUTH_FAIL_BEFORE_SUCCESS_MIN" -v ip_fail_thresh="$WARN_AUTH_FAIL_PER_IP" -v web_out="$webmail_ips_out" '
            BEGIN {
                n = split(local_ips, arr, /[[:space:],]+/)
                for (i = 1; i <= n; i++) if (arr[i] != "") is_lip[arr[i]] = 1
                is_lip["127.0.0.1"] = 1; is_lip["::1"] = 1
                prev_k = ""; prev_ts = 0
            }
            {
                k = substr($0, 1, 19)
                if (k == prev_k) {
                    ts = prev_ts
                } else if (k ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9]$/) {
                    ts = mktime(substr(k,1,4) " " substr(k,6,2) " " substr(k,9,2) " " substr(k,12,2) " " substr(k,15,2) " " substr(k,18,2))
                    prev_k = k; prev_ts = ts
                } else {
                    ts = 0
                }
                if (ts > 0 && (ts < win_cutoff || ts > now_epoch + 300)) next

                cip = ""
                if (match($0, /oip=[0-9a-fA-F.:]+/)) {
                    cip = substr($0, RSTART + 4, RLENGTH - 4)
                }
                if ((cip == "" || (cip in is_lip)) && match($0, /[;\[]ip=[0-9a-fA-F.:]+/)) {
                    cip = substr($0, RSTART + 4, RLENGTH - 4)
                }
                if (cip == "" || (cip in is_lip)) next

                acct = ""
                if (match($0, /account=[^; ]+/)) {
                    acct = tolower(substr($0, RSTART + 8, RLENGTH - 8))
                } else if (match($0, /name=[^;\] ]+/)) {
                    acct = tolower(substr($0, RSTART + 5, RLENGTH - 5))
                }

                is_fail = (index($0, "error=") > 0 || index($0, "authentication failed") > 0 || index($0, "invalid password") > 0)
                if (is_fail) {
                    fail_ip[cip]++
                    if (acct != "") fail_pair[acct "|" cip]++
                } else if (index($0, "cmd=Auth") > 0 && acct != "" && index(acct, "@") > 0) {
                    # Successful auth: flag if THIS account failed >= fail_min from this IP,
                    # OR if this IP exceeded mass brute-force threshold (prevents office NAT false alerts)
                    fp = fail_pair[acct "|" cip] + 0
                    fi = fail_ip[cip] + 0
                    if (fp >= fail_min || fi >= ip_fail_thresh) {
                        fc = (fp >= fail_min ? fp : fi)
                        if (!(acct in compromised) || fc > comp_cnt[acct]) {
                            compromised[acct] = cip
                            comp_cnt[acct] = fc
                        }
                    }
                }
            }
            END {
                for (ip in fail_ip) {
                    printf "FAILIP|%s|%d\n", ip, fail_ip[ip]
                }
                for (a in compromised) {
                    printf "AUTH_AFTER_FAIL|%s|%s|%d\n", a, compromised[a], comp_cnt[a]
                }
            }' > "$auth_events_out" 2>/dev/null || true
    fi
}

analyze_zimbra_log() {
    local out_file="$1"
    local sys_sum_file="${2:-}"
    local bkt_file="${3:-}"
    local qid_map_file="${4:-}"
    local aux_webmail_file="${5:-}"
    local sasl_fail_out="${6:-}"
    local history_scan_mins="${7:-$LOOKBACK_MINUTES}"

    : > "$out_file"
    [[ -n "$sys_sum_file" ]] && echo "0|0|0|0" > "$sys_sum_file"
    [[ -n "$bkt_file" ]] && : > "$bkt_file"
    [[ -n "$qid_map_file" ]] && : > "$qid_map_file"
    [[ -n "$sasl_fail_out" ]] && : > "$sasl_fail_out"

    if [[ ! -f "$ZIMBRA_LOG_FILE" ]]; then
        log_msg "WARN" "Zimbra log file not found: $ZIMBRA_LOG_FILE"
        return 0
    fi

    resolve_zimbra_settings
    local now_epoch="${ZSM_NOW_EPOCH:-$(date +%s)}"
    local cur_year
    cur_year=$(date -d "@$now_epoch" '+%Y' 2>/dev/null || date '+%Y')
    local local_ips
    local_ips=$(get_local_ips)
    local unlock_file="$STATE_DIR/unlock_cutoff.db"
    local awk_bin
    awk_bin=$(find_awk_bin)

    (( history_scan_mins < LOOKBACK_MINUTES )) && history_scan_mins="$LOOKBACK_MINUTES"
    (( history_scan_mins > 60 )) && history_scan_mins=60
    local prune_cutoff=$(( now_epoch - (history_scan_mins * 60) - 120 ))

    stream_zimbra_log_window "$prune_cutoff" "$now_epoch" "$cur_year" "$awk_bin" | "$awk_bin" \
        -v now_epoch="$now_epoch" \
        -v cur_year="$cur_year" \
        -v win_mins="$LOOKBACK_MINUTES" \
        -v hist_mins="$history_scan_mins" \
        -v prune_cutoff="$prune_cutoff" \
        -v count_internal="$COUNT_INTERNAL_TO_INTERNAL" \
        -v internal_domains="$RESOLVED_INTERNAL_DOMAINS" \
        -v default_domain="$RESOLVED_DEFAULT_DOMAIN" \
        -v alert_from_addr="${RESOLVED_EMAIL_FROM,,}" \
        -v local_ips="$local_ips" \
        -v ip_count_mode="$SOURCE_IP_COUNT_MODE" \
        -v amavis_thresh="$AMAVIS_SPAM_SCORE_THRESHOLD" \
        -v unlock_file="$unlock_file" \
        -v webmail_ips_file="$aux_webmail_file" \
        -v sys_file="$sys_sum_file" \
        -v bkt_file="$bkt_file" \
        -v qid_map_file="$qid_map_file" \
        -v sasl_fail_file="$sasl_fail_out" '
    BEGIN {
        win_cutoff  = now_epoch - (win_mins * 60)
        hist_cutoff = now_epoch - (hist_mins * 60)
        sys_tot = 0; sys_snt = 0; sys_def = 0; sys_bnc = 0
        amavis_limit = amavis_thresh + 0
        prev_ts_key = ""; prev_ts = 0; prev_hms = ""

        n_lip = split(local_ips, lip_arr, /[[:space:],]+/)
        for (i = 1; i <= n_lip; i++) {
            if (lip_arr[i] != "") is_local_ip[lip_arr[i]] = 1
        }
        is_local_ip["127.0.0.1"] = 1
        is_local_ip["::1"] = 1

        split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", mnames, " ")
        for (i = 1; i <= 12; i++) m_map[mnames[i]] = sprintf("%02d", i)

        n_dom = split(tolower(internal_domains), dom_arr, /[[:space:],]+/)
        for (i = 1; i <= n_dom; i++) {
            if (dom_arr[i] != "") int_dom[dom_arr[i]] = 1
        }

        if (unlock_file != "") {
            while ((getline uline < unlock_file) > 0) {
                split(uline, uparts, "|")
                if (uparts[1] != "" && uparts[2] != "") {
                    unlock_ts[tolower(uparts[1])] = uparts[2] + 0
                }
            }
            close(unlock_file)
        }

        if (webmail_ips_file != "") {
            while ((getline wline < webmail_ips_file) > 0) {
                split(wline, wparts, "|")
                if (wparts[1] != "" && wparts[2] != "") {
                    wa = tolower(wparts[1]); wi = wparts[2]
                    if (!(wa in aux_ip_list)) aux_ip_list[wa] = wi
                    else if (index(" " aux_ip_list[wa] " ", " " wi " ") == 0) aux_ip_list[wa] = aux_ip_list[wa] " " wi
                }
            }
            close(webmail_ips_file)
        }
    }

    # Ultra-fast timestamp parser with per-second cache (avoids field split & mktime on 99.5% of lines)
    function parse_epoch_fast(line,   k, y, mo, dy, hr, mi, sc, ts, p1, p2, p3, hms) {
        line_hms = ""
        # Case 1: Standard syslog "Nov  8 14:58:40 ..." or "Nov 18 14:58:40 ..." (15 chars)
        if (substr(line, 16, 1) == " " && substr(line, 10, 1) == ":" && substr(line, 13, 1) == ":") {
            k = substr(line, 1, 15)
            if (k == prev_ts_key) {
                line_hms = prev_hms
                return prev_ts
            }
            mo = m_map[substr(k, 1, 3)]
            if (mo != "") {
                dy = substr(k, 5, 2) + 0
                line_hms = substr(k, 8, 8)
                hr = substr(k, 8, 2); mi = substr(k, 11, 2); sc = substr(k, 14, 2)
                ts = mktime(cur_year " " mo " " sprintf("%02d", dy) " " hr " " mi " " sc)
                if (ts > now_epoch + 86400) {
                    ts = mktime((cur_year - 1) " " mo " " sprintf("%02d", dy) " " hr " " mi " " sc)
                }
                prev_ts_key = k; prev_ts = ts; prev_hms = line_hms
                return ts
            }
        }
        # Case 2: ISO-8601 "2026-11-08T14:58:40..."
        if (substr(line, 5, 1) == "-" && substr(line, 8, 1) == "-" && substr(line, 11, 1) == "T") {
            k = substr(line, 1, 19)
            if (k == prev_ts_key) {
                line_hms = prev_hms
                return prev_ts
            }
            y = substr(k, 1, 4); mo = substr(k, 6, 2); dy = substr(k, 9, 2)
            hr = substr(k, 12, 2); mi = substr(k, 15, 2); sc = substr(k, 18, 2)
            line_hms = hr ":" mi ":" sc
            ts = mktime(y " " mo " " dy " " hr " " mi " " sc)
            prev_ts_key = k; prev_ts = ts; prev_hms = line_hms
            return ts
        }
        # Fallback for single-space syslog days (e.g. "Nov 8 14:58:40")
        if (($1 in m_map) && ($2 ~ /^[0-9]+$/) && ($3 ~ /^[0-9][0-9]:[0-9][0-9]:[0-9][0-9]$/)) {
            k = $1 " " $2 " " $3
            if (k == prev_ts_key) {
                line_hms = prev_hms
                return prev_ts
            }
            mo = m_map[$1]
            dy = sprintf("%02d", $2 + 0)
            line_hms = $3
            split($3, hms, ":")
            ts = mktime(cur_year " " mo " " dy " " hms[1] " " hms[2] " " hms[3])
            if (ts > now_epoch + 86400) {
                ts = mktime((cur_year - 1) " " mo " " dy " " hms[1] " " hms[2] " " hms[3])
            }
            prev_ts_key = k; prev_ts = ts; prev_hms = line_hms
            return ts
        }
        return 0
    }

    function extract_domain(email,   idx) {
        idx = index(email, "@")
        if (idx > 0) return substr(email, idx + 1)
        return ""
    }

    function ip_subnet_key(cip,   parts, n) {
        if (ip_count_mode == "exact") return cip
        if (index(cip, ".") > 0) {
            n = split(cip, parts, ".")
            if (n == 4) return parts[1] "." parts[2] "." parts[3] ".0/24"
        } else if (index(cip, ":") > 0) {
            n = split(cip, parts, ":")
            if (n >= 4) return parts[1] ":" parts[2] ":" parts[3] ":" parts[4] "::/64"
        }
        return cip
    }

    function record_ip(acct, cip,   net) {
        if (cip == "" || cip == "127.0.0.1" || cip == "::1" || cip == "localhost" || cip == "webmail/local") {
            if (!(acct in has_any_ip)) {
                has_any_ip[acct] = 1
                sender_ips[acct] = "webmail/local"
            }
            return
        }
        if (!((acct "|" cip) in seen_ip)) {
            seen_ip[acct "|" cip] = 1
            win_real_ip_cnt[acct]++
            has_any_ip[acct] = 1
            if (sender_ips[acct] == "" || sender_ips[acct] == "webmail/local") {
                sender_ips[acct] = cip
            } else if (win_real_ip_cnt[acct] <= 5) {
                sender_ips[acct] = sender_ips[acct] ", " cip
            }
        }
        net = ip_subnet_key(cip)
        if (!((acct "|" net) in seen_net)) {
            seen_net[acct "|" net] = 1
            win_net_cnt[acct]++
        }
    }

    function is_system_pickup_sender(addr,   d) {
        if (addr == "" || addr == "<>" || addr == "mailer-daemon") return 1
        if (alert_from_addr != "" && addr == alert_from_addr) return 1
        if (addr ~ /^(root|zimbra|postmaster|daemon|nobody|cron|logwatch|noreply-monitor)@/) return 1
        d = extract_domain(addr)
        if (d == "" || d == "localhost" || d ~ /^localhost\./ || d ~ /\.localdomain$/) return 1
        return 0
    }

    {
        # EARLY PRUNING: Skip lines outside [prune_cutoff, now_epoch + 300] BEFORE regex or array allocation!
        ts = parse_epoch_fast($0)
        if (ts > 0 && (ts < prune_cutoff || ts > now_epoch + 300)) next

        has_postfix = (index($0, "postfix/") > 0)
        has_amavis  = (index($0, "amavis[") > 0)
        if (!has_postfix && !has_amavis) next

        # 0. Postfix SASL authentication failure (Brute-force tracking)
        if (has_postfix && index($0, "authentication failed") > 0 && index($0, "SASL ") > 0) {
            if (ts >= win_cutoff && match($0, /\[[0-9a-fA-F.:]+\]/)) {
                fip = substr($0, RSTART + 1, RLENGTH - 2)
                if (!(fip in is_local_ip)) sasl_fail_ip[fip]++
            }
            next
        }

        # 1. Amavis Content Filter Verdict (SPAM / SPAMMY / INFECTED / BANNED / High Hits)
        if (has_amavis) {
            is_amavis_bad = 0
            if (index($0, "Blocked SPAM") > 0 || index($0, "Passed SPAM ") > 0 ||
                index($0, "Passed SPAMMY") > 0 || index($0, "Blocked INFECTED") > 0 ||
                index($0, "Passed INFECTED") > 0 || index($0, "Blocked BANNED") > 0 ||
                index($0, "Passed BANNED") > 0) {
                is_amavis_bad = 1
            } else if (match($0, /Hits: -?[0-9]+(\.[0-9]+)?/)) {
                hits_val = substr($0, RSTART + 6, RLENGTH - 6) + 0
                if (hits_val >= amavis_limit) is_amavis_bad = 1
            }

            if (is_amavis_bad) {
                aqid = ""
                if (match($0, /Queue-ID: [0-9A-Za-z]+/)) {
                    aqid = substr($0, RSTART + 10, RLENGTH - 10)
                    is_amavis_inbound = (index($0, "Inbound}") > 0 && index($0, "ORIGINATING") == 0 && index($0, "MYNETS") == 0 && !(aqid in q_sasl))
                    if (!is_amavis_inbound) {
                        q_amavis_spam[aqid] = 1
                    }
                }
                if (index($0, "Blocked ") > 0 && (index($0, "ORIGINATING") > 0 || index($0, "MYNETS") > 0 || (aqid != "" && (aqid in q_sasl)))) {
                    asender = ""
                    if (aqid != "" && (aqid in q_sasl)) {
                        asender = q_sasl[aqid]
                    } else if (match($0, /<[^>]+> ->/)) {
                        asender = tolower(substr($0, RSTART + 1, RLENGTH - 5))
                    }
                    if (asender != "" && (extract_domain(asender) in int_dom)) {
                        am_key = (aqid != "" ? aqid : NR)
                        q_amavis_blocked_acct[am_key] = asender
                        q_amavis_blocked_ts[am_key] = ts
                        q_amavis_blocked_hms[am_key] = line_hms
                        if (aqid != "" && (aqid in q_sasl)) q_amavis_blocked_sasl[am_key] = 1
                        if (aqid != "" && (aqid in q_ip)) {
                            q_amavis_blocked_ip[am_key] = q_ip[aqid]
                        } else if (match($0, /\[[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\]/)) {
                            q_amavis_blocked_ip[am_key] = substr($0, RSTART + 1, RLENGTH - 2)
                        }
                    }
                }
            }
            next
        }

        # 2. Postfix SASL Authenticated Submission
        if (index($0, "sasl_username=") > 0) {
            qid = ""
            if (match($0, /: [0-9A-Za-z]+: client=/)) {
                qid = substr($0, RSTART + 2, RLENGTH - 11)
            }
            sasl = ""
            if (match($0, /sasl_username=[^ ,]+/)) {
                sasl = tolower(substr($0, RSTART + 14, RLENGTH - 14))
                if (sasl != "" && index(sasl, "@") == 0 && default_domain != "") {
                    sasl = sasl "@" tolower(default_domain)
                }
            }
            cip = ""
            if (match($0, /client=[^ ,]+/)) {
                cip = substr($0, RSTART + 7, RLENGTH - 7)
                if (match(cip, /\[[0-9a-fA-F.:]+\]/)) {
                    cip = substr(cip, RSTART + 1, RLENGTH - 2)
                }
            }
            if (qid != "" && sasl != "") {
                q_sasl[qid] = sasl
                q_root[qid] = qid
                q_birth_ts[qid] = ts
                if (line_hms != "") q_birth_hms[qid] = line_hms
                if (cip != "") q_ip[qid] = cip
            }
            next
        }

        # 3. Local Zimbra Webmail / Trusted Submission vs External Inbound (non-SASL smtpd)
        if ((index($0, "postfix/smtpd[") > 0 || index($0, "/smtpd[") > 0) && index($0, ": client=") > 0) {
            is_filter_reinject = (index($0, "amavisd/smtpd[") > 0 || index($0, "dkimmilter/smtpd[") > 0)
            qid = ""
            if (match($0, /: [0-9A-Za-z]+: client=/)) {
                qid = substr($0, RSTART + 2, RLENGTH - 11)
            }
            cip = ""
            if (match($0, /client=[^ ,]+/)) {
                cip = substr($0, RSTART + 7, RLENGTH - 7)
                if (match(cip, /\[[0-9a-fA-F.:]+\]/)) {
                    cip = substr(cip, RSTART + 1, RLENGTH - 2)
                }
            }
            if (qid != "" && !is_filter_reinject) {
                if (cip in is_local_ip) {
                    q_local_client[qid] = 1
                    if (!(qid in q_root)) q_root[qid] = qid
                    if (!(qid in q_birth_ts)) q_birth_ts[qid] = ts
                    if (!(qid in q_birth_hms) && line_hms != "") q_birth_hms[qid] = line_hms
                    if (!(qid in q_ip)) q_ip[qid] = "webmail/local"
                } else if (cip != "") {
                    # Unauthenticated external Internet inbound client -> never attribute to internal user
                    q_ext_client[qid] = 1
                }
            }
            next
        }

        # 3b. Local Postfix Pickup (local sendmail / PHP webshell detection)
        if (index($0, "postfix/pickup[") > 0 && index($0, "uid=") > 0) {
            qid = ""
            if (match($0, /: [0-9A-Za-z]+: uid=/)) {
                qid = substr($0, RSTART + 2, RLENGTH - 8)
            }
            puid = ""
            if (match($0, /uid=[0-9]+/)) {
                puid = substr($0, RSTART + 4, RLENGTH - 4)
            }
            if (qid != "" && puid != "") {
                q_pickup_uid[qid] = puid
                if (!(qid in q_root)) q_root[qid] = qid
                if (!(qid in q_birth_ts)) q_birth_ts[qid] = ts
                if (!(qid in q_birth_hms) && line_hms != "") q_birth_hms[qid] = line_hms
                if (!(qid in q_ip)) q_ip[qid] = "webmail/local"
            }
            next
        }

        # 4. Postfix Queue Manager (Envelope From)
        if (index($0, "postfix/qmgr") > 0 && index($0, "from=<") > 0) {
            qid = ""
            if (match($0, /: [0-9A-Za-z]+: from=</)) {
                qid = substr($0, RSTART + 2, RLENGTH - 10)
            }
            faddr = ""
            if (match($0, /from=<[^>]*>/)) {
                faddr = tolower(substr($0, RSTART + 6, RLENGTH - 7))
            }
            if (qid != "") {
                if (faddr != "") q_from[qid] = faddr
                if (!(qid in q_root)) q_root[qid] = qid
                if (!(qid in q_birth_ts)) q_birth_ts[qid] = ts
                if (!(qid in q_birth_hms) && line_hms != "") q_birth_hms[qid] = line_hms
            }
            next
        }

        # 5. Postfix Delivery / Amavis Handoff (smtp, error, and internal post-Amavis lmtp)
        if ((index($0, "postfix/smtp[") > 0 || index($0, "postfix/error[") > 0 || index($0, "postfix/lmtp[") > 0) && index($0, "to=<") > 0 && index($0, "status=") > 0) {
            qid = ""
            if (match($0, /: [0-9A-Za-z]+: to=</)) {
                qid = substr($0, RSTART + 2, RLENGTH - 8)
            }
            if (qid == "") next

            # Handle internal Amavis / DKIM filter hop (127.0.0.1:100xx, localhost:100xx, [::1]:100xx)
            is_amavis_hop = (index($0, "127.0.0.1]:100") > 0 || index($0, "localhost]:100") > 0 || index($0, "::1]:100") > 0)
            if (is_amavis_hop) {
                if (match($0, /queued as [0-9A-Za-z]+/)) {
                    qid2 = substr($0, RSTART + 10, RLENGTH - 10)
                    q_root[qid2] = (qid in q_root ? q_root[qid] : qid)
                    if (qid in q_sasl) q_sasl[qid2] = q_sasl[qid]
                    if (qid in q_from) q_from[qid2] = q_from[qid]
                    if (qid in q_ip) q_ip[qid2] = q_ip[qid]
                    if (qid in q_local_client) q_local_client[qid2] = q_local_client[qid]
                    if (qid in q_ext_client) {
                        q_ext_client[qid2] = 1
                        delete q_local_client[qid2]
                    }
                    if (qid in q_pickup_uid) q_pickup_uid[qid2] = q_pickup_uid[qid]
                    if (qid in q_birth_ts) q_birth_ts[qid2] = q_birth_ts[qid]
                    if (qid in q_birth_hms) q_birth_hms[qid2] = q_birth_hms[qid]
                    if (qid in q_amavis_spam) q_amavis_spam[qid2] = q_amavis_spam[qid]
                    next
                }
                if (index($0, "discarded") == 0) {
                    next
                }
            }

            sasl_user = (qid in q_sasl ? q_sasl[qid] : "")
            env_from  = (qid in q_from ? q_from[qid] : "")
            root_qid  = (qid in q_root ? q_root[qid] : qid)

            # Never attribute unauthenticated external Internet inbound mail (even if spoofed From) to internal users
            if (sasl_user == "" && ((qid in q_ext_client) || (root_qid in q_ext_client))) {
                next
            }

            rcpt = ""
            if (match($0, /to=<[^>]+>/)) {
                rcpt = tolower(substr($0, RSTART + 4, RLENGTH - 5))
            }
            rdom = extract_domain(rcpt)

            acct = ""
            is_spoof = 0
            ev_origin = ""
            if (sasl_user != "") {
                acct = sasl_user
                ev_origin = "sasl"
                if (env_from != "" && env_from != "<>" && env_from != sasl_user) {
                    fdom = extract_domain(env_from)
                    if (fdom != "" && !(fdom in int_dom)) {
                        is_spoof = 1
                    }
                }
            } else if (env_from != "" && env_from != "<>") {
                fdom = extract_domain(env_from)
                if (fdom in int_dom) {
                    if ((qid in q_local_client) || (qid in q_pickup_uid) || !(rdom in int_dom)) {
                        if (!((qid in q_pickup_uid) && is_system_pickup_sender(env_from))) {
                            acct = env_from
                            ev_origin = (qid in q_pickup_uid ? "pickup" : "webmail")
                        }
                    }
                } else if ((qid in q_pickup_uid) && !(rdom in int_dom) && !is_system_pickup_sender(env_from)) {
                    # Local script / webshell sending outbound mail with spoofed external From
                    acct = "local-pickup-uid:" q_pickup_uid[qid]
                    ev_origin = "pickup"
                }
            }
            if (acct == "") next

            # Skip benign internal-to-internal mail when COUNT_INTERNAL_TO_INTERNAL=false,
            # BUT NEVER skip internal malware/phishing flagged by Amavis or Sender Spoofing!
            is_amavis_flagged = ((qid in q_amavis_spam) || (root_qid in q_amavis_spam))
            if (count_internal != "true" && rdom != "" && (rdom in int_dom) && !is_spoof && !is_amavis_flagged) {
                next
            }

            st = "other"
            if (is_amavis_hop && index($0, "discarded") > 0) {
                st = "bounced"
            } else if (match($0, /status=[a-z]+/)) {
                st = substr($0, RSTART + 7, RLENGTH - 7)
                if (st == "expired") st = "bounced"
            }

            counted_qids[qid] = 1
            counted_qids[root_qid] = 1

            # True message submission time (prevents old Postfix deferred retries from triggering new alerts)
            delay_sec = 0
            if (match($0, /delay=[0-9]+(\.[0-9]+)?/)) {
                delay_sec = int(substr($0, RSTART + 6, RLENGTH - 6) + 0)
            }
            if ((qid in q_birth_ts) && q_birth_ts[qid] > 0 && delay_sec <= (hist_mins * 60)) {
                submit_ts = q_birth_ts[qid]
            } else if (delay_sec > 0 && ts > 0) {
                submit_ts = ts - delay_sec
            } else if ((qid in q_birth_ts) && q_birth_ts[qid] > 0) {
                submit_ts = q_birth_ts[qid]
            } else {
                submit_ts = ts
            }

            if (submit_ts < hist_cutoff) next
            if ((acct in unlock_ts) && submit_ts <= unlock_ts[acct]) next

            # Track QID -> account map for spoof-aware queue hold
            if (qid_map_file != "") {
                qid_owner[qid] = acct
                qid_owner[root_qid] = acct
            }

            # 5-minute submission-time bucket for idempotent 1h/24h rolling history
            bkt = int(submit_ts / 300) * 300
            bkt_key = bkt "|" acct
            b_mkey = bkt "|" acct "|" root_qid
            if (!(b_mkey in b_seen_msg)) {
                b_seen_msg[b_mkey] = 1
                b_msgs[bkt_key]++
                all_bkts[bkt_key] = 1
            }
            b_rkey = bkt "|" acct "|" root_qid "|" rcpt
            if (!(b_rkey in b_seen_rcpt)) {
                b_seen_rcpt[b_rkey] = 1
                b_rcpts[bkt_key]++
                all_bkts[bkt_key] = 1
            }

            # Short-window (LOOKBACK_MINUTES) detailed evaluation
            if (submit_ts < win_cutoff) next

            all_senders[acct] = 1
            if (submit_ts > win_last_submit_ts[acct]) win_last_submit_ts[acct] = submit_ts
            if (ev_origin == "sasl") has_sasl[acct] = 1
            else if (ev_origin == "pickup") has_pickup[acct] = 1
            else has_webmail[acct] = 1

            msg_key = acct "|" root_qid
            if (!(msg_key in seen_msg)) {
                seen_msg[msg_key] = 1
                win_msgs[acct]++
            }

            # Deduplicate retries per (acct, root_qid, rcpt), keeping final delivery state
            dr_key = acct "|" root_qid "|" rcpt
            if (!(dr_key in dr_status)) {
                dr_status[dr_key] = st
                win_rcpts[acct]++
                sys_tot++
                if (st == "sent") { win_sent[acct]++; sys_snt++ }
                else if (st == "deferred") { win_def[acct]++; sys_def++ }
                else if (st == "bounced") { win_bnc[acct]++; sys_bnc++ }
            } else if (dr_status[dr_key] != st) {
                old_st = dr_status[dr_key]
                if (old_st == "sent") { win_sent[acct]--; sys_snt-- }
                else if (old_st == "deferred") { win_def[acct]--; sys_def-- }
                else if (old_st == "bounced") { win_bnc[acct]--; sys_bnc-- }
                dr_status[dr_key] = st
                if (st == "sent") { win_sent[acct]++; sys_snt++ }
                else if (st == "deferred") { win_def[acct]++; sys_def++ }
                else if (st == "bounced") { win_bnc[acct]++; sys_bnc++ }
            }

            if (rcpt != "" && !((acct "|" rcpt) in seen_rcpt)) {
                seen_rcpt[acct "|" rcpt] = 1
                win_uniq_rcpts[acct]++
            }
            if (rdom != "" && !(rdom in int_dom) && !((acct "|" rdom) in seen_dom)) {
                seen_dom[acct "|" rdom] = 1
                win_uniq_doms[acct]++
            }

            record_ip(acct, (qid in q_ip ? q_ip[qid] : ""))

            # Count Spoof & Amavis ONCE per unique message (root_qid), NOT per CC/BCC recipient!
            if (is_spoof && !(msg_key in seen_spoof_msg)) {
                seen_spoof_msg[msg_key] = 1
                win_spoof[acct]++
            }
            if (is_amavis_flagged && !(msg_key in seen_amavis_msg)) {
                seen_amavis_msg[msg_key] = 1
                win_amavis[acct]++
            }

            if (st == "bounced" || st == "deferred") {
                low_line = tolower($0)
                if (index(low_line, "5.7.1") > 0 || index(low_line, "4.7.28") > 0 ||
                    index(low_line, "unsolicited") > 0 || index(low_line, "spamhaus") > 0 ||
                    index(low_line, "barracuda") > 0 || index(low_line, "sorbs") > 0 ||
                    index(low_line, "spamcop") > 0 || index(low_line, "blacklisted") > 0 ||
                    index(low_line, "blocked using") > 0 || index(low_line, "rejected as spam") > 0) {
                    if (!(dr_key in seen_rbl_dr)) {
                        seen_rbl_dr[dr_key] = 1
                        win_rbl[acct]++
                    }
                }
            }

            ev_hms = (line_hms != "" ? line_hms : q_birth_hms[qid])
            if (ev_hms != "") {
                if (!(acct in win_first_hms)) win_first_hms[acct] = ev_hms
                win_last_hms[acct] = ev_hms
            }
        }
    }

    END {
        # Include any Amavis Blocked SPAM/INFECTED/BANNED events that had no postfix/smtp line
        for (k in q_amavis_blocked_acct) {
            if (k in counted_qids) continue
            acct = q_amavis_blocked_acct[k]
            bts  = q_amavis_blocked_ts[k]
            if (bts < hist_cutoff) continue
            if ((acct in unlock_ts) && bts <= unlock_ts[acct]) continue

            bkt = int(bts / 300) * 300
            bkt_key = bkt "|" acct
            b_msgs[bkt_key]++
            b_rcpts[bkt_key]++
            all_bkts[bkt_key] = 1

            if (bts < win_cutoff) continue
            sys_tot++; sys_bnc++
            all_senders[acct] = 1
            if (bts > win_last_submit_ts[acct]) win_last_submit_ts[acct] = bts
            if (k in q_amavis_blocked_sasl) has_sasl[acct] = 1
            else has_webmail[acct] = 1
            win_msgs[acct]++
            win_rcpts[acct]++
            win_bnc[acct]++
            win_amavis[acct]++
            record_ip(acct, q_amavis_blocked_ip[k])
            if (q_amavis_blocked_hms[k] != "") {
                if (!(acct in win_first_hms)) win_first_hms[acct] = q_amavis_blocked_hms[k]
                win_last_hms[acct] = q_amavis_blocked_hms[k]
            }
        }

        # Enrich Webmail/SOAP accounts with real client IPs from mailbox.log
        for (s in all_senders) {
            if ((s in has_webmail) && (s in aux_ip_list)) {
                n_aux = split(aux_ip_list[s], aips, " ")
                for (i = 1; i <= n_aux; i++) {
                    if (aips[i] != "") record_ip(s, aips[i])
                }
            }
        }

        if (sys_file != "") {
            printf "%d|%d|%d|%d\n", sys_tot, sys_snt, sys_def, sys_bnc > sys_file
        }
        if (bkt_file != "") {
            for (bk in all_bkts) {
                split(bk, bp, "|")
                printf "%d|%s|%d|%d\n", bp[1], bp[2], b_msgs[bk]+0, b_rcpts[bk]+0 > bkt_file
            }
        }
        if (qid_map_file != "") {
            for (q in qid_owner) {
                printf "%s|%s\n", q, qid_owner[q] > qid_map_file
            }
        }
        if (sasl_fail_file != "") {
            for (ip in sasl_fail_ip) {
                printf "FAILIP|%s|%d\n", ip, sasl_fail_ip[ip] > sasl_fail_file
            }
        }

        for (s in all_senders) {
            m_cnt   = win_msgs[s] + 0
            r_cnt   = win_rcpts[s] + 0
            ur_cnt  = win_uniq_rcpts[s] + 0
            ud_cnt  = win_uniq_doms[s] + 0
            s_cnt   = win_sent[s] + 0
            d_cnt   = win_def[s] + 0
            b_cnt   = win_bnc[s] + 0
            i_cnt   = win_net_cnt[s] + 0
            ri_cnt  = win_real_ip_cnt[s] + 0
            sp_cnt  = win_spoof[s] + 0
            am_cnt  = win_amavis[s] + 0
            rb_cnt  = win_rbl[s] + 0
            lst_ts  = win_last_submit_ts[s] + 0

            if ((s in has_sasl) && (s in has_webmail)) orig = "SASL + Webmail/SOAP"
            else if (s in has_sasl) orig = "SASL (external client)"
            else if (s in has_pickup) orig = "Local pickup"
            else if (s in aux_ip_list) orig = "Webmail/SOAP"
            else orig = "Webmail/SOAP (local)"

            ips = (sender_ips[s] != "" ? sender_ips[s] : "webmail/local")
            if (ri_cnt > 5) {
                ips = ips " (+" (ri_cnt - 5) " more)"
            }
            tspan = (s in win_first_hms ? win_first_hms[s] " -> " win_last_hms[s] : "-")
            printf "%s|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%s|%d|%s|%s\n",
                s, m_cnt, r_cnt, ur_cnt, ud_cnt, s_cnt, d_cnt, b_cnt, i_cnt, ri_cnt, sp_cnt, am_cnt, rb_cnt, orig, lst_ts, ips, tspan
        }
    }
    ' | sort -t'|' -k3,3nr -k2,2nr > "$out_file"
}

# Inspect Postfix queue: separates Active+Deferred (triggers threshold) from Held ("!") messages
analyze_postfix_queue() {
    local out_file="$1"
    local summary_file="$2"
    : > "$out_file"
    echo "0|0|0|0" > "$summary_file"

    local pq_bin
    pq_bin=$(find_postqueue_bin)
    [[ -z "$pq_bin" ]] && return 0

    run_with_timeout "$POSTQUEUE_TIMEOUT_SECONDS" "$pq_bin" -p 2>/dev/null | awk -v sum_out="$summary_file" '
    BEGIN {
        total_q = 0; active_q = 0; hold_q = 0; def_q = 0
        cur_sender = ""
    }
    /^[0-9A-Za-z]+[*!]?[[:space:]]+[0-9]+[[:space:]]/ {
        qid_raw = $1
        sender = tolower($7)
        if (sender == "" || sender ~ /^from=/) next

        total_q++
        is_hold = 0
        if (index(qid_raw, "*") > 0) active_q++
        else if (index(qid_raw, "!") > 0) { hold_q++; is_hold = 1 }
        else def_q++

        if (sender != "mailer-daemon" && sender != "<>") {
            q_seen[sender] = 1
            if (is_hold) q_hold[sender]++
            else q_live[sender]++
            cur_sender = sender
        } else {
            cur_sender = ""
        }
        next
    }
    /^[[:space:]]+\(/ {
        if (cur_sender != "" && !(cur_sender in q_reason)) {
            r = $0
            sub(/^[[:space:]]+\(/, "", r)
            sub(/\)[[:space:]]*$/, "", r)
            gsub(/\|/, "/", r)
            if (length(r) > 90) r = substr(r, 1, 90) "..."
            q_reason[cur_sender] = r
        }
    }
    END {
        printf "%d|%d|%d|%d\n", total_q, active_q, def_q, hold_q > sum_out
        for (u in q_seen) {
            reason = (u in q_reason ? q_reason[u] : "Queued for delivery")
            printf "%s|%d|%d|%s\n", u, q_live[u]+0, q_hold[u]+0, reason
        }
    }
    ' | sort -t'|' -k2,2nr -k3,3nr > "$out_file"
}

append_reason() {
    local cur="$1"
    local item="$2"
    if [[ -z "$cur" ]]; then
        echo "$item"
    else
        echo "${cur}, ${item}"
    fi
}

# ==============================================================================
# MONITOR HEALTH CHECK, SELF-RBL BLACKLIST MONITOR & READ-ONLY SECURITY AUDIT
# Strictly READ-ONLY against Zimbra/Postfix/DNS/OS.
# ==============================================================================
check_monitor_health() {
    [[ "$HEALTH_CHECK_ENABLED" != "true" ]] && return 0

    local srv_host srv_ip now_ts now_str issue=""
    srv_host=$(get_server_hostname)
    srv_ip=$(get_server_ip)
    now_ts="${ZSM_NOW_EPOCH:-$(date +%s)}"
    now_str=$(date -d "@$now_ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date '+%Y-%m-%d %H:%M:%S')

    if [[ ! -f "$ZIMBRA_LOG_FILE" ]]; then
        issue="Zimbra log file not found: ${ZIMBRA_LOG_FILE}"
    elif [[ ! -r "$ZIMBRA_LOG_FILE" ]]; then
        issue="Zimbra log file is not readable: ${ZIMBRA_LOG_FILE}"
    elif [[ -z "$ZSM_NOW_EPOCH" || "${ZSM_FORCE_HEALTH_CHECK:-false}" == "true" ]]; then
        local mtime=0
        mtime=$(stat -c %Y "$ZIMBRA_LOG_FILE" 2>/dev/null || date -r "$ZIMBRA_LOG_FILE" +%s 2>/dev/null || echo "0")
        if [[ "$mtime" =~ ^[0-9]+$ ]] && (( mtime > 0 && now_ts > mtime )); then
            local age_mins=$(( (now_ts - mtime) / 60 ))
            if (( age_mins >= LOG_STALE_MINUTES )); then
                issue="Zimbra log (${ZIMBRA_LOG_FILE}) has not been updated for ${age_mins} minutes (limit: ${LOG_STALE_MINUTES}m). Check rsyslog/syslogd."
            fi
        fi
    fi

    [[ -z "$issue" ]] && return 0
    log_msg "WARN" "MONITOR HEALTH: ${issue}"

    if should_send_alert "__MONITOR_HEALTH__" "WARNING" "$HEALTH_ALERT_COOLDOWN_MINUTES"; then
        local tg_msg mail_body wh_json
        tg_msg=$(cat <<EOF
<b>[ZIMBRA MONITOR HEALTH WARNING]</b>
<code>==============================</code>
<b>Server     :</b> <code>$(html_escape "$srv_host")</code> (${srv_ip})
<b>Alert Time :</b> ${now_str}
<b>Issue      :</b> $(html_escape "$issue")
<code>==============================</code>
EOF
)
        mail_body=$(cat <<EOF
============================================================
         ZIMBRA MONITOR HEALTH WARNING
============================================================
Server     : ${srv_host} (${srv_ip})
Alert Time : ${now_str}
Issue      : ${issue}
============================================================
EOF
)
        local gjson
        gjson=$(printf '{"version":"%s","event":"monitor_health","severity":"WARNING","server":"%s","server_ip":"%s","alert_time":"%s","issue":"%s"}' \
            "$VERSION" "$(json_escape "$srv_host")" "$(json_escape "$srv_ip")" "$(json_escape "$now_str")" "$(json_escape "$issue")")
        wh_json=$(build_webhook_payload "$mail_body" "$gjson")
        log_json_event "$gjson"
        if dispatch_notifications "health_warn" "$tg_msg" "[Zimbra Monitor Health] ${srv_host}" "$mail_body" 0 "$wh_json"; then
            record_alert_state "__MONITOR_HEALTH__" "WARNING"
        fi
    fi
}

# Read-only DNSBL reputation check using system resolver.
# Treats 127.255.255.x (Spamhaus public resolver block) as QUERY_ERROR, never false blacklist.
run_rbl_check() {
    local mode="${1:-manual}" # "manual" (--check-rbl) or "auto" (periodic inside --run)
    load_config
    resolve_zimbra_settings

    local now_ts="${ZSM_NOW_EPOCH:-$(date +%s)}"
    local last_file="$STATE_DIR/rbl_last_check.ts"
    local state_file="$STATE_DIR/rbl_state.db"

    if [[ "$mode" == "auto" ]]; then
        [[ "$RBL_CHECK_ENABLED" != "true" ]] && return 0
        local interval_sec=$(( RBL_CHECK_INTERVAL_MINUTES * 60 ))
        if [[ -f "$last_file" ]]; then
            local last_ts
            last_ts=$(cat "$last_file" 2>/dev/null || echo "0")
            if [[ "$last_ts" =~ ^[0-9]+$ ]] && (( now_ts >= last_ts && now_ts - last_ts < interval_sec )); then
                return 0
            fi
        fi
        printf '%s\n' "$now_ts" > "$last_file" 2>/dev/null || true
    fi

    local srv_host srv_ip check_ips now_str
    srv_host=$(get_server_hostname)
    srv_ip=$(get_server_ip)
    now_str=$(date -d "@$now_ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date '+%Y-%m-%d %H:%M:%S')
    check_ips="${RBL_CHECK_IPS:-$srv_ip}"

    if [[ "$mode" == "manual" ]]; then
        echo "=============================================================================="
        echo " ZIMBRA SPAM MONITOR v${VERSION} - SELF-RBL REPUTATION CHECK (READ-ONLY DNS)"
        echo "=============================================================================="
        echo " Server : ${srv_host} | Check Time: ${now_str}"
        echo "------------------------------------------------------------------------------"
    fi

    local ip rbl any_listed=0
    for ip in $check_ips; do
        if ! is_valid_ipv4 "$ip" || is_private_ipv4 "$ip"; then
            [[ "$mode" == "manual" ]] && echo " [SKIP] ${ip} is not a public IPv4 address."
            continue
        fi
        local o1 o2 o3 o4 rev
        IFS='.' read -r o1 o2 o3 o4 <<< "$ip"
        rev="${o4}.${o3}.${o2}.${o1}"

        local listed_list="" err_list=""
        for rbl in $RBL_PROVIDERS; do
            local ans=""
            ans=$(dns_lookup_ipv4 "${rev}.${rbl}" || true)
            if [[ -z "$ans" ]]; then
                [[ "$mode" == "manual" ]] && printf " [CLEAN]       %-16s on %s\n" "$ip" "$rbl"
            elif [[ "$ans" =~ ^127\.255\. ]]; then
                err_list="${err_list:+${err_list}, }${rbl}(${ans})"
                [[ "$mode" == "manual" ]] && printf " [QUERY_ERROR] %-16s on %-26s -> %s (resolver blocked, NOT listed)\n" "$ip" "$rbl" "$ans"
                log_msg "WARN" "RBL query error for ${ip} on ${rbl}: ${ans} (public DNS resolver blocked)"
            elif [[ "$ans" =~ ^127\.0\.0\.([2-9]|1[0-9]|20)$ ]]; then
                listed_list="${listed_list:+${listed_list}, }${rbl}"
                any_listed=1
                [[ "$mode" == "manual" ]] && printf " [LISTED!]     %-16s on %-26s -> %s\n" "$ip" "$rbl" "$ans"
            else
                [[ "$mode" == "manual" ]] && printf " [INFO]        %-16s on %-26s -> %s (ignored code)\n" "$ip" "$rbl" "$ans"
            fi
        done

        # Compare against previous state to alert ONLY on state transitions (new listing or delisted)
        local prev_listed=""
        if [[ -f "$state_file" ]]; then
            prev_listed=$(awk -F'|' -v t="$ip" '$1 == t {v=$2} END {print v}' "$state_file" 2>/dev/null || true)
        fi
        if [[ "$listed_list" != "$prev_listed" ]]; then
            mkdir -p "$STATE_DIR" 2>/dev/null || true
            if [[ -f "$state_file" ]]; then
                awk -F'|' -v t="$ip" '$1 != t' "$state_file" > "${state_file}.tmp" 2>/dev/null || true
                mv -f "${state_file}.tmp" "$state_file"
            fi
            printf '%s|%s\n' "$ip" "$listed_list" >> "$state_file"

            if [[ "$mode" == "auto" ]]; then
                local rbl_sev rbl_title rbl_detail
                if [[ -n "$listed_list" ]]; then
                    rbl_sev="CRITICAL"
                    rbl_title="SERVER IP BLACKLISTED (RBL)"
                    rbl_detail="IP ${ip} is LISTED on: ${listed_list}"
                    log_msg "CRITICAL" "Self-RBL: ${rbl_detail}"
                else
                    rbl_sev="RECOVERY"
                    rbl_title="SERVER IP DELISTED (CLEAN)"
                    rbl_detail="IP ${ip} is now CLEAN on all checked RBLs (previously: ${prev_listed})"
                    log_msg "INFO" "Self-RBL: ${rbl_detail}"
                fi
                local tg_msg mail_body gjson wh_json
                tg_msg=$(cat <<EOF
<b>[ZIMBRA RBL ${rbl_sev}] ${rbl_title}</b>
<code>==============================</code>
<b>Server     :</b> <code>$(html_escape "$srv_host")</code> (${ip})
<b>Check Time :</b> ${now_str}
<b>Status     :</b> $(html_escape "$rbl_detail")
<code>==============================</code>
EOF
)
                mail_body=$(cat <<EOF
============================================================
         ZIMBRA RBL ${rbl_sev} - ${rbl_title}
============================================================
Server     : ${srv_host} (${ip})
Check Time : ${now_str}
Status     : ${rbl_detail}
============================================================
EOF
)
                gjson=$(printf '{"version":"%s","event":"self_rbl","severity":"%s","server":"%s","server_ip":"%s","alert_time":"%s","listed":"%s","previous":"%s"}' \
                    "$VERSION" "$rbl_sev" "$(json_escape "$srv_host")" "$(json_escape "$ip")" "$(json_escape "$now_str")" "$(json_escape "$listed_list")" "$(json_escape "$prev_listed")")
                wh_json=$(build_webhook_payload "$mail_body" "$gjson")
                log_json_event "$gjson"
                dispatch_notifications "rbl_${ip}" "$tg_msg" "[Zimbra RBL ${rbl_sev}] ${ip} on ${srv_host}" "$mail_body" 0 "$wh_json" || true
            fi
        fi
    done

    if [[ "$mode" == "manual" ]]; then
        echo "=============================================================================="
        return "$any_listed"
    fi
    return 0
}

# Strictly READ-ONLY Anti-Spam Security Posture Audit (NEVER executes or prints server mutation commands)
run_security_audit() {
    load_config
    resolve_zimbra_settings
    local srv_host srv_ip dom score=0 max_score=100
    srv_host=$(get_server_hostname)
    srv_ip=$(get_server_ip)
    dom="$RESOLVED_DEFAULT_DOMAIN"

    echo "=============================================================================="
    echo " ZIMBRA ANTI-SPAM POSTURE AUDIT v${VERSION} (100% READ-ONLY DIAGNOSTIC)"
    echo "=============================================================================="
    echo " Server : ${srv_host} (${srv_ip}) | Primary Domain: ${dom}"
    echo "------------------------------------------------------------------------------"

    # 1. DNS SPF Record (+15)
    local spf_txt=""
    spf_txt=$(dns_lookup_txt "$dom" | grep -i "v=spf1" | head -n 1 || true)
    if [[ -n "$spf_txt" ]]; then
        score=$(( score + 15 ))
        echo " [PASS +15] SPF DNS record found for ${dom}"
    else
        echo " [WARN  +0] SPF DNS record not detected for ${dom}."
        echo "            Advice: Publish an SPF TXT record authorizing your outbound mail IP."
    fi

    # 2. DNS DMARC Record (+15)
    local dmarc_txt=""
    dmarc_txt=$(dns_lookup_txt "_dmarc.${dom}" | grep -i "v=DMARC1" | head -n 1 || true)
    if [[ -n "$dmarc_txt" ]]; then
        score=$(( score + 15 ))
        echo " [PASS +15] DMARC DNS record found for _dmarc.${dom}"
    else
        echo " [WARN  +0] DMARC DNS record not detected for _dmarc.${dom}."
        echo "            Advice: Publish a DMARC TXT policy to reduce domain spoofing."
    fi

    # 3. Postfix Read-Only Posture (postconf -h ONLY, never mutates)
    local pc_bin
    pc_bin=$(find_postconf_bin)
    if [[ -n "$pc_bin" ]]; then
        local slm rus rl
        slm=$("$pc_bin" -h smtpd_sender_login_maps 2>/dev/null || true)
        rus=$("$pc_bin" -h smtpd_reject_unlisted_sender 2>/dev/null || true)
        rl=$("$pc_bin" -h smtpd_client_message_rate_limit 2>/dev/null || true)

        if [[ -n "$slm" ]]; then
            score=$(( score + 15 ))
            echo " [PASS +15] Postfix sender-login enforcement active (${slm})"
        else
            echo " [WARN  +0] Postfix smtpd_sender_login_maps is empty."
            echo "            Advice: Consider enabling authenticated sender-to-From mapping in Zimbra Admin."
        fi

        if [[ "$rus" == "yes" ]]; then
            score=$(( score + 10 ))
            echo " [PASS +10] Postfix rejects unlisted senders (smtpd_reject_unlisted_sender=yes)"
        else
            echo " [WARN  +0] Postfix smtpd_reject_unlisted_sender is '${rus:-no}'."
            echo "            Advice: Enable unlisted sender rejection to block forged internal addresses."
        fi

        if [[ -n "$rl" && "$rl" != "0" ]]; then
            score=$(( score + 10 ))
            echo " [PASS +10] Postfix message rate limit configured (${rl})"
        else
            echo " [INFO  +0] Postfix per-client message rate limit is unlimited (0)."
            echo "            Advice: For proactive rate limiting, consider enabling Zimbra cbpolicyd."
        fi
    else
        echo " [INFO  +0] Postfix postconf binary not found (skipped MTA read-only checks)."
    fi

    # 4. Monitor Self-Hardening Checks (+35 total)
    if [[ "$AUTO_LOCK_ON_CRITICAL" == "true" ]]; then
        score=$(( score + 10 ))
        echo " [PASS +10] Monitor Auto-Lock on CRITICAL is ENABLED"
    else
        echo " [WARN  +0] Monitor Auto-Lock on CRITICAL is DISABLED (alert only)."
    fi

    if [[ "$FLUSH_CACHE_ON_LOCK" == "true" ]]; then
        score=$(( score + 5 ))
        echo " [PASS  +5] Per-account auth cache flush on lock is ENABLED"
    else
        echo " [INFO  +0] Per-account auth cache flush on lock is DISABLED."
    fi

    if [[ "$TELEGRAM_ENABLED" == "true" && -n "$TELEGRAM_BOT_TOKEN" && -n "$TELEGRAM_CHAT_ID" ]] || [[ "$EMAIL_ENABLED" == "true" ]]; then
        score=$(( score + 10 ))
        echo " [PASS +10] Alert delivery channels configured (TG: ${TELEGRAM_ENABLED} | Mail: ${EMAIL_ENABLED} | Webhook: ${WEBHOOK_ENABLED})"
    else
        echo " [WARN  +0] No alert channel is fully configured."
    fi

    if [[ -r "$ZIMBRA_MAILBOX_LOG_FILE" && -r "$ZIMBRA_AUDIT_LOG_FILE" ]]; then
        score=$(( score + 10 ))
        echo " [PASS +10] Single-server mailbox.log & audit.log readable (real Webmail IP & brute-force active)"
    else
        echo " [INFO  +0] mailbox.log or audit.log not found on this host (running in MTA-log-only mode)."
    fi

    echo "------------------------------------------------------------------------------"
    echo " OVERALL ANTI-SPAM POSTURE SCORE: ${score} / ${max_score}"
    echo " Note: This audit is 100% read-only and made ZERO changes to Zimbra or the OS."
    echo "=============================================================================="
}

# Consolidated Brute-Force Summary (Top 10 IPs in 1 alert, cooldown 60m - never floods Telegram, never locks victims)
process_brute_force_alerts() {
    local aux_auth_file="$1"
    local sasl_fail_file="$2"
    local srv_host="$3"
    local srv_ip="$4"
    local now_str="$5"

    local tmp_bf
    tmp_bf=$(make_safe_tmp "zsm_bf")
    awk -F'|' -v thresh="$WARN_AUTH_FAIL_PER_IP" '
        $1 == "FAILIP" && $2 != "" { cnt[$2] += ($3 + 0) }
        END {
            for (ip in cnt) {
                if (cnt[ip] >= thresh) printf "%s|%d\n", ip, cnt[ip]
            }
        }
    ' "$aux_auth_file" "$sasl_fail_file" 2>/dev/null | sort -t'|' -k2,2nr > "$tmp_bf"

    if [[ ! -s "$tmp_bf" ]]; then
        rm -f "$tmp_bf"
        return 0
    fi

    local total_ips total_fails=0 top_lines="" top_html="" shown=0
    total_ips=$(wc -l < "$tmp_bf" | tr -d ' ')
    local bip bcnt
    while IFS='|' read -r bip bcnt; do
        [[ -z "$bip" ]] && continue
        total_fails=$(( total_fails + bcnt ))
        if (( shown < 10 )); then
            top_lines="${top_lines}  - ${bip}: ${bcnt} failed logins"$'\n'
            top_html="${top_html}  <code>$(html_escape "$bip")</code>: <b>${bcnt}</b> fails"$'\n'
            shown=$(( shown + 1 ))
        fi
    done < "$tmp_bf"

    if should_send_alert "__BRUTE_FORCE_SUMMARY__" "WARNING" "$AUTH_ALERT_COOLDOWN_MINUTES"; then
        while IFS='|' read -r bip bcnt; do
            [[ -z "$bip" ]] && continue
            record_attacker_ip "$bip" "auth-bruteforce" "Failed logins (${bcnt} in ${LOOKBACK_MINUTES}m)"
        done < "$tmp_bf"
        log_msg "WARNING" "Auth brute-force detected: ${total_ips} attacking IP(s), ${total_fails} failed logins in ${LOOKBACK_MINUTES}m"
        local tg_msg mail_body gjson wh_json
        tg_msg=$(cat <<EOF
<b>[ZIMBRA AUTH BRUTE-FORCE WARNING]</b>
<code>==============================</code>
<b>Server       :</b> <code>$(html_escape "$srv_host")</code> (${srv_ip})
<b>Alert Time   :</b> ${now_str}
<b>Window       :</b> Last ${LOOKBACK_MINUTES} mins
<b>Attacking IPs:</b> <b>${total_ips}</b> IP(s) | Total Fails: <b>${total_fails}</b>
<b>Action Taken :</b> Alert only (victim accounts NOT locked to prevent DoS)

<b>TOP ATTACKING IPs (threshold &gt;= ${WARN_AUTH_FAIL_PER_IP})</b>
${top_html}<code>==============================</code>
EOF
)
        mail_body=$(cat <<EOF
============================================================
         ZIMBRA AUTH BRUTE-FORCE WARNING
============================================================
Server        : ${srv_host} (${srv_ip})
Alert Time    : ${now_str}
Window        : Last ${LOOKBACK_MINUTES} mins
Attacking IPs : ${total_ips} IP(s) | Total Fails: ${total_fails}
Action Taken  : Alert only (victim accounts NOT locked to prevent DoS)
Logged To     : ${STATE_DIR}/attacker_ips.log

TOP ATTACKING IPs (threshold >= ${WARN_AUTH_FAIL_PER_IP}):
${top_lines}============================================================
EOF
)
        gjson=$(printf '{"version":"%s","event":"brute_force","severity":"WARNING","server":"%s","server_ip":"%s","alert_time":"%s","attacking_ips":%d,"total_fails":%d}' \
            "$VERSION" "$(json_escape "$srv_host")" "$(json_escape "$srv_ip")" "$(json_escape "$now_str")" "$total_ips" "$total_fails")
        wh_json=$(build_webhook_payload "$mail_body" "$gjson")
        log_json_event "$gjson"
        if dispatch_notifications "brute_force" "$tg_msg" "[Zimbra Auth Brute-Force] ${total_ips} IP(s) / ${total_fails} fails on ${srv_host}" "$mail_body" 0 "$wh_json"; then
            record_alert_state "__BRUTE_FORCE_SUMMARY__" "WARNING"
        fi
    fi
    rm -f "$tmp_bf"
}

