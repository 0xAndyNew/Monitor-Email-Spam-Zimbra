# Injection-safe & delimiter-safe config writer (handles |, &, $, ", \, `)
update_cfg_var() {
    local key="$1"
    local raw_val="$2"
    ensure_config_file_exists

    # Strip CR/LF and escape \, ", $, and ` for safe double-quoted Bash assignment
    local esc_val="$raw_val"
    esc_val="${esc_val//$'\r'/}"
    esc_val="${esc_val//$'\n'/}"
    esc_val="${esc_val//\\/\\\\}"
    esc_val="${esc_val//\"/\\\"}"
    esc_val="${esc_val//\$/\\\$}"
    esc_val="${esc_val//\`/\\\`}"

    local tmp_out
    tmp_out=$(make_safe_tmp "zsm_cfgw")
    ZSM_CFG_KEY="$key" ZSM_CFG_VAL="$esc_val" awk '
        BEGIN {
            k = ENVIRON["ZSM_CFG_KEY"]
            v = ENVIRON["ZSM_CFG_VAL"]
            updated = 0
            prefix = k "="
            plen = length(prefix)
        }
        substr($0, 1, plen) == prefix {
            if (!updated) {
                print k "=\"" v "\""
                updated = 1
            }
            next
        }
        { print }
        END {
            if (!updated) {
                print k "=\"" v "\""
            }
        }
    ' "$CONFIG_FILE" > "$tmp_out"
    cat "$tmp_out" > "$CONFIG_FILE"
    rm -f "$tmp_out"
    load_config
}

update_cfg_num() {
    local key="$1"
    local val="$2"
    [[ ! "$val" =~ ^-?[0-9]+(\.[0-9]+)?$ ]] && return 1
    ensure_config_file_exists

    local tmp_out
    tmp_out=$(make_safe_tmp "zsm_cfgn")
    awk -v k="$key" -v v="$val" '
        BEGIN { updated = 0; prefix = k "="; plen = length(prefix) }
        substr($0, 1, plen) == prefix {
            if (!updated) {
                print k "=" v
                updated = 1
            }
            next
        }
        { print }
        END {
            if (!updated) {
                print k "=" v
            }
        }
    ' "$CONFIG_FILE" > "$tmp_out"
    cat "$tmp_out" > "$CONFIG_FILE"
    rm -f "$tmp_out"
    load_config
}

