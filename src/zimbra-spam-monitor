apply_email_volume_limits() {
    local w_rcpt="$1"
    local c_rcpt="$2"
    local w_uniq=$(( (w_rcpt * 80) / 100 ))
    local c_uniq=$(( (c_rcpt * 80) / 100 ))
    local w_msgs=$(( (w_rcpt * 60) / 100 ))
    local c_msgs=$(( (c_rcpt * 75) / 100 ))
    (( w_uniq < 10 )) && w_uniq=10
    (( c_uniq < 20 )) && c_uniq=20
    (( w_msgs < 10 )) && w_msgs=10
    (( c_msgs < 20 )) && c_msgs=20

    update_cfg_num "WARN_RECIPIENTS" "$w_rcpt"
    update_cfg_num "CRIT_RECIPIENTS" "$c_rcpt"
    update_cfg_num "WARN_UNIQUE_RECIPIENTS" "$w_uniq"
    update_cfg_num "CRIT_UNIQUE_RECIPIENTS" "$c_uniq"
    update_cfg_num "WARN_MESSAGES_SENT" "$w_msgs"
    update_cfg_num "CRIT_MESSAGES_SENT" "$c_msgs"
}

