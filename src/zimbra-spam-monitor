record_attacker_ip() {
    local ip="$1"
    local acct="$2"
    local reason="$3"
    [[ -z "$ip" || "$ip" == "webmail/local" || "$ip" == "queued/unknown" || "$ip" == "127.0.0.1" || "$ip" == "::1" ]] && return 0
    local now_ts ts_str
    now_ts="${ZSM_NOW_EPOCH:-$(date +%s)}"
    ts_str=$(date -d "@$now_ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date '+%Y-%m-%d %H:%M:%S')
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    printf '%s|%s|%s|%s\n' "$ts_str" "$ip" "$acct" "$reason" >> "$STATE_DIR/attacker_ips.log" 2>/dev/null || true
}

trim_attacker_ip_log() {
    local ip_log="$STATE_DIR/attacker_ips.log"
    [[ ! -f "$ip_log" ]] && return 0
    local lines=0
    lines=$(wc -l < "$ip_log" 2>/dev/null | tr -d ' ' || echo "0")
    if [[ "$lines" =~ ^[0-9]+$ ]] && (( lines > 6000 )); then
        local tmp_trim
        tmp_trim=$(make_safe_tmp "zsm_iptrim")
        tail -n 5000 "$ip_log" > "$tmp_trim" 2>/dev/null && mv -f "$tmp_trim" "$ip_log" 2>/dev/null || rm -f "$tmp_trim"
    fi
}

read_localconfig_key() {
    local key_name="$1"
    [[ ! -f "$ZSM_LOCALCONFIG_FILE" ]] && return 0
    awk -F'[<>]' -v k="$key_name" '
        index($0, "name=\"" k "\"") > 0 {
            if (getline > 0 && $2 == "value") { print $3; exit }
        }
    ' "$ZSM_LOCALCONFIG_FILE" 2>/dev/null | head -n 1
}

get_server_hostname() {
    if [[ -n "$ZSM_HOSTNAME" ]]; then
        echo "$ZSM_HOSTNAME"
        return
    fi
    local hn=""
    hn=$(read_localconfig_key "zimbra_server_hostname")
    if [[ -z "$hn" ]]; then
        hn=$("$ZSM_HOSTNAME_CMD" -f 2>/dev/null || "$ZSM_HOSTNAME_CMD" 2>/dev/null || echo "zimbra-server")
    fi
    echo "$hn"
}

is_valid_ipv4() {
    [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]
}

is_private_ipv4() {
    local ip="$1"
    [[ "$ip" =~ ^10\. ]] || \
    [[ "$ip" =~ ^127\. ]] || \
    [[ "$ip" =~ ^192\.168\. ]] || \
    [[ "$ip" =~ ^169\.254\. ]] || \
    [[ "$ip" =~ ^172\.(1[6-9]|2[0-9]|3[0-1])\. ]]
}

# Read-only DNS A lookup (bypasses /etc/hosts) using dig, host, or nslookup
dns_lookup_ipv4() {
    local domain="$1"
    local resolver="${2:-}"
    local ip=""

    if command -v "$ZSM_DIG_CMD" >/dev/null 2>&1; then
        if [[ -n "$resolver" ]]; then
            ip=$("$ZSM_DIG_CMD" +short +time=2 +tries=1 "@${resolver}" A "$domain" 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -n 1)
        else
            ip=$("$ZSM_DIG_CMD" +short +time=2 +tries=1 A "$domain" 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -n 1)
        fi
        if is_valid_ipv4 "$ip"; then
            echo "$ip"
            return 0
        fi
    fi

    if command -v "$ZSM_HOST_CMD" >/dev/null 2>&1; then
        if [[ -n "$resolver" ]]; then
            ip=$("$ZSM_HOST_CMD" -W 2 -t A "$domain" "$resolver" 2>/dev/null | awk '/has address/ {print $4; exit}')
        else
            ip=$("$ZSM_HOST_CMD" -W 2 -t A "$domain" 2>/dev/null | awk '/has address/ {print $4; exit}')
        fi
        if is_valid_ipv4 "$ip"; then
            echo "$ip"
            return 0
        fi
    fi

    if command -v "$ZSM_NSLOOKUP_CMD" >/dev/null 2>&1; then
        if [[ -n "$resolver" ]]; then
            ip=$("$ZSM_NSLOOKUP_CMD" -timeout=2 "$domain" "$resolver" 2>/dev/null | awk '/^Name:/{in_ans=1} in_ans && /^Address:/{ip=$2; sub(/#.*/, "", ip); if (ip ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {print ip; exit}}')
        else
            ip=$("$ZSM_NSLOOKUP_CMD" -timeout=2 "$domain" 2>/dev/null | awk '/^Name:/{in_ans=1} in_ans && /^Address:/{ip=$2; sub(/#.*/, "", ip); if (ip ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {print ip; exit}}')
        fi
        if is_valid_ipv4 "$ip"; then
            echo "$ip"
            return 0
        fi
    fi

    return 1
}

dns_lookup_txt() {
    local domain="$1"
    if command -v "$ZSM_DIG_CMD" >/dev/null 2>&1; then
        "$ZSM_DIG_CMD" +short +time=2 +tries=1 TXT "$domain" 2>/dev/null | tr -d '"'
        return 0
    fi
    if command -v "$ZSM_HOST_CMD" >/dev/null 2>&1; then
        "$ZSM_HOST_CMD" -W 2 -t TXT "$domain" 2>/dev/null
        return 0
    fi
    return 1
}

get_server_ip() {
    if [[ -n "$ZSM_SERVER_IP" ]]; then
        echo "$ZSM_SERVER_IP"
        return
    fi
    if [[ -n "${SERVER_IP:-}" && "$SERVER_IP" != "auto" ]]; then
        echo "$SERVER_IP"
        return
    fi
    if [[ -n "${SERVER_PUBLIC_IP:-}" && "$SERVER_PUBLIC_IP" != "auto" ]]; then
        echo "$SERVER_PUBLIC_IP"
        return
    fi

    local srv_host cache_key now_ts
    srv_host=$(get_server_hostname)
    cache_key="${ZSM_SERVER_IP}|${SERVER_IP:-auto}|${srv_host}|${ZSM_DIG_CMD}|${ZSM_HOST_CMD}|${ZSM_NSLOOKUP_CMD}"
    if [[ -n "${_CACHED_SERVER_IP:-}" && "${_CACHED_SERVER_IP_KEY:-}" == "$cache_key" ]]; then
        echo "$_CACHED_SERVER_IP"
        return
    fi

    now_ts="${ZSM_NOW_EPOCH:-$(date +%s)}"
    local ip_cache_file="$STATE_DIR/server_ip.cache"
    if [[ -f "$ip_cache_file" ]]; then
        local c_key c_ip c_ts
        IFS='|' read -r c_key c_ip c_ts < "$ip_cache_file" 2>/dev/null || true
        if [[ "$c_key" == "$cache_key" ]] && is_valid_ipv4 "$c_ip" && [[ "$c_ts" =~ ^[0-9]+$ ]] && (( now_ts >= c_ts && now_ts - c_ts < 86400 )); then
            echo "$c_ip"
            return
        fi
    fi

    local ip=""
    local pub_ip=""
    if [[ -n "$srv_host" && "$srv_host" != "localhost" ]]; then
        ip=$(dns_lookup_ipv4 "$srv_host" || true)
        # If local DNS returns a private/NAT IP (e.g. Split-DNS) or fails, query public DNS
        if [[ -z "$ip" ]] || is_private_ipv4 "$ip"; then
            local resolver
            for resolver in 1.1.1.1 8.8.8.8; do
                pub_ip=$(dns_lookup_ipv4 "$srv_host" "$resolver" || true)
                if is_valid_ipv4 "$pub_ip" && ! is_private_ipv4 "$pub_ip"; then
                    ip="$pub_ip"
                    break
                fi
            done
        fi
        if [[ -z "$ip" ]] && command -v getent >/dev/null 2>&1; then
            ip=$(getent ahostsv4 "$srv_host" 2>/dev/null | awk 'NR==1 {print $1}')
        fi
    fi

    if [[ -z "$ip" ]]; then
        ip=$("$ZSM_HOSTNAME_CMD" -I 2>/dev/null | awk '{print $1}')
    fi
    if [[ -z "$ip" ]]; then
        ip="127.0.0.1"
    fi

    if is_valid_ipv4 "$ip" && [[ "$ip" != "127.0.0.1" ]]; then
        mkdir -p "$STATE_DIR" 2>/dev/null || true
        printf '%s|%s|%s\n' "$cache_key" "$ip" "$now_ts" > "$ip_cache_file" 2>/dev/null || true
    fi

    echo "$ip"
}

get_local_ips() {
    local lip=""
    local dns_ip=""
    lip=$("$ZSM_HOSTNAME_CMD" -I 2>/dev/null || true)
    dns_ip=$(get_server_ip)
    echo "${lip} ${dns_ip} ${TRUSTED_SUBMISSION_IPS}"
}

# Read-only Multi-Domain discovery via native ldapsearch (zero JVM) + 24h cache
discover_zimbra_domains() {
    [[ "$AUTO_DISCOVER_ZIMBRA_DOMAINS" != "true" ]] && return 0

    local now_ts="${ZSM_NOW_EPOCH:-$(date +%s)}"
    local dom_cache="$STATE_DIR/domains.cache"
    if [[ -f "$dom_cache" ]]; then
        local c_ts c_doms
        IFS='|' read -r c_ts c_doms < "$dom_cache" 2>/dev/null || true
        if [[ "$c_ts" =~ ^[0-9]+$ && -n "$c_doms" ]] && (( now_ts >= c_ts && now_ts - c_ts < 86400 )); then
            echo "$c_doms"
            return 0
        fi
    fi

    local discovered=""
    local ldap_bin=""
    if [[ -n "$ZSM_LDAPSEARCH_CMD" ]]; then
        ldap_bin="$ZSM_LDAPSEARCH_CMD"
    else
        for p in /opt/zimbra/common/bin/ldapsearch /opt/zimbra/openldap/bin/ldapsearch /usr/bin/ldapsearch; do
            [[ -x "$p" ]] && ldap_bin="$p" && break
        done
    fi

    if [[ -n "$ldap_bin" ]]; then
        if [[ -n "$ZSM_LDAPSEARCH_CMD" ]]; then
            discovered=$(run_with_timeout 15 "$ldap_bin" -x "(objectClass=zimbraDomain)" zimbraDomainName 2>/dev/null | \
                awk '/^zimbraDomainName:/ {print tolower($2)}' | sort -u | tr '\n' ' ')
        elif [[ -f "$ZSM_LOCALCONFIG_FILE" ]]; then
            local ldap_url ldap_dn ldap_pw
            ldap_url=$(read_localconfig_key "ldap_url" | awk '{print $1}')
            ldap_dn=$(read_localconfig_key "zimbra_ldap_userdn")
            ldap_pw=$(read_localconfig_key "zimbra_ldap_password")
            if [[ -n "$ldap_url" && -n "$ldap_dn" && -n "$ldap_pw" ]]; then
                local tmp_pw
                tmp_pw=$(make_safe_tmp "zsm_ldappw")
                printf '%s' "$ldap_pw" > "$tmp_pw"
                discovered=$(run_with_timeout 15 "$ldap_bin" -x -LLL -H "$ldap_url" -D "$ldap_dn" -y "$tmp_pw" \
                    -b "" "(objectClass=zimbraDomain)" zimbraDomainName 2>/dev/null | \
                    awk '/^zimbraDomainName:/ {print tolower($2)}' | sort -u | tr '\n' ' ')
                rm -f "$tmp_pw"
            fi
        fi
    fi

    # Read-only fallback to zmprov gad (with strict 60s timeout) only if ldapsearch yielded nothing
    if [[ -z "${discovered// /}" && -z "$ZSM_ZMPROV_CMD" && -x /opt/zimbra/bin/zmprov ]]; then
        discovered=$(run_with_timeout 60 su - zimbra -c '/opt/zimbra/bin/zmprov gad' 2>/dev/null | \
            awk '/^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$/ {print tolower($1)}' | sort -u | tr '\n' ' ')
    fi

    discovered=$(echo "$discovered" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    if [[ -n "$discovered" ]]; then
        mkdir -p "$STATE_DIR" 2>/dev/null || true
        printf '%s|%s\n' "$now_ts" "$discovered" > "$dom_cache" 2>/dev/null || true
        echo "$discovered"
    fi
}

# Fast auto-detection of Zimbra localconfig XML without spawning JVM
resolve_zimbra_settings() {
    local srv_host
    srv_host=$(get_server_hostname)
    local ip_cache_key="${ZSM_SERVER_IP}|${SERVER_IP:-auto}|${srv_host}|${ZSM_DIG_CMD}|${ZSM_HOST_CMD}|${ZSM_NSLOOKUP_CMD}"
    if [[ "${_CACHED_SERVER_IP_KEY:-}" != "$ip_cache_key" ]]; then
        _CACHED_SERVER_IP=""
        _CACHED_SERVER_IP=$(get_server_ip)
        _CACHED_SERVER_IP_KEY="$ip_cache_key"
    fi
    if [[ "$srv_host" == *.*.* ]]; then
        RESOLVED_DEFAULT_DOMAIN="${srv_host#*.}"
    else
        RESOLVED_DEFAULT_DOMAIN="$srv_host"
    fi

    local xml_dest=""
    local xml_src=""
    xml_dest=$(read_localconfig_key "smtp_destination")
    xml_src=$(read_localconfig_key "smtp_source")

    if [[ "$ALERT_EMAIL_TO" == "auto" || -z "$ALERT_EMAIL_TO" ]]; then
        if [[ -n "$xml_dest" ]]; then
            RESOLVED_EMAIL_TO="$xml_dest"
        else
            RESOLVED_EMAIL_TO="admin@${RESOLVED_DEFAULT_DOMAIN}"
        fi
    else
        RESOLVED_EMAIL_TO="$ALERT_EMAIL_TO"
    fi

    if [[ "$ALERT_EMAIL_FROM" == "auto" || -z "$ALERT_EMAIL_FROM" ]]; then
        if [[ -n "$xml_src" ]]; then
            RESOLVED_EMAIL_FROM="$xml_src"
        else
            RESOLVED_EMAIL_FROM="zimbra-monitor@${RESOLVED_DEFAULT_DOMAIN}"
        fi
    else
        RESOLVED_EMAIL_FROM="$ALERT_EMAIL_FROM"
    fi

    if [[ "$INTERNAL_DOMAINS" == "auto" || -z "$INTERNAL_DOMAINS" ]]; then
        RESOLVED_INTERNAL_DOMAINS="$RESOLVED_DEFAULT_DOMAIN $srv_host"
        if [[ -n "$xml_dest" && "$xml_dest" == *@* ]]; then
            RESOLVED_INTERNAL_DOMAINS="$RESOLVED_INTERNAL_DOMAINS ${xml_dest#*@}"
        fi
        local multi_doms=""
        multi_doms=$(discover_zimbra_domains || true)
        if [[ -n "$multi_doms" ]]; then
            RESOLVED_INTERNAL_DOMAINS="$RESOLVED_INTERNAL_DOMAINS $multi_doms"
        fi
    else
        RESOLVED_INTERNAL_DOMAINS="$INTERNAL_DOMAINS"
    fi
}

