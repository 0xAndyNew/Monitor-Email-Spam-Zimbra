            mail_rc=1
        fi
    fi

    return $(( tg_rc + mail_rc ))
}

unlock_account() {
    local target="$1"
    if [[ -z "$target" ]]; then
        echo "Sử dụng: zimbra-spam-monitor --unlock <email@domain.com>"
        return 1
    fi
    load_config
    echo "Đang mở khóa tài khoản ${target}..."
    if [[ -n "$ZSM_ZMPROV_CMD" ]]; then
        $ZSM_ZMPROV_CMD ma "$target" zimbraAccountStatus active
    elif [[ -x /opt/zimbra/bin/zmprov ]]; then
        su - zimbra -c "/opt/zimbra/bin/zmprov ma '$target' zimbraAccountStatus active"
    else
        echo "Không tìm thấy /opt/zimbra/bin/zmprov trên máy chủ."
        return 1
    fi
    clear_alert_state "$target"
    log_msg "INFO" "Quản trị viên đã mở khóa tài khoản $target và xóa trạng thái Cooldown"
    echo "[OK] Tài khoản ${target} đã được chuyển về trạng thái 'active' và xóa Cooldown."
}

# ==============================================================================
# QUẢN LÝ CHU KỲ CRON (/etc/cron.d/zimbra-spam-monitor)
# ==============================================================================
get_current_cron_interval() {
    if [[ ! -f "$CRON_FILE" ]]; then
        echo "Chưa tạo"
        return
    fi
    if grep -q "^#.*zimbra-spam-monitor" "$CRON_FILE" 2>/dev/null; then
        echo "Đang tạm dừng"
        return
    fi
    local spec
    spec=$(awk '/zimbra-spam-monitor/ && !/^#/ {print $1}' "$CRON_FILE" 2>/dev/null | head -n 1)
    case "$spec" in
        "*"|"*/1") echo "1 phút/lần" ;;
        "*/2")     echo "2 phút/lần" ;;
        "*/5")     echo "5 phút/lần" ;;
        "*/10")    echo "10 phút/lần" ;;
        "*/15")    echo "15 phút/lần" ;;
        "*/30")    echo "30 phút/lần" ;;
        *)         echo "${spec:-5 phút/lần}" ;;
    esac
}

set_cron_interval_minutes() {
    local mins="$1"
    local cron_dir
    cron_dir=$(dirname "$CRON_FILE")
    mkdir -p "$cron_dir" 2>/dev/null || true

    if [[ "$mins" == "disable" ]]; then
        cat <<EOF > "$CRON_FILE"
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin:/opt/zimbra/common/sbin:/opt/zimbra/bin
# */5 * * * * root /usr/bin/zimbra-spam-monitor --run >/dev/null 2>&1
EOF
        log_msg "INFO" "Đã tạm dừng lịch quét tự động trong $CRON_FILE"
        return 0
    fi

    cat <<EOF > "$CRON_FILE"
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin:/opt/zimbra/common/sbin:/opt/zimbra/bin
*/${mins} * * * * root /usr/bin/zimbra-spam-monitor --run >/dev/null 2>&1
EOF
    chmod 0644 "$CRON_FILE" 2>/dev/null || true
    log_msg "INFO" "Đã cập nhật chu kỳ quét Cron thành ${mins} phút/lần"
}

# ==============================================================================
# GIAO DIỆN ĐIỀU KHIỂN TƯƠNG TÁC (HỘP THOẠI TUI & MENU CHỌN BẰNG SỐ)
# ==============================================================================
detect_tui_bin() {
    if [[ "$ZSM_UI_MODE" == "text" ]]; then
        echo ""
        return
    fi
    if [[ -t 0 && -t 1 ]]; then
        if command -v whiptail >/dev/null 2>&1; then
            echo "whiptail"
            return
        elif command -v dialog >/dev/null 2>&1; then
            echo "dialog"
            return
        fi
    fi
    echo ""
}

# Hàm hiển thị Menu chọn tổng quát (Hỗ trợ cả hộp thoại whiptail/dialog dùng phím mũi tên Lên/Xuống VÀ Menu chọn số)
ui_select_menu() {
    local title="$1"
    local prompt="$2"
    shift 2
    local items=("$@") # Các cặp: tag1 desc1 tag2 desc2 ...

    local tui_bin
    tui_bin=$(detect_tui_bin)

    if [[ -n "$tui_bin" ]]; then
        local choice
        choice=$("$tui_bin" --title "$title" --backtitle "Zimbra Outbound Spam Monitor v${VERSION} - $(get_server_hostname)" \
            --menu "$prompt\n(Dùng phím Mũi tên Lên/Xuống để di chuyển, Enter để chọn)" 22 78 12 \
            "${items[@]}" 3>&1 1>&2 2>&3) || {
            echo "0"
            return
        }
        echo "$choice"
        return
    fi

    # Fallback: Giao diện Menu chọn bằng số có màu sắc rõ ràng (In ra >&2 để hiển thị trực tiếp lên màn hình)
    echo "" >&2
    echo -e "${C_CYAN}==============================================================================${C_RESET}" >&2
    echo -e " ${C_BOLD}${title}${C_RESET}" >&2
    echo -e "${C_CYAN}------------------------------------------------------------------------------${C_RESET}" >&2
    echo -e " ${prompt}" >&2
    echo -e "${C_CYAN}------------------------------------------------------------------------------${C_RESET}" >&2

    local i=0
    local total=${#items[@]}
    while (( i < total )); do
        local tag="${items[$i]}"
        local desc="${items[$((i+1))]}"
        printf "  ${C_YELLOW}[%-2s]${C_RESET} %s\n" "$tag" "$desc" >&2
        i=$(( i + 2 ))
    done
    echo -e "${C_CYAN}==============================================================================${C_RESET}" >&2
    local sel=""
    if ! read -r -p " -> Nhập số mục muốn chọn rồi nhấn Enter [0 để quay lại/thoát]: " sel; then
        echo "0"
        return
    fi
    echo "${sel:-0}"
}

ui_input_box() {
    local title="$1"
    local prompt="$2"
    local default_val="$3"

    local tui_bin
    tui_bin=$(detect_tui_bin)

    if [[ -n "$tui_bin" ]]; then
        local val
        if val=$("$tui_bin" --title "$title" --backtitle "Zimbra Outbound Spam Monitor v${VERSION}" \
            --inputbox "$prompt" 12 72 "$default_val" 3>&1 1>&2 2>&3); then
            echo "$val"
        else
            echo "$default_val"
        fi
        return
    fi

    echo "" >&2
    echo -e "${C_BOLD}[${title}]${C_RESET} ${prompt}" >&2
    local val=""
    if ! read -r -p " -> Nhập giá trị mới (Nhấn Enter để giữ nguyên [${default_val}]): " val; then
        echo "$default_val"
        return
    fi
    if [[ -z "$val" ]]; then
        echo "$default_val"
    else
        echo "$val"
    fi
}

ui_msg_box() {
    local title="$1"
    local text="$2"

    local tui_bin
    tui_bin=$(detect_tui_bin)

    if [[ -n "$tui_bin" ]]; then
        "$tui_bin" --title "$title" --backtitle "Zimbra Outbound Spam Monitor v${VERSION}" \
            --msgbox "$text" 18 76
        return
    fi

    echo "" >&2
    echo -e "${C_GREEN}------------------------------------------------------------------------------${C_RESET}" >&2
    echo -e " ${C_BOLD}${title}${C_RESET}" >&2
    echo -e "${C_GREEN}------------------------------------------------------------------------------${C_RESET}" >&2
    echo -e "$text" >&2
    echo -e "${C_GREEN}------------------------------------------------------------------------------${C_RESET}" >&2
    read -r -p " Nhấn phím Enter để tiếp tục..." _ || true
}

