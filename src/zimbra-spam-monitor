submenu_whitelist() {
    while true; do
        load_config
        mkdir -p "$(dirname "$WHITELIST_FILE")" 2>/dev/null || true
        touch "$WHITELIST_FILE" 2>/dev/null || true

        local count_wl
        count_wl=$(grep -v '^[[:space:]]*#' "$WHITELIST_FILE" 2>/dev/null | grep -c '[^[:space:]]' || true)

        local choice
        choice=$(ui_select_menu "WHITELIST (${count_wl} ENTRIES)" \
            "Trusted senders & domains bypass spam checks:" \
            "1" "View Whitelist" \
            "2" "Add Email or @domain.com" \
            "3" "Remove from Whitelist" \
            "0" "Back")

        case "$choice" in
            1)
                local list_txt
                list_txt=$(grep -v '^[[:space:]]*#' "$WHITELIST_FILE" 2>/dev/null | sed '/^[[:space:]]*$/d' || true)
                [[ -z "$list_txt" ]] && list_txt="(Whitelist is empty)"
                ui_msg_box "WHITELIST ENTRIES" "$list_txt"
                ;;
            2)
                local new_wl
                new_wl=$(ui_input_box "ADD TO WHITELIST" "Enter email (marketing@domain.com) or domain (@domain.com):" "")
                if [[ -n "$new_wl" ]]; then
                    echo "$new_wl" >> "$WHITELIST_FILE"
                    ui_msg_box "WHITELIST UPDATED" "Added '${new_wl}' to whitelist."
                fi
                ;;
            3)
                local wl_items=()
                local wl_map=()
                local idx=1
                while IFS= read -r line; do
                    local clean
                    clean=$(echo "$line" | tr -d '\r' | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//')
                    [[ -z "$clean" ]] && continue
                    wl_items+=("$idx" "$clean")
                    wl_map[$idx]="$clean"
                    idx=$(( idx + 1 ))
                done < "$WHITELIST_FILE"

                if (( idx == 1 )); then
                    ui_msg_box "WHITELIST EMPTY" "There are no entries to remove."
                else
                    wl_items+=("0" "Back")
                    local del_idx
                    del_idx=$(ui_select_menu "REMOVE WHITELIST ENTRY" \
                        "Select entry to remove:" \
                        "${wl_items[@]}")
                    if [[ -n "$del_idx" && "$del_idx" != "0" && -n "${wl_map[$del_idx]:-}" ]]; then
                        local target_del="${wl_map[$del_idx]}"
                        grep -v -F "$target_del" "$WHITELIST_FILE" > "${WHITELIST_FILE}.tmp" 2>/dev/null || true
                        mv -f "${WHITELIST_FILE}.tmp" "$WHITELIST_FILE"
                        ui_msg_box "REMOVED" "Removed '${target_del}' from whitelist."
                    fi
                fi
                ;;
            0|"")
                break
                ;;
        esac
    done
}

