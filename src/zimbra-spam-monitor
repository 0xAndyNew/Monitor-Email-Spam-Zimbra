update_cfg_var() {
    local key="$1"
    local val="$2"
    ensure_config_file_exists
    if grep -q "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=\"${val}\"|" "$CONFIG_FILE"
    else
        echo "${key}=\"${val}\"" >> "$CONFIG_FILE"
    fi
    load_config
}

update_cfg_num() {
    local key="$1"
    local val="$2"
    ensure_config_file_exists
    if grep -q "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${val}|" "$CONFIG_FILE"
    else
        echo "${key}=${val}" >> "$CONFIG_FILE"
    fi
    load_config
}

log_msg() {
    local level="$1"
    shift
    local msg="$*"
    local ts
    ts=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$ts] [$level] $msg" >> "$MONITOR_LOG_FILE" 2>/dev/null || true
}

get_server_hostname() {
    if [[ -n "$ZSM_HOSTNAME" ]]; then
        echo "$ZSM_HOSTNAME"
        return
    fi
    local hn=""
    if [[ -f /opt/zimbra/conf/localconfig.xml ]]; then
        hn=$(awk -F'[<>]' '/name="zimbra_server_hostname"/{getline; if ($2 == "value") print $3}' /opt/zimbra/conf/localconfig.xml 2>/dev/null | head -n 1)
    fi
    if [[ -z "$hn" ]]; then
        hn=$(hostname -f 2>/dev/null || hostname 2>/dev/null || echo "zimbra-server")
    fi
    echo "$hn"
}

get_server_ip() {
    local ip=""
    ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    if [[ -z "$ip" ]]; then
        ip="127.0.0.1"
    fi
    echo "$ip"
}

# Fast auto-detection of Zimbra localconfig XML without spawning JVM
resolve_zimbra_settings() {
    local srv_host
    srv_host=$(get_server_hostname)
    if [[ "$srv_host" == *.*.* ]]; then
        RESOLVED_DEFAULT_DOMAIN="${srv_host#*.}"
    else
        RESOLVED_DEFAULT_DOMAIN="$srv_host"
    fi

    local xml_dest=""
    local xml_src=""
    if [[ -f /opt/zimbra/conf/localconfig.xml ]]; then
        xml_dest=$(awk -F'[<>]' '/name="smtp_destination"/{getline; if ($2 == "value") print $3}' /opt/zimbra/conf/localconfig.xml 2>/dev/null | head -n 1)
        xml_src=$(awk -F'[<>]' '/name="smtp_source"/{getline; if ($2 == "value") print $3}' /opt/zimbra/conf/localconfig.xml 2>/dev/null | head -n 1)
    fi

    if [[ "$ALERT_EMAIL_TO" == "auto" || -z "$ALERT_EMAIL_TO" ]]; then
        if [[ -n "$xml_dest" ]]; then
            RESOLVED_EMAIL_TO="$xml_dest"
        else
            RESOLVED_EMAIL_TO="admin@${RESOLVED_DEFAULT_DOMAIN}"
        fi
    else
        RESOLVED_EMAIL_TO="$ALERT_EMAIL_TO"
    fi

    if [[ "$ALERT_EMAIL_FROM" == "auto" || -z "$ALERT_EMAIL_FROM" ]]; then
        if [[ -n "$xml_src" ]]; then
            RESOLVED_EMAIL_FROM="$xml_src"
        else
            RESOLVED_EMAIL_FROM="zimbra-monitor@${RESOLVED_DEFAULT_DOMAIN}"
        fi
    else
        RESOLVED_EMAIL_FROM="$ALERT_EMAIL_FROM"
    fi

    if [[ "$INTERNAL_DOMAINS" == "auto" || -z "$INTERNAL_DOMAINS" ]]; then
        RESOLVED_INTERNAL_DOMAINS="$RESOLVED_DEFAULT_DOMAIN $srv_host"
        if [[ -n "$xml_dest" && "$xml_dest" == *@* ]]; then
            RESOLVED_INTERNAL_DOMAINS="$RESOLVED_INTERNAL_DOMAINS ${xml_dest#*@}"
        fi
    else
        RESOLVED_INTERNAL_DOMAINS="$INTERNAL_DOMAINS"
    fi
}

find_postqueue_bin() {
    if [[ -n "$ZSM_POSTQUEUE_CMD" ]]; then
        echo "$ZSM_POSTQUEUE_CMD"
        return
    fi
    for p in /opt/zimbra/common/sbin/postqueue /opt/zimbra/postfix/sbin/postqueue /usr/sbin/postqueue; do
        if [[ -x "$p" ]]; then
            echo "$p"
            return
        fi
    done
    if command -v postqueue >/dev/null 2>&1; then
        command -v postqueue
        return
    fi
    echo ""
}

find_sendmail_bin() {
    if [[ -n "$ZSM_SENDMAIL_CMD" ]]; then
        echo "$ZSM_SENDMAIL_CMD"
        return
    fi
    for p in /opt/zimbra/common/sbin/sendmail /opt/zimbra/postfix/sbin/sendmail /usr/sbin/sendmail; do
        if [[ -x "$p" ]]; then
            echo "$p"
            return
        fi
    done
    if command -v sendmail >/dev/null 2>&1; then
        command -v sendmail
        return
    fi
    echo ""
}

is_whitelisted() {
    local email
    email=$(echo "$1" | tr '[:upper:]' '[:lower:]')
    [[ -z "$email" ]] && return 0
    [[ ! -f "$WHITELIST_FILE" ]] && return 1

    local domain=""
    if [[ "$email" == *@* ]]; then
        domain="@${email#*@}"
    fi

    while IFS= read -r line || [[ -n "$line" ]]; do
        line=$(echo "$line" | tr -d '\r' | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//' | tr '[:upper:]' '[:lower:]')
        [[ -z "$line" ]] && continue
        if [[ "$line" == "$email" ]]; then
            return 0
        fi
        if [[ -n "$domain" && "$line" == "$domain" ]]; then
            return 0
        fi
    done < "$WHITELIST_FILE"

    return 1
}

# ==============================================================================
# ALERT COOLDOWN, UNLOCK CUTOFF & LOCKED ACCOUNT HISTORY
# ==============================================================================
should_send_alert() {
    local sender="$1"
    local severity="$2"
    local state_file="$STATE_DIR/cooldown.db"
    local now_ts
    now_ts="${ZSM_NOW_EPOCH:-$(date +%s)}"
    local cooldown_sec=$(( ALERT_COOLDOWN_MINUTES * 60 ))

    [[ ! -f "$state_file" ]] && return 0

    local prev_line
    prev_line=$(grep -F "^${sender}|" "$state_file" 2>/dev/null | tail -n 1 || true)
    if [[ -z "$prev_line" ]]; then
        return 0
    fi

    local prev_sev prev_ts
    prev_sev=$(echo "$prev_line" | cut -d'|' -f2)
    prev_ts=$(echo "$prev_line" | cut -d'|' -f3)

    if [[ "$severity" == "CRITICAL" && "$prev_sev" != "CRITICAL" ]]; then
        return 0
    fi

    if [[ -n "$prev_ts" ]] && (( now_ts - prev_ts < cooldown_sec )); then
        return 1
    fi
    return 0
}

record_alert_state() {
    local sender="$1"
    local severity="$2"
    local state_file="$STATE_DIR/cooldown.db"
    local now_ts
    now_ts="${ZSM_NOW_EPOCH:-$(date +%s)}"

    mkdir -p "$STATE_DIR" 2>/dev/null || true
    if [[ -f "$state_file" ]]; then
        grep -v -F "^${sender}|" "$state_file" > "${state_file}.tmp" 2>/dev/null || true
        mv -f "${state_file}.tmp" "$state_file"
    fi
    echo "^${sender}|${severity}|${now_ts}" >> "$state_file"
}

is_account_already_locked() {
    local sender
    sender=$(echo "$1" | tr '[:upper:]' '[:lower:]')
    local locked_file="$STATE_DIR/locked_accounts.db"
    [[ ! -f "$locked_file" ]] && return 1
    grep -q -i "^${sender}|" "$locked_file" 2>/dev/null
}

record_unlock_cutoff() {
    local sender
    sender=$(echo "$1" | tr '[:upper:]' '[:lower:]')
    local cutoff_file="$STATE_DIR/unlock_cutoff.db"
    local now_ts="${ZSM_NOW_EPOCH:-$(date +%s)}"
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    if [[ -f "$cutoff_file" ]]; then
        grep -v -i "^${sender}|" "$cutoff_file" > "${cutoff_file}.tmp" 2>/dev/null || true
        mv -f "${cutoff_file}.tmp" "$cutoff_file"
    fi
    echo "${sender}|${now_ts}" >> "$cutoff_file"
}

was_recently_unlocked() {
    local sender
    sender=$(echo "$1" | tr '[:upper:]' '[:lower:]')
    local cutoff_file="$STATE_DIR/unlock_cutoff.db"
    [[ ! -f "$cutoff_file" ]] && return 1
    local line
    line=$(grep -i "^${sender}|" "$cutoff_file" 2>/dev/null | tail -n 1 || true)
    [[ -z "$line" ]] && return 1
    local uts now_ts
    uts=$(echo "$line" | cut -d'|' -f2)
    now_ts="${ZSM_NOW_EPOCH:-$(date +%s)}"
    [[ -n "$uts" ]] && (( now_ts - uts <= 3600 ))
}

clear_alert_state() {
    local sender
    sender=$(echo "$1" | tr '[:upper:]' '[:lower:]')
    local state_file="$STATE_DIR/cooldown.db"
    if [[ -f "$state_file" ]]; then
        grep -v -F "^${sender}|" "$state_file" > "${state_file}.tmp" 2>/dev/null || true
        mv -f "${state_file}.tmp" "$state_file"
    fi
    local locked_file="$STATE_DIR/locked_accounts.db"
    if [[ -f "$locked_file" ]]; then
        grep -v -i "^${sender}|" "$locked_file" > "${locked_file}.tmp" 2>/dev/null || true
        mv -f "${locked_file}.tmp" "$locked_file"
    fi
    record_unlock_cutoff "$sender"
}

record_locked_account() {
    local sender
    sender=$(echo "$1" | tr '[:upper:]' '[:lower:]')
    local locked_file="$STATE_DIR/locked_accounts.db"
    local ts_str
    ts_str=$(date '+%Y-%m-%d %H:%M:%S')
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    if [[ -f "$locked_file" ]]; then
        grep -v -i "^${sender}|" "$locked_file" > "${locked_file}.tmp" 2>/dev/null || true
        mv -f "${locked_file}.tmp" "$locked_file"
    fi
    echo "${sender}|${ts_str}" >> "$locked_file"
}

# ==============================================================================
# AUTO-REMEDIATION ON CRITICAL (LOCK ACCOUNT & HOLD QUEUE)
# ==============================================================================
lock_zimbra_account() {
    local account="$1"
    if [[ "$AUTO_LOCK_ON_CRITICAL" != "true" ]]; then
        echo "Auto-lock disabled (AUTO_LOCK_ON_CRITICAL=false)"
        return 0
    fi

    if is_account_already_locked "$account"; then
        echo "Account already LOCKED (skipped duplicate zmprov call)"
        return 0
    fi

    log_msg "CRITICAL" "Auto-locking compromised spam account: $account"

    if [[ -n "$ZSM_ZMPROV_CMD" ]]; then
        if $ZSM_ZMPROV_CMD ma "$account" zimbraAccountStatus locked >/dev/null 2>&1; then
            record_locked_account "$account"
            echo "Account automatically LOCKED (zimbraAccountStatus = locked)"
            return 0
        else
            echo "Failed to lock account via $ZSM_ZMPROV_CMD"
            return 1
        fi
    fi

    if [[ -x /opt/zimbra/bin/zmprov ]]; then
        if su - zimbra -c "/opt/zimbra/bin/zmprov ma '$account' zimbraAccountStatus locked" >/dev/null 2>&1; then
            record_locked_account "$account"
            echo "Account automatically LOCKED (zimbraAccountStatus = locked)"
            return 0
        else
            echo "Failed to execute zmprov lock command (check root/zimbra permissions)"
            return 1
        fi
    else
        echo "/opt/zimbra/bin/zmprov not found; could not auto-lock account"
        return 1
    fi
}

hold_sender_queue() {
    local sender="$1"
    [[ "$AUTO_HOLD_QUEUE_ON_CRITICAL" != "true" ]] && return 0

    local pq_bin
    pq_bin=$(find_postqueue_bin)
    [[ -z "$pq_bin" ]] && return 0

    local postsuper_bin=""
    for p in /opt/zimbra/common/sbin/postsuper /opt/zimbra/postfix/sbin/postsuper /usr/sbin/postsuper; do
        [[ -x "$p" ]] && postsuper_bin="$p" && break
    done
    [[ -z "$postsuper_bin" ]] && return 0

    $pq_bin -p 2>/dev/null | awk -v target="$sender" '
        /^[0-9A-F]+[*!]?[[:space:]]/ {
            qid=$1; sub(/[*!]$/, "", qid); s=tolower($7);
            if (s == tolower(target)) print qid
        }
    ' | $postsuper_bin -h - >/dev/null 2>&1 || true
    log_msg "CRITICAL" "Placed queued messages from $sender on HOLD"
}

# ==============================================================================
# TELEGRAM & EMAIL NOTIFICATIONS (100% ASCII-SAFE)
# ==============================================================================
html_escape() {
    local s="$1"
    s="${s//&/&amp;}"
    s="${s//</&lt;}"
    s="${s//>/&gt;}"
    echo "$s"
}

send_telegram_alert() {
    local message_html="$1"
    if [[ "$TELEGRAM_ENABLED" != "true" ]]; then
        return 0
    fi
    if [[ -z "$TELEGRAM_BOT_TOKEN" || -z "$TELEGRAM_CHAT_ID" ]]; then
        log_msg "WARN" "Telegram is enabled, but TELEGRAM_BOT_TOKEN or TELEGRAM_CHAT_ID is empty"
        return 1
    fi

    local url="https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage"
    local resp
    resp=$($ZSM_CURL_CMD -sS -m 15 -X POST "$url" \
        -d "chat_id=${TELEGRAM_CHAT_ID}" \
        -d "parse_mode=HTML" \
        -d "disable_web_page_preview=true" \
        --data-urlencode "text=${message_html}" 2>&1)

    if echo "$resp" | grep -q '"ok":true'; then
        log_msg "INFO" "Telegram alert sent successfully to Chat ID ${TELEGRAM_CHAT_ID}"
        return 0
    else
        log_msg "ERROR" "Failed to send Telegram alert: $resp"
        return 1
    fi
}

send_email_via_local_sendmail() {
    local subject="$1"
    local body_text="$2"
    local sm_bin
    sm_bin=$(find_sendmail_bin)
    if [[ -z "$sm_bin" ]]; then
        log_msg "ERROR" "sendmail binary not found on system"
        return 1
    fi

    local email_payload
    email_payload=$(cat <<EOF
From: Zimbra Spam Monitor <${RESOLVED_EMAIL_FROM}>
To: ${RESOLVED_EMAIL_TO}
Subject: ${subject}
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

${body_text}
EOF
)
    if printf "%s\n" "$email_payload" | $sm_bin -t >/dev/null 2>&1; then
        log_msg "INFO" "Email alert sent (Local Postfix) to ${RESOLVED_EMAIL_TO}"
        return 0
    else
        log_msg "ERROR" "Failed to send Email via Local Postfix"
        return 1
    fi
}

send_email_via_external_smtp() {
    local subject="$1"
    local body_text="$2"

    if [[ -z "$SMTP_HOST" || -z "$SMTP_USER" || -z "$SMTP_PASS" ]]; then
        log_msg "WARN" "Incomplete external SMTP settings (SMTP_HOST / SMTP_USER / SMTP_PASS)"
        return 1
    fi

    local proto="smtp"
    [[ "$SMTP_PORT" == "465" ]] && proto="smtps"
    local smtp_url="${proto}://${SMTP_HOST}:${SMTP_PORT}"

    local tls_flag=""
    if [[ "$SMTP_TLS" == "true" ]]; then
        tls_flag="--ssl-reqd"
    fi

    local tmp_mail
    tmp_mail=$(mktemp 2>/dev/null || echo "/tmp/zsm_mail_$$")
    cat <<EOF > "$tmp_mail"
From: Zimbra Spam Monitor <${SMTP_USER}>
To: ${RESOLVED_EMAIL_TO}
Subject: ${subject}
Date: $(date -R 2>/dev/null || date)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

${body_text}
EOF

    local rcpt_args=()
    IFS=',' read -ra ADDR_LIST <<< "$RESOLVED_EMAIL_TO"
    for addr in "${ADDR_LIST[@]}"; do
        addr=$(echo "$addr" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        [[ -n "$addr" ]] && rcpt_args+=(--mail-rcpt "$addr")
    done

    # shellcheck disable=SC2086
    if $ZSM_CURL_CMD -sS -m 20 --url "$smtp_url" $tls_flag \
        --mail-from "$SMTP_USER" \
        "${rcpt_args[@]}" \
        --user "${SMTP_USER}:${SMTP_PASS}" \
        -T "$tmp_mail" >/dev/null 2>&1; then
        rm -f "$tmp_mail"
        log_msg "INFO" "Email alert sent (External SMTP ${SMTP_HOST}) to ${RESOLVED_EMAIL_TO}"
        return 0
    else
        rm -f "$tmp_mail"
        log_msg "ERROR" "Failed to send Email via External SMTP (${SMTP_HOST}:${SMTP_PORT})"
        return 1
    fi
}

send_email_alert() {
    local subject="$1"
    local body_text="$2"
    local total_queue="${3:-0}"

    if [[ "$EMAIL_ENABLED" != "true" ]]; then
        return 0
    fi

    resolve_zimbra_settings

    if [[ "$EMAIL_DELIVERY_MODE" == "smtp" ]]; then
        send_email_via_external_smtp "$subject" "$body_text"
        return $?
    elif [[ "$EMAIL_DELIVERY_MODE" == "local" ]]; then
        send_email_via_local_sendmail "$subject" "$body_text"
        return $?
    else
        if (( total_queue >= WARN_TOTAL_QUEUE )) && [[ -n "$SMTP_HOST" && -n "$SMTP_USER" ]]; then
            if send_email_via_external_smtp "$subject" "$body_text"; then
                return 0
            fi
        fi
        if send_email_via_local_sendmail "$subject" "$body_text"; then
            return 0
        fi
        if [[ -n "$SMTP_HOST" && -n "$SMTP_USER" ]]; then
            send_email_via_external_smtp "$subject" "$body_text"
            return $?
        fi
        return 1
    fi
}

# ==============================================================================
# ZIMBRA LOG (/var/log/zimbra.log) & POSTFIX QUEUE (postqueue) ANALYSIS
# ==============================================================================
analyze_zimbra_log() {
    local out_file="$1"
    local sys_sum_file="${2:-}"
    : > "$out_file"
    if [[ -n "$sys_sum_file" ]]; then
        echo "0|0|0|0" > "$sys_sum_file"
    fi

    if [[ ! -f "$ZIMBRA_LOG_FILE" ]]; then
        log_msg "WARN" "Zimbra log file not found: $ZIMBRA_LOG_FILE"
        return 0
    fi

    resolve_zimbra_settings
    local now_epoch="${ZSM_NOW_EPOCH:-$(date +%s)}"
    local cur_year
    cur_year=$(date -d "@$now_epoch" '+%Y' 2>/dev/null || date '+%Y')
    local srv_ip
    srv_ip=$(get_server_ip)
    local unlock_file="$STATE_DIR/unlock_cutoff.db"

    tail -n "$LOG_TAIL_LINES" "$ZIMBRA_LOG_FILE" 2>/dev/null | awk \
        -v now_epoch="$now_epoch" \
        -v cur_year="$cur_year" \
        -v win_mins="$LOOKBACK_MINUTES" \
        -v count_internal="$COUNT_INTERNAL_TO_INTERNAL" \
        -v internal_domains="$RESOLVED_INTERNAL_DOMAINS" \
        -v default_domain="$RESOLVED_DEFAULT_DOMAIN" \
        -v srv_ip="$srv_ip" \
        -v amavis_thresh="$AMAVIS_SPAM_SCORE_THRESHOLD" \
        -v unlock_file="$unlock_file" \
        -v sys_file="$sys_sum_file" '
    BEGIN {
        win_cutoff = now_epoch - (win_mins * 60)
        sys_tot = 0; sys_snt = 0; sys_def = 0; sys_bnc = 0
        amavis_limit = amavis_thresh + 0

        split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", mnames, " ")
        for (i = 1; i <= 12; i++) {
            m_map[mnames[i]] = sprintf("%02d", i)
        }

        n_dom = split(tolower(internal_domains), dom_arr, /[[:space:],]+/)
        for (i = 1; i <= n_dom; i++) {
            if (dom_arr[i] != "") int_dom[dom_arr[i]] = 1
        }

        if (unlock_file != "") {
            while ((getline uline < unlock_file) > 0) {
                split(uline, uparts, "|")
                if (uparts[1] != "" && uparts[2] != "") {
                    unlock_ts[tolower(uparts[1])] = uparts[2] + 0
                }
            }
            close(unlock_file)
        }
    }

    function parse_epoch(line,   mo, dy, hms, y, hr, mi, sc, iso, ts) {
        line_hms = ""
        if (match(line, /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]/)) {
            iso = substr(line, 1, 19)
            y  = substr(iso, 1, 4)
            mo = substr(iso, 6, 2)
            dy = substr(iso, 9, 2)
            hr = substr(iso, 12, 2)
            mi = substr(iso, 15, 2)
            sc = substr(iso, 18, 2)
            line_hms = hr ":" mi ":" sc
            ts = mktime(y " " mo " " dy " " hr " " mi " " sc)
            return ts
        }
        if (($1 in m_map) && ($2 ~ /^[0-9]+$/) && ($3 ~ /^[0-9][0-9]:[0-9][0-9]:[0-9][0-9]$/)) {
            mo = m_map[$1]
            dy = sprintf("%02d", $2 + 0)
            line_hms = $3
            split($3, hms, ":")
            hr = hms[1]; mi = hms[2]; sc = hms[3]
            ts = mktime(cur_year " " mo " " dy " " hr " " mi " " sc)
            if (ts > now_epoch + 86400) {
                ts = mktime((cur_year - 1) " " mo " " dy " " hr " " mi " " sc)
            }
            return ts
        }
        return 0
    }

    function extract_domain(email,   idx) {
        idx = index(email, "@")
        if (idx > 0) return substr(email, idx + 1)
        return ""
    }

    function record_ip(acct, cip) {
        if (cip == "" || cip == "127.0.0.1" || cip == "::1" || cip == "localhost" || cip == "webmail/local") {
            if (!(acct in has_any_ip)) {
                has_any_ip[acct] = 1
                sender_ips[acct] = "webmail/local"
            }
            return
        }
        if (!((acct "|" cip) in seen_ip)) {
            seen_ip[acct "|" cip] = 1
            win_ip_cnt[acct]++
            has_any_ip[acct] = 1
            if (sender_ips[acct] == "" || sender_ips[acct] == "webmail/local") {
                sender_ips[acct] = cip
            } else if (win_ip_cnt[acct] <= 5) {
                sender_ips[acct] = sender_ips[acct] ", " cip
            }
        }
    }

    {
        has_postfix = (index($0, "postfix/") > 0)
        has_amavis  = (index($0, "amavis[") > 0)
        if (!has_postfix && !has_amavis) next

        ts = parse_epoch($0)

        # 1. Amavis Content Filter Verdict (SPAM / SPAMMY / INFECTED / High Hits)
        if (has_amavis) {
            is_amavis_bad = 0
            if (index($0, "Blocked SPAM") > 0 || index($0, "Passed SPAMMY") > 0 ||
                index($0, "Blocked INFECTED") > 0 || index($0, "Passed INFECTED") > 0) {
                is_amavis_bad = 1
            } else if (match($0, /Hits: -?[0-9]+(\.[0-9]+)?/)) {
                hits_val = substr($0, RSTART + 6, RLENGTH - 6) + 0
                if (hits_val >= amavis_limit) is_amavis_bad = 1
            }

            if (is_amavis_bad) {
                aqid = ""
                if (match($0, /Queue-ID: [0-9A-Za-z]+/)) {
                    aqid = substr($0, RSTART + 10, RLENGTH - 10)
                    q_amavis_spam[aqid] = 1
                }
                if (index($0, "Blocked ") > 0 && (index($0, "ORIGINATING") > 0 || index($0, "MYNETS") > 0 || (aqid != "" && (aqid in q_sasl)))) {
                    asender = ""
                    if (aqid != "" && (aqid in q_sasl)) {
                        asender = q_sasl[aqid]
                    } else if (match($0, /<[^>]+> ->/)) {
                        asender = tolower(substr($0, RSTART + 1, RLENGTH - 5))
                    }
                    if (asender != "" && (extract_domain(asender) in int_dom)) {
                        am_key = (aqid != "" ? aqid : NR)
                        q_amavis_blocked_acct[am_key] = asender
                        q_amavis_blocked_ts[am_key] = ts
                        q_amavis_blocked_hms[am_key] = line_hms
                        if (aqid != "" && (aqid in q_ip)) {
                            q_amavis_blocked_ip[am_key] = q_ip[aqid]
                        } else if (match($0, /\[[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\]/)) {
                            q_amavis_blocked_ip[am_key] = substr($0, RSTART + 1, RLENGTH - 2)
                        }
                    }
                }
            }
            next
        }

        # 2. Postfix SASL Authenticated Submission
        if (index($0, "sasl_username=") > 0) {
            qid = ""
            if (match($0, /: [0-9A-Za-z]+: client=/)) {
                qid = substr($0, RSTART + 2, RLENGTH - 11)
            }
            sasl = ""
            if (match($0, /sasl_username=[^ ,]+/)) {
                sasl = tolower(substr($0, RSTART + 14, RLENGTH - 14))
                if (sasl != "" && index(sasl, "@") == 0 && default_domain != "") {
                    sasl = sasl "@" tolower(default_domain)
                }
            }
            cip = ""
            if (match($0, /client=[^ ,]+/)) {
                cip = substr($0, RSTART + 7, RLENGTH - 7)
                if (match(cip, /\[[0-9a-fA-F.:]+\]/)) {
                    cip = substr(cip, RSTART + 1, RLENGTH - 2)
                }
            }
            if (qid != "" && sasl != "") {
                q_sasl[qid] = sasl
                q_root[qid] = qid
                q_birth_ts[qid] = ts
                if (line_hms != "") q_birth_hms[qid] = line_hms
                if (cip != "") q_ip[qid] = cip
            }
            next
        }

        # 3. Local Zimbra Webmail / Mynetworks Submission (non-Amavis smtpd)
        if (index($0, "postfix/smtpd[") > 0 && index($0, ": client=") > 0) {
            qid = ""
            if (match($0, /: [0-9A-Za-z]+: client=/)) {
                qid = substr($0, RSTART + 2, RLENGTH - 11)
            }
            cip = ""
            if (match($0, /client=[^ ,]+/)) {
                cip = substr($0, RSTART + 7, RLENGTH - 7)
                if (match(cip, /\[[0-9a-fA-F.:]+\]/)) {
                    cip = substr(cip, RSTART + 1, RLENGTH - 2)
                }
            }
            if (qid != "" && (cip == "127.0.0.1" || cip == "::1" || cip == srv_ip)) {
                q_local_client[qid] = 1
                if (!(qid in q_root)) q_root[qid] = qid
                if (!(qid in q_birth_ts)) q_birth_ts[qid] = ts
                if (!(qid in q_birth_hms) && line_hms != "") q_birth_hms[qid] = line_hms
                if (!(qid in q_ip)) q_ip[qid] = "webmail/local"
            }
            next
        }

        # 4. Postfix Queue Manager (Envelope From)
        if (index($0, "postfix/qmgr") > 0 && index($0, "from=<") > 0) {
            qid = ""
            if (match($0, /: [0-9A-Za-z]+: from=</)) {
                qid = substr($0, RSTART + 2, RLENGTH - 10)
            }
            faddr = ""
            if (match($0, /from=<[^>]*>/)) {
                faddr = tolower(substr($0, RSTART + 6, RLENGTH - 7))
            }
            if (qid != "") {
                if (faddr != "") q_from[qid] = faddr
                if (!(qid in q_root)) q_root[qid] = qid
                if (!(qid in q_birth_ts)) q_birth_ts[qid] = ts
                if (!(qid in q_birth_hms) && line_hms != "") q_birth_hms[qid] = line_hms
            }
            next
        }

        # 5. Postfix Delivery / Amavis Handoff
        if ((index($0, "postfix/smtp[") > 0 || index($0, "postfix/error[") > 0) && index($0, "to=<") > 0 && index($0, "status=") > 0) {
            qid = ""
            if (match($0, /: [0-9A-Za-z]+: to=</)) {
                qid = substr($0, RSTART + 2, RLENGTH - 8)
            }
            if (qid == "") next

            # Handle internal Amavis / DKIM filter hop (127.0.0.1:10024/10026/10032)
            if (index($0, "127.0.0.1]:100") > 0 || index($0, "localhost]:100") > 0) {
                if (match($0, /queued as [0-9A-Za-z]+/)) {
                    qid2 = substr($0, RSTART + 10, RLENGTH - 10)
                    q_root[qid2] = (qid in q_root ? q_root[qid] : qid)
                    if (qid in q_sasl) q_sasl[qid2] = q_sasl[qid]
                    if (qid in q_from) q_from[qid2] = q_from[qid]
                    if (qid in q_ip) q_ip[qid2] = q_ip[qid]
                    if (qid in q_local_client) q_local_client[qid2] = q_local_client[qid]
                    if (qid in q_birth_ts) q_birth_ts[qid2] = q_birth_ts[qid]
                    if (qid in q_birth_hms) q_birth_hms[qid2] = q_birth_hms[qid]
                    if (qid in q_amavis_spam) q_amavis_spam[qid2] = q_amavis_spam[qid]
                    next
                }
                if (index($0, "discarded") == 0) {
                    next
                }
            }

            sasl_user = (qid in q_sasl ? q_sasl[qid] : "")
            env_from  = (qid in q_from ? q_from[qid] : "")

            rcpt = ""
            if (match($0, /to=<[^>]+>/)) {
                rcpt = tolower(substr($0, RSTART + 4, RLENGTH - 5))
            }
            rdom = extract_domain(rcpt)

            acct = ""
            is_spoof = 0
            if (sasl_user != "") {
                acct = sasl_user
                if (env_from != "" && env_from != "<>" && env_from != sasl_user) {
                    fdom = extract_domain(env_from)
                    if (fdom != "" && !(fdom in int_dom)) {
                        is_spoof = 1
                    }
                }
            } else if (env_from != "" && env_from != "<>") {
                fdom = extract_domain(env_from)
                if (fdom in int_dom) {
                    if ((qid in q_local_client) || !(rdom in int_dom)) {
                        acct = env_from
                    }
                }
            }
            if (acct == "") next

            if (count_internal != "true" && rdom != "" && (rdom in int_dom) && sasl_user == "") {
                next
            }
            if (count_internal != "true" && rdom != "" && (rdom in int_dom) && !is_spoof) {
                # Internal-to-internal normal mail skipped when COUNT_INTERNAL_TO_INTERNAL=false
                next
            }

            st = "other"
            if (index($0, "127.0.0.1]:100") > 0 && index($0, "discarded") > 0) {
                st = "bounced"
            } else if (match($0, /status=[a-z]+/)) {
                st = substr($0, RSTART + 7, RLENGTH - 7)
            }

            counted_qids[qid] = 1
            root_qid = (qid in q_root ? q_root[qid] : qid)
            counted_qids[root_qid] = 1

            # System cumulative outbound totals up to current alert time
            sys_tot++
            if (st == "sent") sys_snt++
            else if (st == "deferred") sys_def++
            else if (st == "bounced") sys_bnc++

            # True message submission time (prevents old Postfix queue retries from triggering new alerts)
            delay_sec = 0
            if (match($0, /delay=[0-9]+(\.[0-9]+)?/)) {
                delay_sec = int(substr($0, RSTART + 6, RLENGTH - 6) + 0)
            }
            if ((qid in q_birth_ts) && q_birth_ts[qid] > 0 && delay_sec <= (win_mins * 60)) {
                submit_ts = q_birth_ts[qid]
            } else if (delay_sec > 0 && ts > 0) {
                submit_ts = ts - delay_sec
            } else if ((qid in q_birth_ts) && q_birth_ts[qid] > 0) {
                submit_ts = q_birth_ts[qid]
            } else {
                submit_ts = ts
            }

            if (submit_ts < win_cutoff) next
            if ((acct in unlock_ts) && submit_ts <= unlock_ts[acct]) next

            all_senders[acct] = 1

            msg_key = acct "|" root_qid
            if (!(msg_key in seen_msg)) {
                seen_msg[msg_key] = 1
                win_msgs[acct]++
            }

            win_rcpts[acct]++
            if (st == "sent") win_sent[acct]++
            else if (st == "deferred") win_def[acct]++
            else if (st == "bounced") win_bnc[acct]++

            if (rcpt != "" && !((acct "|" rcpt) in seen_rcpt)) {
                seen_rcpt[acct "|" rcpt] = 1
                win_uniq_rcpts[acct]++
            }
            if (rdom != "" && !(rdom in int_dom) && !((acct "|" rdom) in seen_dom)) {
                seen_dom[acct "|" rdom] = 1
                win_uniq_doms[acct]++
            }

            record_ip(acct, (qid in q_ip ? q_ip[qid] : ""))

            if (is_spoof) {
                win_spoof[acct]++
            }
            if (qid in q_amavis_spam) {
                win_amavis[acct]++
            }

            if (st == "bounced" || st == "deferred") {
                low_line = tolower($0)
                if (index(low_line, "5.7.1") > 0 || index(low_line, "4.7.28") > 0 ||
                    index(low_line, "unsolicited") > 0 || index(low_line, "spamhaus") > 0 ||
                    index(low_line, "barracuda") > 0 || index(low_line, "sorbs") > 0 ||
                    index(low_line, "spamcop") > 0 || index(low_line, "blacklisted") > 0 ||
                    index(low_line, "blocked using") > 0 || index(low_line, "rejected as spam") > 0) {
                    win_rbl[acct]++
                }
            }

            ev_hms = (line_hms != "" ? line_hms : q_birth_hms[qid])
            if (ev_hms != "") {
                if (!(acct in win_first_hms)) win_first_hms[acct] = ev_hms
                win_last_hms[acct] = ev_hms
            }
        }
    }

    END {
        # Include any Amavis Blocked SPAM/INFECTED events that had no postfix/smtp line
        for (k in q_amavis_blocked_acct) {
            if (k in counted_qids) continue
            acct = q_amavis_blocked_acct[k]
            bts  = q_amavis_blocked_ts[k]
            sys_tot++; sys_bnc++
            if (bts < win_cutoff) continue
            if ((acct in unlock_ts) && bts <= unlock_ts[acct]) continue
            all_senders[acct] = 1
            win_msgs[acct]++
            win_rcpts[acct]++
            win_bnc[acct]++
            win_amavis[acct]++
            record_ip(acct, q_amavis_blocked_ip[k])
            if (q_amavis_blocked_hms[k] != "") {
                if (!(acct in win_first_hms)) win_first_hms[acct] = q_amavis_blocked_hms[k]
                win_last_hms[acct] = q_amavis_blocked_hms[k]
            }
        }

        if (sys_file != "") {
            printf "%d|%d|%d|%d\n", sys_tot, sys_snt, sys_def, sys_bnc > sys_file
        }

        for (s in all_senders) {
            m_cnt  = win_msgs[s] + 0
            r_cnt  = win_rcpts[s] + 0
            ur_cnt = win_uniq_rcpts[s] + 0
            ud_cnt = win_uniq_doms[s] + 0
            s_cnt  = win_sent[s] + 0
            d_cnt  = win_def[s] + 0
            b_cnt  = win_bnc[s] + 0
            i_cnt  = win_ip_cnt[s] + 0
            sp_cnt = win_spoof[s] + 0
            am_cnt = win_amavis[s] + 0
            rb_cnt = win_rbl[s] + 0
            ips = (sender_ips[s] != "" ? sender_ips[s] : "webmail/local")
            if (i_cnt > 5) {
                ips = ips " (+" (i_cnt - 5) " more)"
            }
            tspan = (s in win_first_hms ? win_first_hms[s] " -> " win_last_hms[s] : "-")
            printf "%s|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%s|%s\n",
                s, m_cnt, r_cnt, ur_cnt, ud_cnt, s_cnt, d_cnt, b_cnt, i_cnt, sp_cnt, am_cnt, rb_cnt, ips, tspan
        }
    }
    ' | sort -t'|' -k3,3nr -k2,2nr > "$out_file"
}

analyze_postfix_queue() {
    local out_file="$1"
    local summary_file="$2"
    : > "$out_file"
    echo "0|0|0|0" > "$summary_file"

    local pq_bin
    pq_bin=$(find_postqueue_bin)
    if [[ -z "$pq_bin" ]]; then
        return 0
    fi

    $pq_bin -p 2>/dev/null | awk '
    BEGIN {
        total_q = 0; active_q = 0; hold_q = 0; def_q = 0
        cur_sender = ""; cur_reason = ""
    }
    /^[0-9A-F]+[*!]?[[:space:]]/ {
        qid_raw = $1
        sender = tolower($7)
        if (sender == "" || sender ~ /^from=/) next

        total_q++
        if (index(qid_raw, "*") > 0) active_q++
        else if (index(qid_raw, "!") > 0) hold_q++
        else def_q++

        if (sender != "mailer-daemon" && sender != "<>") {
            q_user[sender]++
            cur_sender = sender
        } else {
            cur_sender = ""
        }
        next
    }
    /^[[:space:]]+\(/ {
        if (cur_sender != "" && !(cur_sender in q_reason)) {
            r = $0
            sub(/^[[:space:]]+\(/, "", r)
            sub(/\)[[:space:]]*$/, "", r)
            gsub(/\|/, "/", r)
            if (length(r) > 90) r = substr(r, 1, 90) "..."
            q_reason[cur_sender] = r
        }
    }
    END {
        printf "%d|%d|%d|%d\n", total_q, active_q, def_q, hold_q > "'"$summary_file"'"
        for (u in q_user) {
            reason = (u in q_reason ? q_reason[u] : "Queued for delivery")
            printf "%s|%d|%s\n", u, q_user[u], reason
        }
    }
    ' | sort -t'|' -k2,2nr > "$out_file"
}

append_reason() {
    local cur="$1"
    local item="$2"
    if [[ -z "$cur" ]]; then
        echo "$item"
    else
        echo "${cur}, ${item}"
    fi
}

# ==============================================================================
# MAIN CHECK CYCLE (--run)
# ==============================================================================
run_monitor_cycle() {
    load_config
    if [[ "$MONITOR_ENABLED" != "true" ]]; then
        return 0
    fi

    local lock_file="$STATE_DIR/monitor.lock"
    if [[ -f "$lock_file" ]]; then
        local old_pid
        old_pid=$(cat "$lock_file" 2>/dev/null || echo "")
        if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
            log_msg "WARN" "Previous scan (PID $old_pid) is still running; skipping cycle."
            return 0
        fi
    fi
    echo $$ > "$lock_file"

    local tmp_log_stats tmp_sys_sum tmp_q_stats tmp_q_sum tmp_merged
    tmp_log_stats=$(mktemp 2>/dev/null || echo "/tmp/zsm_log_$$")
    tmp_sys_sum=$(mktemp 2>/dev/null || echo "/tmp/zsm_syssum_$$")
    tmp_q_stats=$(mktemp 2>/dev/null || echo "/tmp/zsm_q_$$")
    tmp_q_sum=$(mktemp 2>/dev/null || echo "/tmp/zsm_qsum_$$")
    tmp_merged=$(mktemp 2>/dev/null || echo "/tmp/zsm_merged_$$")

    analyze_zimbra_log "$tmp_log_stats" "$tmp_sys_sum"
    analyze_postfix_queue "$tmp_q_stats" "$tmp_q_sum"

    local sys_summary sys_tot sys_snt sys_def sys_bnc
    sys_summary=$(cat "$tmp_sys_sum" 2>/dev/null || echo "0|0|0|0")
    IFS='|' read -r sys_tot sys_snt sys_def sys_bnc <<< "$sys_summary"

    local q_summary total_queue active_queue def_queue hold_queue
    q_summary=$(cat "$tmp_q_sum" 2>/dev/null || echo "0|0|0|0")
    IFS='|' read -r total_queue active_queue def_queue hold_queue <<< "$q_summary"

    awk -F'|' '
    FNR == NR {
        s = $1
        if (s == "") next
        users[s] = 1
        m[s] = $2; r[s] = $3; ur[s] = $4; ud[s] = $5
        snt[s] = $6; def[s] = $7; bnc[s] = $8
        ipc[s] = $9; spf[s] = $10; amv[s] = $11; rbl[s] = $12
        ips[s] = $13; tsp[s] = $14
        next
    }
    {
        s = $1
        if (s == "") next
        users[s] = 1
        qc[s] = $2
    }
    END {
        for (u in users) {
            printf "%s|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%s|%s\n",
                u,
                m[u]+0, r[u]+0, ur[u]+0, ud[u]+0,
                snt[u]+0, def[u]+0, bnc[u]+0,
                ipc[u]+0, spf[u]+0, amv[u]+0, rbl[u]+0,
                qc[u]+0,
                (ips[u] != "" ? ips[u] : "queued/unknown"),
                (tsp[u] != "" ? tsp[u] : "-")
        }
    }
    ' "$tmp_log_stats" "$tmp_q_stats" | sort -t'|' -k3,3nr -k13,13nr > "$tmp_merged"

    local srv_host srv_ip now_epoch now_str now_date
    srv_host=$(get_server_hostname)
    srv_ip=$(get_server_ip)
    now_epoch="${ZSM_NOW_EPOCH:-$(date +%s)}"
    now_str=$(date -d "@$now_epoch" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date '+%Y-%m-%d %H:%M:%S')
    now_date=$(date -d "@$now_epoch" '+%Y-%m-%d' 2>/dev/null || date '+%Y-%m-%d')
    local alerts_triggered=0

    while IFS='|' read -r sender msgs rcpts uniq_rcpts uniq_doms snt def bnc ip_cnt spoof_cnt amavis_cnt rbl_cnt q_cnt s_ips s_tspan; do
        [[ -z "$sender" ]] && continue

        if is_whitelisted "$sender"; then
            continue
        fi

        local failed_cnt=$(( def + bnc ))
        local fail_pct_x10=0
        local fail_pct_str="0.0"
        if (( rcpts > 0 )); then
            fail_pct_x10=$(( (failed_cnt * 1000 + rcpts / 2) / rcpts ))
            fail_pct_str="$(( fail_pct_x10 / 10 )).$(( fail_pct_x10 % 10 ))"
        fi

        local severity="NORMAL"
        local reasons=""

        # 1. Messages Sent
        if (( msgs >= CRIT_MESSAGES_SENT )); then
            severity="CRITICAL"
            reasons=$(append_reason "$reasons" "Msgs (${msgs}>=${CRIT_MESSAGES_SENT})")
        elif (( msgs >= WARN_MESSAGES_SENT )); then
            [[ "$severity" == "NORMAL" ]] && severity="WARNING"
            reasons=$(append_reason "$reasons" "Msgs (${msgs}>=${WARN_MESSAGES_SENT})")
        fi

        # 2. Total Recipients (CRITICAL requires CRIT_MIN_MESSAGES_FOR_BULK to protect single CC/BCC announcements)
        if (( rcpts >= CRIT_RECIPIENTS && msgs >= CRIT_MIN_MESSAGES_FOR_BULK )); then
            severity="CRITICAL"
            reasons=$(append_reason "$reasons" "Rcpts (${rcpts}>=${CRIT_RECIPIENTS})")
        elif (( rcpts >= WARN_RECIPIENTS )); then
            [[ "$severity" == "NORMAL" ]] && severity="WARNING"
            reasons=$(append_reason "$reasons" "Rcpts (${rcpts}>=${WARN_RECIPIENTS})")
        fi

        # 3. Unique Recipients across External Domains
        if (( uniq_doms >= MIN_EXTERNAL_DOMAINS_FOR_UNIQUE )); then
            if (( uniq_rcpts >= CRIT_UNIQUE_RECIPIENTS && msgs >= CRIT_MIN_MESSAGES_FOR_BULK )); then
                severity="CRITICAL"
                reasons=$(append_reason "$reasons" "Unique Rcpts (${uniq_rcpts}>=${CRIT_UNIQUE_RECIPIENTS})")
            elif (( uniq_rcpts >= WARN_UNIQUE_RECIPIENTS )); then
                [[ "$severity" == "NORMAL" ]] && severity="WARNING"
                reasons=$(append_reason "$reasons" "Unique Rcpts (${uniq_rcpts}>=${WARN_UNIQUE_RECIPIENTS})")
            fi
        fi

        # 4. Failed Rate ((Deferred + Bounced) / Recipients %)
        if (( rcpts >= CRIT_MIN_RECIPIENTS_FOR_FAIL_RATE && fail_pct_x10 >= CRIT_FAILED_RATE_PCT * 10 )); then
            severity="CRITICAL"
            reasons=$(append_reason "$reasons" "Failed Rate (${fail_pct_str}%>=${CRIT_FAILED_RATE_PCT}%)")
        elif (( rcpts >= MIN_RECIPIENTS_FOR_FAIL_RATE && fail_pct_x10 >= WARN_FAILED_RATE_PCT * 10 )); then
            [[ "$severity" == "NORMAL" ]] && severity="WARNING"
            reasons=$(append_reason "$reasons" "Failed Rate (${fail_pct_str}%>=${WARN_FAILED_RATE_PCT}%)")
        fi

        # 5. Distinct Source IPs (Distributed Botnet)
        if (( ip_cnt >= CRIT_SOURCE_IPS && msgs >= CRIT_MIN_MESSAGES_FOR_IPS )); then
            severity="CRITICAL"
            reasons=$(append_reason "$reasons" "Source IPs (${ip_cnt}>=${CRIT_SOURCE_IPS})")
        elif (( ip_cnt >= WARN_SOURCE_IPS && msgs >= WARN_MIN_MESSAGES_FOR_IPS )); then
            [[ "$severity" == "NORMAL" ]] && severity="WARNING"
            reasons=$(append_reason "$reasons" "Source IPs (${ip_cnt}>=${WARN_SOURCE_IPS})")
        fi

        # 6. External Sender Spoofing (sasl_username != From)
        if (( spoof_cnt >= CRIT_SPOOF_COUNT )); then
            severity="CRITICAL"
            reasons=$(append_reason "$reasons" "Spoof From (${spoof_cnt}>=${CRIT_SPOOF_COUNT})")
        elif (( spoof_cnt >= WARN_SPOOF_COUNT )); then
            [[ "$severity" == "NORMAL" ]] && severity="WARNING"
            reasons=$(append_reason "$reasons" "Spoof From (${spoof_cnt}>=${WARN_SPOOF_COUNT})")
        fi

        # 7. Amavis SPAM/INFECTED & Remote RBL/Spam Rejections
        local spam_sig=$(( amavis_cnt + rbl_cnt ))
        if (( spam_sig >= CRIT_SPAM_SIGNALS )); then
            severity="CRITICAL"
            if (( amavis_cnt > 0 )); then
                reasons=$(append_reason "$reasons" "Amavis SPAM (${amavis_cnt})")
            fi
            if (( rbl_cnt > 0 )); then
                reasons=$(append_reason "$reasons" "RBL/Spam Reject (${rbl_cnt})")
            fi
        elif (( spam_sig >= WARN_SPAM_SIGNALS )); then
            [[ "$severity" == "NORMAL" ]] && severity="WARNING"
            if (( amavis_cnt > 0 )); then
                reasons=$(append_reason "$reasons" "Amavis SPAM (${amavis_cnt})")
            fi
            if (( rbl_cnt > 0 )); then
                reasons=$(append_reason "$reasons" "RBL/Spam Reject (${rbl_cnt})")
            fi
        fi

        # 8. Account Postfix Queue (Do not re-lock a freshly unlocked account if msgs == 0)
        if (( q_cnt >= CRIT_QUEUE_PER_USER )); then
            if (( msgs == 0 )) && was_recently_unlocked "$sender"; then
                [[ "$severity" == "NORMAL" ]] && severity="WARNING"
                reasons=$(append_reason "$reasons" "Leftover Queue (${q_cnt}>=${CRIT_QUEUE_PER_USER})")
            else
                severity="CRITICAL"
                reasons=$(append_reason "$reasons" "Account Queue (${q_cnt}>=${CRIT_QUEUE_PER_USER})")
            fi
        elif (( q_cnt >= WARN_QUEUE_PER_USER )); then
            [[ "$severity" == "NORMAL" ]] && severity="WARNING"
            reasons=$(append_reason "$reasons" "Account Queue (${q_cnt}>=${WARN_QUEUE_PER_USER})")
        fi

        [[ "$severity" == "NORMAL" ]] && continue

        if ! should_send_alert "$sender" "$severity"; then
            log_msg "INFO" "Cooldown active; skipping duplicate alert for $sender [$severity]"
            continue
        fi

        local action_taken="Alert Only (WARNING)"
        if [[ "$severity" == "CRITICAL" ]]; then
            action_taken=$(lock_zimbra_account "$sender")
            hold_sender_queue "$sender"
        fi

        record_alert_state "$sender" "$severity"
        alerts_triggered=$(( alerts_triggered + 1 ))

        local spam_time_str="$now_str"
        if [[ -n "$s_tspan" && "$s_tspan" != "-" ]]; then
            spam_time_str="${now_date} (${s_tspan})"
        fi

        local ip_display="$s_ips"
        if (( ip_cnt > 1 )); then
            ip_display="${s_ips} (${ip_cnt} IPs)"
        elif (( ip_cnt == 1 )); then
            ip_display="${s_ips} (1 IP)"
        fi

        log_msg "$severity" "Spam detected: user=$sender | reason=[$reasons] | msgs=$msgs | rcpts=$rcpts ($uniq_rcpts uniq) | fail=${fail_pct_str}% | queue=$q_cnt | action=$action_taken"

        local tg_msg
        tg_msg=$(cat <<EOF
<b>[ZIMBRA SPAM ${severity}]</b>
<code>==============================</code>
<b>Server       :</b> <code>$(html_escape "$srv_host")</code> (${srv_ip})
<b>Alert Time   :</b> ${now_str}
<b>Spam Time    :</b> $(html_escape "$spam_time_str")
<b>Spam Account :</b> <code>$(html_escape "$sender")</code>
<b>Source IPs   :</b> <code>$(html_escape "$ip_display")</code>
<b>Reason       :</b> $(html_escape "$reasons")

<b>[1] ACCOUNT SPAM METRICS (${LOOKBACK_MINUTES}m)</b>
<b>Messages Sent:</b> <b>${msgs}</b> msgs
<b>Recipients   :</b> <b>${rcpts}</b> total (Unique: ${uniq_rcpts} | Domains: ${uniq_doms})
<b>Failed Rate  :</b> <b>${fail_pct_str}%</b> (${failed_cnt}/${rcpts} failed)
  <code>Sent: ${snt} | Deferred: ${def} | Bounced: ${bnc}</code>
<b>Spam Signals :</b> <code>Amavis SPAM: ${amavis_cnt} | Spoof From: ${spoof_cnt} | RBL: ${rbl_cnt}</code>

<b>[2] REMAINING MAIL QUEUE</b>
<b>Account Queue:</b> <b>${q_cnt}</b> emails
<b>System Queue :</b> <b>${total_queue}</b> emails
  <code>Active: ${active_queue} | Deferred: ${def_queue} | Hold: ${hold_queue}</code>

<b>[3] SYSTEM TOTAL TRAFFIC</b>
<b>Total Traffic:</b> <b>${sys_tot}</b> emails
  <code>Sent: ${sys_snt} | Deferred: ${sys_def} | Bounced: ${sys_bnc}</code>
<code>==============================</code>
EOF
)

        local mail_subj="[Zimbra Spam ${severity}] ${sender} (${msgs} msgs / ${rcpts} rcpts) on ${srv_host}"
        local mail_body
        mail_body=$(cat <<EOF
============================================================
         ZIMBRA SPAM ALERT - ${severity}
============================================================
Server        : ${srv_host} (${srv_ip})
Alert Time    : ${now_str}
Spam Time     : ${spam_time_str}
Spam Account  : ${sender}
Source IPs    : ${ip_display}
Reason        : ${reasons}

------------------------------------------------------------
[1] ACCOUNT SPAM METRICS (LAST ${LOOKBACK_MINUTES} MINS)
------------------------------------------------------------
Messages Sent : ${msgs} msgs
Recipients    : ${rcpts} total (Unique: ${uniq_rcpts} | Domains: ${uniq_doms})
Failed Rate   : ${fail_pct_str}% (${failed_cnt}/${rcpts} failed)
                Sent: ${snt} | Deferred: ${def} | Bounced: ${bnc}
Spam Signals  : Amavis SPAM: ${amavis_cnt} | Spoof From: ${spoof_cnt} | RBL: ${rbl_cnt}

------------------------------------------------------------
[2] REMAINING MAIL QUEUE
------------------------------------------------------------
Account Queue : ${q_cnt} emails
System Queue  : ${total_queue} emails
                Active: ${active_queue} | Deferred: ${def_queue} | Hold: ${hold_queue}

------------------------------------------------------------
[3] SYSTEM TOTAL TRAFFIC
------------------------------------------------------------
Total Traffic : ${sys_tot} emails
                Sent: ${sys_snt} | Deferred: ${sys_def} | Bounced: ${sys_bnc}
============================================================
EOF
)

        send_telegram_alert "$tg_msg"
        send_email_alert "$mail_subj" "$mail_body" "$total_queue"

    done < "$tmp_merged"

    if (( total_queue >= WARN_TOTAL_QUEUE )) && (( alerts_triggered == 0 )); then
        if should_send_alert "__SYSTEM_TOTAL_QUEUE__" "WARNING"; then
            record_alert_state "__SYSTEM_TOTAL_QUEUE__" "WARNING"
            local q_tg_msg
            q_tg_msg=$(cat <<EOF
<b>[ZIMBRA QUEUE WARNING]</b>
<code>==============================</code>
<b>Server       :</b> <code>$(html_escape "$srv_host")</code> (${srv_ip})
<b>Alert Time   :</b> ${now_str}

<b>[1] REMAINING MAIL QUEUE</b>
<b>System Queue :</b> <b>${total_queue}</b> emails (Limit: ${WARN_TOTAL_QUEUE})
  <code>Active: ${active_queue} | Deferred: ${def_queue} | Hold: ${hold_queue}</code>

<b>[2] SYSTEM TOTAL TRAFFIC</b>
<b>Total Traffic:</b> <b>${sys_tot}</b> emails
  <code>Sent: ${sys_snt} | Deferred: ${sys_def} | Bounced: ${sys_bnc}</code>
<code>==============================</code>
EOF
)
            local q_mail_body
            q_mail_body=$(cat <<EOF
============================================================
         ZIMBRA QUEUE WARNING
============================================================
Server        : ${srv_host} (${srv_ip})
Alert Time    : ${now_str}

------------------------------------------------------------
[1] REMAINING MAIL QUEUE
------------------------------------------------------------
System Queue  : ${total_queue} emails (Limit: ${WARN_TOTAL_QUEUE})
                Active: ${active_queue} | Deferred: ${def_queue} | Hold: ${hold_queue}

------------------------------------------------------------
[2] SYSTEM TOTAL TRAFFIC
------------------------------------------------------------
Total Traffic : ${sys_tot} emails
                Sent: ${sys_snt} | Deferred: ${sys_def} | Bounced: ${sys_bnc}
============================================================
EOF
)
            send_telegram_alert "$q_tg_msg"
            send_email_alert "[Zimbra Queue Warning] ${total_queue} queued emails on ${srv_host}" \
                "$q_mail_body" \
                "$total_queue"
        fi
    fi

    rm -f "$tmp_log_stats" "$tmp_sys_sum" "$tmp_q_stats" "$tmp_q_sum" "$tmp_merged" "$lock_file"
}

# ==============================================================================
# STATUS DASHBOARD, TEST ALERT & UNLOCK COMMANDS
# ==============================================================================
show_status() {
    load_config
    resolve_zimbra_settings

    local tmp_log_stats tmp_sys_sum tmp_q_stats tmp_q_sum
    tmp_log_stats=$(mktemp 2>/dev/null || echo "/tmp/zsm_st_log_$$")
    tmp_sys_sum=$(mktemp 2>/dev/null || echo "/tmp/zsm_st_sys_$$")
    tmp_q_stats=$(mktemp 2>/dev/null || echo "/tmp/zsm_st_q_$$")
    tmp_q_sum=$(mktemp 2>/dev/null || echo "/tmp/zsm_st_qsum_$$")

    analyze_zimbra_log "$tmp_log_stats" "$tmp_sys_sum"
    analyze_postfix_queue "$tmp_q_stats" "$tmp_q_sum"

    local sys_summary sys_tot sys_snt sys_def sys_bnc
    sys_summary=$(cat "$tmp_sys_sum" 2>/dev/null || echo "0|0|0|0")
    IFS='|' read -r sys_tot sys_snt sys_def sys_bnc <<< "$sys_summary"

    local q_summary total_queue active_queue def_queue hold_queue
    q_summary=$(cat "$tmp_q_sum" 2>/dev/null || echo "0|0|0|0")
    IFS='|' read -r total_queue active_queue def_queue hold_queue <<< "$q_summary"

    echo "=============================================================================="
    echo " ZIMBRA SPAM MONITOR v${VERSION} - LIVE SYSTEM STATUS (LAST ${LOOKBACK_MINUTES} MINS)"
    echo "=============================================================================="
    echo " Zimbra Server   : $(get_server_hostname) ($(get_server_ip))"
    echo " Monitor Status  : ${MONITOR_ENABLED} | Check Range: ${LOOKBACK_MINUTES}m | Cooldown: ${ALERT_COOLDOWN_MINUTES}m | Auto-Lock: ${AUTO_LOCK_ON_CRITICAL}"
    echo " Alert Email To  : ${RESOLVED_EMAIL_TO} (Mode: ${EMAIL_DELIVERY_MODE})"
    echo " System Traffic  : ${sys_tot} emails (Sent: ${sys_snt} | Deferred: ${sys_def} | Bounced: ${sys_bnc})"
    echo " Postfix Queue   : ${total_queue} emails (Active: ${active_queue} | Deferred: ${def_queue} | Hold: ${hold_queue})"
    echo "------------------------------------------------------------------------------"
    printf " %-26s | %-5s | %-13s | %-6s | %-3s | %-10s\n" "SENDER (${LOOKBACK_MINUTES}m)" "MSGS" "RCPTS (UNIQ)" "FAIL%" "IPs" "SPAM/SPOOF"
    echo "------------------------------------------------------------------------------"
    if [[ -s "$tmp_log_stats" ]]; then
        head -n 15 "$tmp_log_stats" | while IFS='|' read -r s m r ur ud snt def bnc ipc spf amv rbl ips tsp; do
            local fl=$(( def + bnc ))
            local fp_x10=0
            if (( r > 0 )); then
                fp_x10=$(( (fl * 1000 + r / 2) / r ))
            fi
            local fp_str="$(( fp_x10 / 10 )).$(( fp_x10 % 10 ))%"
            local rcpt_col="${r} (${ur})"
            local sig_col="$(( amv + rbl )) / ${spf}"
            printf " %-26s | %-5s | %-13s | %-6s | %-3s | %-10s\n" "$s" "$m" "$rcpt_col" "$fp_str" "$ipc" "$sig_col"
        done
    else
        echo " (No outbound email traffic in the last ${LOOKBACK_MINUTES} minutes)"
    fi
    echo "------------------------------------------------------------------------------"
    printf " %-34s | %-10s | %-28s\n" "SENDERS IN POSTFIX QUEUE" "QUEUED" "STATUS / REASON"
    echo "------------------------------------------------------------------------------"
    if [[ -s "$tmp_q_stats" ]]; then
        head -n 10 "$tmp_q_stats" | while IFS='|' read -r u qc qr; do
            printf " %-34s | %-10s | %-28s\n" "$u" "$qc" "$qr"
        done
    else
        echo " (Mail queue is clean)"
    fi
    echo "=============================================================================="

    rm -f "$tmp_log_stats" "$tmp_sys_sum" "$tmp_q_stats" "$tmp_q_sum"
}

run_test_alert() {
    load_config
    resolve_zimbra_settings
    local srv_host srv_ip now_str
    srv_host=$(get_server_hostname)
    srv_ip=$(get_server_ip)
    now_str=$(date '+%Y-%m-%d %H:%M:%S')

    local tmp_log_stats tmp_sys_sum tmp_q_stats tmp_q_sum
    tmp_log_stats=$(mktemp 2>/dev/null || echo "/tmp/zsm_tst_log_$$")
    tmp_sys_sum=$(mktemp 2>/dev/null || echo "/tmp/zsm_tst_sys_$$")
    tmp_q_stats=$(mktemp 2>/dev/null || echo "/tmp/zsm_tst_q_$$")
    tmp_q_sum=$(mktemp 2>/dev/null || echo "/tmp/zsm_tst_qsum_$$")

    analyze_zimbra_log "$tmp_log_stats" "$tmp_sys_sum"
    analyze_postfix_queue "$tmp_q_stats" "$tmp_q_sum"

    local sys_summary sys_tot sys_snt sys_def sys_bnc
    sys_summary=$(cat "$tmp_sys_sum" 2>/dev/null || echo "0|0|0|0")
    IFS='|' read -r sys_tot sys_snt sys_def sys_bnc <<< "$sys_summary"

    local q_summary total_queue active_queue def_queue hold_queue
    q_summary=$(cat "$tmp_q_sum" 2>/dev/null || echo "0|0|0|0")
    IFS='|' read -r total_queue active_queue def_queue hold_queue <<< "$q_summary"

    rm -f "$tmp_log_stats" "$tmp_sys_sum" "$tmp_q_stats" "$tmp_q_sum"

    echo "Sending test alert from ${srv_host} (${srv_ip})..."
    echo " - Config File      : ${CONFIG_FILE}"
    echo " - Check Interval   : ${LOOKBACK_MINUTES} mins (Cooldown: ${ALERT_COOLDOWN_MINUTES} mins)"
    echo " - Telegram Enabled : ${TELEGRAM_ENABLED} (Chat ID: ${TELEGRAM_CHAT_ID:-Not set})"
    echo " - Email Enabled    : ${EMAIL_ENABLED} (Recipient: ${RESOLVED_EMAIL_TO})"

    local test_tg_msg
    test_tg_msg=$(cat <<EOF
<b>[ZIMBRA SPAM MONITOR - TEST]</b>
<code>==============================</code>
<b>Server       :</b> <code>$(html_escape "$srv_host")</code> (${srv_ip})
<b>Alert Time   :</b> ${now_str}
<b>Check Range  :</b> Last ${LOOKBACK_MINUTES} mins (Repeat: ${ALERT_COOLDOWN_MINUTES}m)

<b>[1] SYSTEM TOTAL TRAFFIC</b>
<b>Total Traffic:</b> <b>${sys_tot}</b> emails
  <code>Sent: ${sys_snt} | Deferred: ${sys_def} | Bounced: ${sys_bnc}</code>

<b>[2] REMAINING MAIL QUEUE</b>
<b>System Queue :</b> <b>${total_queue}</b> emails
  <code>Active: ${active_queue} | Deferred: ${def_queue} | Hold: ${hold_queue}</code>
<code>==============================</code>
EOF
)

    local tg_rc=0
    if [[ "$TELEGRAM_ENABLED" == "true" ]]; then
        if send_telegram_alert "$test_tg_msg"; then
            echo " [OK] Test Telegram message sent successfully!"
        else
            echo " [ERROR] Failed to send Telegram alert. Check TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID."
            tg_rc=1
        fi
    fi

    local mail_rc=0
    if [[ "$EMAIL_ENABLED" == "true" ]]; then
        local test_mail_body
        test_mail_body=$(cat <<EOF
============================================================
         ZIMBRA SPAM MONITOR - TEST NOTIFICATION
============================================================
Server        : ${srv_host} (${srv_ip})
Alert Time    : ${now_str}
Check Range   : Last ${LOOKBACK_MINUTES} mins (Repeat: ${ALERT_COOLDOWN_MINUTES}m)

------------------------------------------------------------
[1] SYSTEM TOTAL TRAFFIC
------------------------------------------------------------
Total Traffic : ${sys_tot} emails
                Sent: ${sys_snt} | Deferred: ${sys_def} | Bounced: ${sys_bnc}

------------------------------------------------------------
[2] REMAINING MAIL QUEUE
------------------------------------------------------------
System Queue  : ${total_queue} emails
                Active: ${active_queue} | Deferred: ${def_queue} | Hold: ${hold_queue}
============================================================
EOF
)
        if send_email_alert "[Zimbra Spam Monitor] Test Notification from ${srv_host}" "$test_mail_body" 0; then
            echo " [OK] Test Email sent successfully to ${RESOLVED_EMAIL_TO}!"
        else
            echo " [ERROR] Failed to send Email alert. Check Postfix or external SMTP settings."
            mail_rc=1
        fi
    fi

    return $(( tg_rc + mail_rc ))
}

unlock_account() {
    local target="$1"
    if [[ -z "$target" ]]; then
        echo "Usage: zimbra-spam-monitor --unlock <email@domain.com>"
        return 1
    fi
    load_config
    echo "Unlocking Zimbra account ${target}..."
    if [[ -n "$ZSM_ZMPROV_CMD" ]]; then
        $ZSM_ZMPROV_CMD ma "$target" zimbraAccountStatus active
    elif [[ -x /opt/zimbra/bin/zmprov ]]; then
        su - zimbra -c "/opt/zimbra/bin/zmprov ma '$target' zimbraAccountStatus active"
    else
        echo "Error: /opt/zimbra/bin/zmprov not found on this server."
        return 1
    fi
    clear_alert_state "$target"
    log_msg "INFO" "Admin unlocked account $target, cleared cooldown, and recorded unlock cutoff timestamp"
    echo "[OK] Account ${target} is now 'active'. Alert cooldown cleared and prior log history ignored."
}

# ==============================================================================
# CRON SCHEDULE MANAGEMENT (/etc/cron.d/zimbra-spam-monitor)
# ==============================================================================
get_current_cron_interval() {
    if [[ ! -f "$CRON_FILE" ]]; then
        echo "Not configured"
        return
    fi
    if grep -q "^#.*zimbra-spam-monitor" "$CRON_FILE" 2>/dev/null; then
        echo "Paused"
        return
    fi
    local spec
    spec=$(awk '/zimbra-spam-monitor/ && !/^#/ {print $1}' "$CRON_FILE" 2>/dev/null | head -n 1)
    case "$spec" in
        "*"|"*/1") echo "Every 1 min" ;;
        "*/2")     echo "Every 2 mins" ;;
        "*/5")     echo "Every 5 mins" ;;
        "*/10")    echo "Every 10 mins" ;;
        "*/15")    echo "Every 15 mins" ;;
        "*/30")    echo "Every 30 mins" ;;
        *)         echo "${spec:-Every 5 mins}" ;;
    esac
}

set_cron_interval_minutes() {
    local mins="$1"
    local cron_dir
    cron_dir=$(dirname "$CRON_FILE")
    mkdir -p "$cron_dir" 2>/dev/null || true

    if [[ "$mins" == "disable" ]]; then
        cat <<EOF > "$CRON_FILE"
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin:/opt/zimbra/common/sbin:/opt/zimbra/bin
# */5 * * * * root /usr/bin/zimbra-spam-monitor --run >/dev/null 2>&1
EOF
        log_msg "INFO" "Paused automatic cron schedule in $CRON_FILE"
        return 0
    fi

    cat <<EOF > "$CRON_FILE"
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin:/opt/zimbra/common/sbin:/opt/zimbra/bin
*/${mins} * * * * root /usr/bin/zimbra-spam-monitor --run >/dev/null 2>&1
EOF
    chmod 0644 "$CRON_FILE" 2>/dev/null || true
    log_msg "INFO" "Updated cron schedule to every ${mins} minute(s)"
}

# ==============================================================================
# INTERACTIVE CONTROL PANEL (TUI DIALOG & NUMBER MENU - 100% ASCII ENGLISH)
# ==============================================================================
detect_tui_bin() {
    if [[ "$ZSM_UI_MODE" == "text" ]]; then
        echo ""
        return
    fi
    if [[ -t 0 && -t 1 ]]; then
        if command -v whiptail >/dev/null 2>&1; then
            echo "whiptail"
            return
        elif command -v dialog >/dev/null 2>&1; then
            echo "dialog"
            return
        fi
    fi
    echo ""
}

ui_select_menu() {
    local title="$1"
    local prompt="$2"
    shift 2
    local items=("$@")

    local tui_bin
    tui_bin=$(detect_tui_bin)

    if [[ -n "$tui_bin" ]]; then
        local choice
        choice=$("$tui_bin" --title "$title" --backtitle "Zimbra Outbound Spam Monitor v${VERSION} - $(get_server_hostname)" \
            --menu "$prompt\n(Use UP/DOWN arrow keys to select, ENTER to confirm)" 22 78 12 \
            "${items[@]}" 3>&1 1>&2 2>&3) || {
            echo "0"
            return
        }
        echo "$choice"
        return
    fi

    echo "" >&2
    echo -e "${C_CYAN}==============================================================================${C_RESET}" >&2
    echo -e " ${C_BOLD}${title}${C_RESET}" >&2
    echo -e "${C_CYAN}------------------------------------------------------------------------------${C_RESET}" >&2
    echo -e " ${prompt}" >&2
    echo -e "${C_CYAN}------------------------------------------------------------------------------${C_RESET}" >&2

    local i=0
    local total=${#items[@]}
    while (( i < total )); do
        local tag="${items[$i]}"
        local desc="${items[$((i+1))]}"
        printf "  ${C_YELLOW}[%-2s]${C_RESET} %s\n" "$tag" "$desc" >&2
        i=$(( i + 2 ))
    done
    echo -e "${C_CYAN}==============================================================================${C_RESET}" >&2
    local sel=""
    if ! read -r -p " -> Select option number and press Enter [0 to Back/Exit]: " sel; then
        echo "0"
        return
    fi
    echo "${sel:-0}"
}

ui_input_box() {
    local title="$1"
    local prompt="$2"
    local default_val="$3"

    local tui_bin
    tui_bin=$(detect_tui_bin)

    if [[ -n "$tui_bin" ]]; then
        local val
        if val=$("$tui_bin" --title "$title" --backtitle "Zimbra Outbound Spam Monitor v${VERSION}" \
            --inputbox "$prompt" 12 72 "$default_val" 3>&1 1>&2 2>&3); then
            echo "$val"
        else
            echo "$default_val"
        fi
        return
    fi

    echo "" >&2
    echo -e "${C_BOLD}[${title}]${C_RESET} ${prompt}" >&2
    local val=""
    if ! read -r -p " -> Enter new value (Press Enter to keep [${default_val}]): " val; then
        echo "$default_val"
        return
    fi
    if [[ -z "$val" ]]; then
        echo "$default_val"
    else
        echo "$val"
    fi
}

ui_msg_box() {
    local title="$1"
    local text="$2"

    local tui_bin
    tui_bin=$(detect_tui_bin)

    if [[ -n "$tui_bin" ]]; then
        "$tui_bin" --title "$title" --backtitle "Zimbra Outbound Spam Monitor v${VERSION}" \
            --msgbox "$text" 18 76
        return
    fi

    echo "" >&2
    echo -e "${C_GREEN}------------------------------------------------------------------------------${C_RESET}" >&2
    echo -e " ${C_BOLD}${title}${C_RESET}" >&2
    echo -e "${C_GREEN}------------------------------------------------------------------------------${C_RESET}" >&2
    echo -e "$text" >&2
    echo -e "${C_GREEN}------------------------------------------------------------------------------${C_RESET}" >&2
    read -r -p " Press Enter to continue..." _ || true
}

