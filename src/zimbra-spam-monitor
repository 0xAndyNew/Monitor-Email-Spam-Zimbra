#!/usr/bin/env bash
# ==============================================================================
# ZIMBRA OUTBOUND SPAM MONITOR & ALERT SYSTEM (zimbra-spam-monitor)
# Version: 1.1.0
# Hỗ trợ: RHEL / CentOS / Rocky / AlmaLinux (.rpm) & Ubuntu / Debian (.deb)
#
# Chức năng:
# 1. Giao diện Bảng điều khiển (TUI Hộp thoại chọn phím mũi tên & Menu chọn số)
# 2. Quét /var/log/zimbra.log đếm số lượng mail gửi ra ngoài theo Phút & theo Giờ
# 3. Kiểm tra hàng đợi Postfix (postqueue / mailq) theo từng tài khoản & toàn cục
# 4. Cảnh báo tức thời qua Telegram Bot API và Email (Postfix nội bộ / SMTP ngoài)
# 5. Tự động khóa tài khoản (zimbraAccountStatus locked) khi vượt ngưỡng Critical
# ==============================================================================

set -u

VERSION="1.1.0"
DEFAULT_CONFIG_FILE="/etc/zimbra-spam-monitor/config.conf"
CONFIG_FILE="${ZSM_CONFIG_FILE:-$DEFAULT_CONFIG_FILE}"
CRON_FILE="${ZSM_CRON_FILE:-/etc/cron.d/zimbra-spam-monitor}"

# ==============================================================================
# CẤU HÌNH MẶC ĐỊNH (Sẽ được ghi đè bởi /etc/zimbra-spam-monitor/config.conf)
# ==============================================================================
MONITOR_ENABLED="true"
ZIMBRA_LOG_FILE="/var/log/zimbra.log"
LOG_TAIL_LINES=100000
COUNT_INTERNAL_TO_INTERNAL="false"
INTERNAL_DOMAINS="auto"

LOOKBACK_MINUTES=10
WARN_SENT_PER_WINDOW=80
CRIT_SENT_PER_WINDOW=200

ENABLE_HOURLY_CHECK="true"
WARN_SENT_PER_HOUR=300
CRIT_SENT_PER_HOUR=600

WARN_QUEUE_PER_USER=40
CRIT_QUEUE_PER_USER=100
WARN_TOTAL_QUEUE=300

AUTO_LOCK_ON_CRITICAL="true"
AUTO_HOLD_QUEUE_ON_CRITICAL="false"

TELEGRAM_ENABLED="true"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

EMAIL_ENABLED="true"
EMAIL_DELIVERY_MODE="auto"
ALERT_EMAIL_TO="auto"
ALERT_EMAIL_FROM="auto"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_TLS="true"

ALERT_COOLDOWN_MINUTES=30
WHITELIST_FILE="/etc/zimbra-spam-monitor/whitelist.conf"
STATE_DIR="/var/lib/zimbra-spam-monitor"
MONITOR_LOG_FILE="/var/log/zimbra-spam-monitor.log"

# Biến phục vụ kiểm thử (Mock/Test overrides)
ZSM_NOW_EPOCH="${ZSM_NOW_EPOCH:-}"
ZSM_POSTQUEUE_CMD="${ZSM_POSTQUEUE_CMD:-}"
ZSM_ZMPROV_CMD="${ZSM_ZMPROV_CMD:-}"
ZSM_SENDMAIL_CMD="${ZSM_SENDMAIL_CMD:-}"
ZSM_CURL_CMD="${ZSM_CURL_CMD:-curl}"
ZSM_HOSTNAME="${ZSM_HOSTNAME:-}"
ZSM_UI_MODE="${ZSM_UI_MODE:-auto}" # "auto", "tui" (whiptail/dialog), hoặc "text" (menu chọn số)

# Màu sắc hiển thị cho giao diện Menu
if [[ -t 1 ]]; then
    C_RESET="\033[0m"
    C_BOLD="\033[1m"
    C_GREEN="\033[1;32m"
    C_RED="\033[1;31m"
    C_YELLOW="\033[1;33m"
    C_CYAN="\033[1;36m"
    C_BLUE="\033[1;34m"
else
    C_RESET=""
    C_BOLD=""
    C_GREEN=""
    C_RED=""
    C_YELLOW=""
    C_CYAN=""
    C_BLUE=""
fi

# ==============================================================================
# HÀM TIỆN ÍCH & ĐỌC/GHI CẤU HÌNH
# ==============================================================================
load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        local tmp_cfg
        tmp_cfg=$(mktemp 2>/dev/null || echo "/tmp/zsm_cfg_$$")
        tr -d '\r' < "$CONFIG_FILE" > "$tmp_cfg"
        # shellcheck disable=SC1090
        source "$tmp_cfg"
        rm -f "$tmp_cfg"
    fi
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    local log_dir
    log_dir=$(dirname "$MONITOR_LOG_FILE")
    mkdir -p "$log_dir" 2>/dev/null || true
}

ensure_config_file_exists() {
    local cfg_dir
    cfg_dir=$(dirname "$CONFIG_FILE")
    mkdir -p "$cfg_dir" 2>/dev/null || true
    if [[ ! -f "$CONFIG_FILE" ]]; then
        cat <<EOF > "$CONFIG_FILE"
MONITOR_ENABLED="${MONITOR_ENABLED}"
ZIMBRA_LOG_FILE="${ZIMBRA_LOG_FILE}"
LOG_TAIL_LINES=${LOG_TAIL_LINES}
COUNT_INTERNAL_TO_INTERNAL="${COUNT_INTERNAL_TO_INTERNAL}"
INTERNAL_DOMAINS="${INTERNAL_DOMAINS}"
LOOKBACK_MINUTES=${LOOKBACK_MINUTES}
WARN_SENT_PER_WINDOW=${WARN_SENT_PER_WINDOW}
CRIT_SENT_PER_WINDOW=${CRIT_SENT_PER_WINDOW}
ENABLE_HOURLY_CHECK="${ENABLE_HOURLY_CHECK}"
WARN_SENT_PER_HOUR=${WARN_SENT_PER_HOUR}
CRIT_SENT_PER_HOUR=${CRIT_SENT_PER_HOUR}
WARN_QUEUE_PER_USER=${WARN_QUEUE_PER_USER}
CRIT_QUEUE_PER_USER=${CRIT_QUEUE_PER_USER}
WARN_TOTAL_QUEUE=${WARN_TOTAL_QUEUE}
AUTO_LOCK_ON_CRITICAL="${AUTO_LOCK_ON_CRITICAL}"
AUTO_HOLD_QUEUE_ON_CRITICAL="${AUTO_HOLD_QUEUE_ON_CRITICAL}"
TELEGRAM_ENABLED="${TELEGRAM_ENABLED}"
TELEGRAM_BOT_TOKEN="${TELEGRAM_BOT_TOKEN}"
TELEGRAM_CHAT_ID="${TELEGRAM_CHAT_ID}"
EMAIL_ENABLED="${EMAIL_ENABLED}"
EMAIL_DELIVERY_MODE="${EMAIL_DELIVERY_MODE}"
ALERT_EMAIL_TO="${ALERT_EMAIL_TO}"
ALERT_EMAIL_FROM="${ALERT_EMAIL_FROM}"
SMTP_HOST="${SMTP_HOST}"
SMTP_PORT="${SMTP_PORT}"
SMTP_USER="${SMTP_USER}"
SMTP_PASS="${SMTP_PASS}"
SMTP_TLS="${SMTP_TLS}"
ALERT_COOLDOWN_MINUTES=${ALERT_COOLDOWN_MINUTES}
WHITELIST_FILE="${WHITELIST_FILE}"
STATE_DIR="${STATE_DIR}"
MONITOR_LOG_FILE="${MONITOR_LOG_FILE}"
EOF
    fi
}

update_cfg_var() {
    local key="$1"
    local val="$2"
    ensure_config_file_exists
    if grep -q "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=\"${val}\"|" "$CONFIG_FILE"
    else
        echo "${key}=\"${val}\"" >> "$CONFIG_FILE"
    fi
    load_config
}

update_cfg_num() {
    local key="$1"
    local val="$2"
    ensure_config_file_exists
    if grep -q "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${val}|" "$CONFIG_FILE"
    else
        echo "${key}=${val}" >> "$CONFIG_FILE"
    fi
    load_config
}

log_msg() {
    local level="$1"
    shift
    local msg="$*"
    local ts
    ts=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$ts] [$level] $msg" >> "$MONITOR_LOG_FILE" 2>/dev/null || true
}

get_server_hostname() {
    if [[ -n "$ZSM_HOSTNAME" ]]; then
        echo "$ZSM_HOSTNAME"
        return
    fi
    local hn=""
    if [[ -f /opt/zimbra/conf/localconfig.xml ]]; then
        hn=$(awk -F'[<>]' '/name="zimbra_server_hostname"/{getline; if ($2 == "value") print $3}' /opt/zimbra/conf/localconfig.xml 2>/dev/null | head -n 1)
    fi
    if [[ -z "$hn" ]]; then
        hn=$(hostname -f 2>/dev/null || hostname 2>/dev/null || echo "zimbra-server")
    fi
    echo "$hn"
}

get_server_ip() {
    local ip=""
    ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    if [[ -z "$ip" ]]; then
        ip="127.0.0.1"
    fi
    echo "$ip"
}

resolve_zimbra_Settings() {
    local default_domain=""
    local srv_host
    srv_host=$(get_server_hostname)
    if [[ "$srv_host" == *.*.* ]]; then
        default_domain="${srv_host#*.}"
    else
        default_domain="$srv_host"
    fi

    local xml_dest=""
    local xml_src=""
    if [[ -f /opt/zimbra/conf/localconfig.xml ]]; then
        xml_dest=$(awk -F'[<>]' '/name="smtp_destination"/{getline; if ($2 == "value") print $3}' /opt/zimbra/conf/localconfig.xml 2>/dev/null | head -n 1)
        xml_src=$(awk -F'[<>]' '/name="smtp_source"/{getline; if ($2 == "value") print $3}' /opt/zimbra/conf/localconfig.xml 2>/dev/null | head -n 1)
    fi

    if [[ "$ALERT_EMAIL_TO" == "auto" || -z "$ALERT_EMAIL_TO" ]]; then
        if [[ -n "$xml_dest" ]]; then
            RESOLVED_EMAIL_TO="$xml_dest"
        else
            RESOLVED_EMAIL_TO="admin@${default_domain}"
        fi
    else
        RESOLVED_EMAIL_TO="$ALERT_EMAIL_TO"
    fi

    if [[ "$ALERT_EMAIL_FROM" == "auto" || -z "$ALERT_EMAIL_FROM" ]]; then
        if [[ -n "$xml_src" ]]; then
            RESOLVED_EMAIL_FROM="$xml_src"
        else
            RESOLVED_EMAIL_FROM="zimbra-monitor@${default_domain}"
        fi
    else
        RESOLVED_EMAIL_FROM="$ALERT_EMAIL_FROM"
    fi

    if [[ "$INTERNAL_DOMAINS" == "auto" || -z "$INTERNAL_DOMAINS" ]]; then
        RESOLVED_INTERNAL_DOMAINS="$default_domain $srv_host"
        if [[ -n "$xml_dest" && "$xml_dest" == *@* ]]; then
            RESOLVED_INTERNAL_DOMAINS="$RESOLVED_INTERNAL_DOMAINS ${xml_dest#*@}"
        fi
    else
        RESOLVED_INTERNAL_DOMAINS="$INTERNAL_DOMAINS"
    fi
}

find_postqueue_bin() {
    if [[ -n "$ZSM_POSTQUEUE_CMD" ]]; then
        echo "$ZSM_POSTQUEUE_CMD"
        return
    fi
    for p in /opt/zimbra/common/sbin/postqueue /opt/zimbra/postfix/sbin/postqueue /usr/sbin/postqueue; do
        if [[ -x "$p" ]]; then
            echo "$p"
            return
        fi
    done
    if command -v postqueue >/dev/null 2>&1; then
        command -v postqueue
        return
    fi
    echo ""
}

find_sendmail_bin() {
    if [[ -n "$ZSM_SENDMAIL_CMD" ]]; then
        echo "$ZSM_SENDMAIL_CMD"
        return
    fi
    for p in /opt/zimbra/common/sbin/sendmail /opt/zimbra/postfix/sbin/sendmail /usr/sbin/sendmail; do
        if [[ -x "$p" ]]; then
            echo "$p"
            return
        fi
    done
    if command -v sendmail >/dev/null 2>&1; then
        command -v sendmail
        return
    fi
    echo ""
}

is_whitelisted() {
    local email
    email=$(echo "$1" | tr '[:upper:]' '[:lower:]')
    [[ -z "$email" ]] && return 0
    [[ ! -f "$WHITELIST_FILE" ]] && return 1

    local domain=""
    if [[ "$email" == *@* ]]; then
        domain="@${email#*@}"
    fi

    while IFS= read -r line || [[ -n "$line" ]]; do
        line=$(echo "$line" | tr -d '\r' | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//' | tr '[:upper:]' '[:lower:]')
        [[ -z "$line" ]] && continue
        if [[ "$line" == "$email" ]]; then
            return 0
        fi
        if [[ -n "$domain" && "$line" == "$domain" ]]; then
            return 0
        fi
    done < "$WHITELIST_FILE"

    return 1
}

# ==============================================================================
# CƠ CHẾ COOLDOWN & LỊCH SỬ KHÓA TÀI KHOẢN
# ==============================================================================
should_send_alert() {
    local sender="$1"
    local severity="$2"
    local state_file="$STATE_DIR/cooldown.db"
    local now_ts
    now_ts="${ZSM_NOW_EPOCH:-$(date +%s)}"
    local cooldown_sec=$(( ALERT_COOLDOWN_MINUTES * 60 ))

    [[ ! -f "$state_file" ]] && return 0

    local prev_line
    prev_line=$(grep -F "^${sender}|" "$state_file" 2>/dev/null | tail -n 1 || true)
    if [[ -z "$prev_line" ]]; then
        return 0
    fi

    local prev_sev prev_ts
    prev_sev=$(echo "$prev_line" | cut -d'|' -f2)
    prev_ts=$(echo "$prev_line" | cut -d'|' -f3)

    if [[ "$severity" == "CRITICAL" && "$prev_sev" != "CRITICAL" ]]; then
        return 0
    fi

    if [[ -n "$prev_ts" ]] && (( now_ts - prev_ts < cooldown_sec )); then
        return 1
    fi
    return 0
}

record_alert_state() {
    local sender="$1"
    local severity="$2"
    local state_file="$STATE_DIR/cooldown.db"
    local now_ts
    now_ts="${ZSM_NOW_EPOCH:-$(date +%s)}"

    mkdir -p "$STATE_DIR" 2>/dev/null || true
    if [[ -f "$state_file" ]]; then
        grep -v -F "^${sender}|" "$state_file" > "${state_file}.tmp" 2>/dev/null || true
        mv -f "${state_file}.tmp" "$state_file"
    fi
    echo "^${sender}|${severity}|${now_ts}" >> "$state_file"
}

clear_alert_state() {
    local sender="$1"
    local state_file="$STATE_DIR/cooldown.db"
    if [[ -f "$state_file" ]]; then
        grep -v -F "^${sender}|" "$state_file" > "${state_file}.tmp" 2>/dev/null || true
        mv -f "${state_file}.tmp" "$state_file"
    fi
    local locked_file="$STATE_DIR/locked_accounts.db"
    if [[ -f "$locked_file" ]]; then
        grep -v -i "^${sender}|" "$locked_file" > "${locked_file}.tmp" 2>/dev/null || true
        mv -f "${locked_file}.tmp" "$locked_file"
    fi
}

record_locked_account() {
    local sender="$1"
    local locked_file="$STATE_DIR/locked_accounts.db"
    local ts_str
    ts_str=$(date '+%Y-%m-%d %H:%M:%S')
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    if [[ -f "$locked_file" ]]; then
        grep -v -i "^${sender}|" "$locked_file" > "${locked_file}.tmp" 2>/dev/null || true
        mv -f "${locked_file}.tmp" "$locked_file"
    fi
    echo "${sender}|${ts_str}" >> "$locked_file"
}

# ==============================================================================
# TỰ ĐỘNG KHÓA TÀI KHOẢN ZIMBRA & TẠM GIỮ HÀNG ĐỢI KHI CRITICAL
# ==============================================================================
lock_zimbra_account() {
    local account="$1"
    if [[ "$AUTO_LOCK_ON_CRITICAL" != "true" ]]; then
        echo "Không tự khóa (AUTO_LOCK_ON_CRITICAL=false)"
        return 0
    fi

    log_msg "CRITICAL" "Thực hiện khóa tự động tài khoản spam: $account"

    if [[ -n "$ZSM_ZMPROV_CMD" ]]; then
        if $ZSM_ZMPROV_CMD ma "$account" zimbraAccountStatus locked >/dev/null 2>&1; then
            record_locked_account "$account"
            echo "Đã tự động khóa tài khoản (zimbraAccountStatus = locked)"
            return 0
        else
            echo "Lỗi khi gọi lệnh khóa tài khoản ($ZSM_ZMPROV_CMD)"
            return 1
        fi
    fi

    if [[ -x /opt/zimbra/bin/zmprov ]]; then
        if su - zimbra -c "/opt/zimbra/bin/zmprov ma '$account' zimbraAccountStatus locked" >/dev/null 2>&1; then
            record_locked_account "$account"
            echo "Đã tự động khóa tài khoản (zimbraAccountStatus = locked)"
            return 0
        else
            echo "Thực thi lệnh khóa thất bại (Kiểm tra quyền su - zimbra)"
            return 1
        fi
    else
        echo "Không tìm thấy /opt/zimbra/bin/zmprov để khóa tự động"
        return 1
    fi
}

hold_sender_queue() {
    local sender="$1"
    [[ "$AUTO_HOLD_QUEUE_ON_CRITICAL" != "true" ]] && return 0

    local pq_bin
    pq_bin=$(find_postqueue_bin)
    [[ -z "$pq_bin" ]] && return 0

    local postsuper_bin=""
    for p in /opt/zimbra/common/sbin/postsuper /opt/zimbra/postfix/sbin/postsuper /usr/sbin/postsuper; do
        [[ -x "$p" ]] && postsuper_bin="$p" && break
    done
    [[ -z "$postsuper_bin" ]] && return 0

    $pq_bin -p 2>/dev/null | awk -v target="$sender" '
        /^[0-9A-F]+[*!]?[[:space:]]/ {
            qid=$1; sub(/[*!]$/, "", qid); s=tolower($7);
            if (s == tolower(target)) print qid
        }
    ' | $postsuper_bin -h - >/dev/null 2>&1 || true
    log_msg "CRITICAL" "Đã chuyển sang chế độ HOLD các email trong queue của $sender"
}

# ==============================================================================
# GỬI THÔNG BÁO QUA TELEGRAM & EMAIL
# ==============================================================================
html_escape() {
    local s="$1"
    s="${s//&/&amp;}"
    s="${s//</&lt;}"
    s="${s//>/&gt;}"
    echo "$s"
}

send_telegram_alert() {
    local message_html="$1"
    if [[ "$TELEGRAM_ENABLED" != "true" ]]; then
        return 0
    fi
    if [[ -z "$TELEGRAM_BOT_TOKEN" || -z "$TELEGRAM_CHAT_ID" ]]; then
        log_msg "WARN" "Telegram đang bật nhưng chưa cấu hình TELEGRAM_BOT_TOKEN hoặc TELEGRAM_CHAT_ID"
        return 1
    fi

    local url="https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage"
    local resp
    resp=$($ZSM_CURL_CMD -sS -m 15 -X POST "$url" \
        -d "chat_id=${TELEGRAM_CHAT_ID}" \
        -d "parse_mode=HTML" \
        -d "disable_web_page_preview=true" \
        --data-urlencode "text=${message_html}" 2>&1)

    if echo "$resp" | grep -q '"ok":true'; then
        log_msg "INFO" "Đã gửi cảnh báo Telegram thành công tới Chat ID ${TELEGRAM_CHAT_ID}"
        return 0
    else
        log_msg "ERROR" "Gửi cảnh báo Telegram thất bại: $resp"
        return 1
    fi
}

send_email_via_local_sendmail() {
    local subject="$1"
    local body_text="$2"
    local sm_bin
    sm_bin=$(find_sendmail_bin)
    if [[ -z "$sm_bin" ]]; then
        log_msg "ERROR" "Không tìm thấy lệnh sendmail trên hệ thống"
        return 1
    fi

    local email_payload
    email_payload=$(cat <<EOF
From: Zimbra Spam Monitor <${RESOLVED_EMAIL_FROM}>
To: ${RESOLVED_EMAIL_TO}
Subject: ${subject}
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

${body_text}
EOF
)
    if printf "%s\n" "$email_payload" | $sm_bin -t >/dev/null 2>&1; then
        log_msg "INFO" "Đã gửi Email cảnh báo (Local Postfix) tới ${RESOLVED_EMAIL_TO}"
        return 0
    else
        log_msg "ERROR" "Gửi Email qua Local Postfix thất bại"
        return 1
    fi
}

send_email_via_external_smtp() {
    local subject="$1"
    local body_text="$2"

    if [[ -z "$SMTP_HOST" || -z "$SMTP_USER" || -z "$SMTP_PASS" ]]; then
        log_msg "WARN" "Chưa cấu hình đầy đủ SMTP_HOST / SMTP_USER / SMTP_PASS cho SMTP ngoài"
        return 1
    fi

    local proto="smtp"
    [[ "$SMTP_PORT" == "465" ]] && proto="smtps"
    local smtp_url="${proto}://${SMTP_HOST}:${SMTP_PORT}"

    local tls_flag=""
    if [[ "$SMTP_TLS" == "true" ]]; then
        tls_flag="--ssl-reqd"
    fi

    local tmp_mail
    tmp_mail=$(mktemp 2>/dev/null || echo "/tmp/zsm_mail_$$")
    cat <<EOF > "$tmp_mail"
From: Zimbra Spam Monitor <${SMTP_USER}>
To: ${RESOLVED_EMAIL_TO}
Subject: ${subject}
Date: $(date -R 2>/dev/null || date)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

${body_text}
EOF

    local rcpt_args=()
    IFS=',' read -ra ADDR_LIST <<< "$RESOLVED_EMAIL_TO"
    for addr in "${ADDR_LIST[@]}"; do
        addr=$(echo "$addr" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        [[ -n "$addr" ]] && rcpt_args+=(--mail-rcpt "$addr")
    done

    # shellcheck disable=SC2086
    if $ZSM_CURL_CMD -sS -m 20 --url "$smtp_url" $tls_flag \
        --mail-from "$SMTP_USER" \
        "${rcpt_args[@]}" \
        --user "${SMTP_USER}:${SMTP_PASS}" \
        -T "$tmp_mail" >/dev/null 2>&1; then
        rm -f "$tmp_mail"
        log_msg "INFO" "Đã gửi Email cảnh báo (External SMTP ${SMTP_HOST}) tới ${RESOLVED_EMAIL_TO}"
        return 0
    else
        rm -f "$tmp_mail"
        log_msg "ERROR" "Gửi Email qua External SMTP (${SMTP_HOST}:${SMTP_PORT}) thất bại"
        return 1
    fi
}

send_email_alert() {
    local subject="$1"
    local body_text="$2"
    local total_queue="${3:-0}"

    if [[ "$EMAIL_ENABLED" != "true" ]]; then
        return 0
    fi

    resolve_zimbra_Settings

    if [[ "$EMAIL_DELIVERY_MODE" == "smtp" ]]; then
        send_email_via_external_smtp "$subject" "$body_text"
        return $?
    elif [[ "$EMAIL_DELIVERY_MODE" == "local" ]]; then
        send_email_via_local_sendmail "$subject" "$body_text"
        return $?
    else
        if (( total_queue >= WARN_TOTAL_QUEUE )) && [[ -n "$SMTP_HOST" && -n "$SMTP_USER" ]]; then
            if send_email_via_external_smtp "$subject" "$body_text"; then
                return 0
            fi
        fi
        if send_email_via_local_sendmail "$subject" "$body_text"; then
            return 0
        fi
        if [[ -n "$SMTP_HOST" && -n "$SMTP_USER" ]]; then
            send_email_via_external_smtp "$subject" "$body_text"
            return $?
        fi
        return 1
    fi
}

# ==============================================================================
# PHÂN TÍCH LOG ZIMBRA (/var/log/zimbra.log) & HÀNG ĐỢI POSTFIX (postqueue)
# ==============================================================================
analyze_zimbra_log() {
    local out_file="$1"
    : > "$out_file"

    if [[ ! -f "$ZIMBRA_LOG_FILE" ]]; then
        log_msg "WARN" "Không tìm thấy file log Zimbra: $ZIMBRA_LOG_FILE"
        return 0
    fi

    resolve_zimbra_Settings
    local now_epoch="${ZSM_NOW_EPOCH:-$(date +%s)}"
    local cur_year
    cur_year=$(date -d "@$now_epoch" '+%Y' 2>/dev/null || date '+%Y')

    tail -n "$LOG_TAIL_LINES" "$ZIMBRA_LOG_FILE" 2>/dev/null | awk \
        -v now_epoch="$now_epoch" \
        -v cur_year="$cur_year" \
        -v win_mins="$LOOKBACK_MINUTES" \
        -v count_internal="$COUNT_INTERNAL_TO_INTERNAL" \
        -v internal_domains="$RESOLVED_INTERNAL_DOMAINS" '
    BEGIN {
        win_cutoff = now_epoch - (win_mins * 60)
        hour_cutoff = now_epoch - 3600

        split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", mnames, " ")
        for (i = 1; i <= 12; i++) {
            m_map[mnames[i]] = sprintf("%02d", i)
        }

        n_dom = split(tolower(internal_domains), dom_arr, /[[:space:],]+/)
        for (i = 1; i <= n_dom; i++) {
            if (dom_arr[i] != "") int_dom[dom_arr[i]] = 1
        }
    }

    function parse_epoch(line,   mo, dy, hms, y, hr, mi, sc, iso, ts) {
        if (match(line, /^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}/)) {
            iso = substr(line, 1, 19)
            y  = substr(iso, 1, 4)
            mo = substr(iso, 6, 2)
            dy = substr(iso, 9, 2)
            hr = substr(iso, 12, 2)
            mi = substr(iso, 15, 2)
            sc = substr(iso, 18, 2)
            ts = mktime(y " " mo " " dy " " hr " " mi " " sc)
            return ts
        }
        if (($1 in m_map) && ($2 ~ /^[0-9]+$/) && ($3 ~ /^[0-9]{2}:[0-9]{2}:[0-9]{2}$/)) {
            mo = m_map[$1]
            dy = sprintf("%02d", $2 + 0)
            split($3, hms, ":")
            hr = hms[1]; mi = hms[2]; sc = hms[3]
            ts = mktime(cur_year " " mo " " dy " " hr " " mi " " sc)
            if (ts > now_epoch + 86400) {
                ts = mktime((cur_year - 1) " " mo " " dy " " hr " " mi " " sc)
            }
            return ts
        }
        return 0
    }

    function extract_domain(email,   idx) {
        idx = index(email, "@")
        if (idx > 0) return substr(email, idx + 1)
        return ""
    }

    {
        if (index($0, "postfix/") == 0) next

        ts = parse_epoch($0)
        if (ts > 0 && ts < hour_cutoff) next

        if (index($0, "sasl_username=") > 0) {
            qid = ""
            if (match($0, /: [0-9A-Za-z]+: client=/)) {
                qid = substr($0, RSTART + 2, RLENGTH - 10)
            }
            sasl = ""
            if (match($0, /sasl_username=[^ ,]+/)) {
                sasl = tolower(substr($0, RSTART + 14, RLENGTH - 14))
            }
            cip = ""
            if (match($0, /client=[^ ,]+/)) {
                cip = substr($0, RSTART + 7, RLENGTH - 7)
                if (match(cip, /\[[0-9a-fA-F.:]+\]/)) {
                    cip = substr(cip, RSTART + 1, RLENGTH - 2)
                }
            }
            if (qid != "" && sasl != "") {
                q_sasl[qid] = sasl
                q_time[qid] = ts
                if (cip != "") q_ip[qid] = cip
            }
            next
        }

        if (index($0, "postfix/qmgr") > 0 && index($0, "from=<") > 0) {
            qid = ""
            if (match($0, /: [0-9A-Za-z]+: from=</)) {
                qid = substr($0, RSTART + 2, RLENGTH - 9)
            }
            faddr = ""
            if (match($0, /from=<[^>]*>/)) {
                faddr = tolower(substr($0, RSTART + 6, RLENGTH - 7))
            }
            if (qid != "" && faddr != "") {
                q_from[qid] = faddr
                if (!(qid in q_time)) q_time[qid] = ts
            }
            next
        }

        if ((index($0, "postfix/smtp[") > 0 || index($0, "postfix/error[") > 0) && index($0, "to=<") > 0 && index($0, "status=") > 0) {
            qid = ""
            if (match($0, /: [0-9A-Za-z]+: to=</)) {
                qid = substr($0, RSTART + 2, RLENGTH - 7)
            }
            if (qid == "") next

            sender = ""
            if (qid in q_sasl) {
                sender = q_sasl[qid]
            } else if (qid in q_from) {
                sender = q_from[qid]
            }
            if (sender == "" || sender == "<>") next

            rcpt = ""
            if (match($0, /to=<[^>]+>/)) {
                rcpt = tolower(substr($0, RSTART + 4, RLENGTH - 5))
            }
            rdom = extract_domain(rcpt)

            if (count_internal != "true" && rdom != "" && (rdom in int_dom) && !(qid in q_sasl)) {
                next
            }

            st = "other"
            if (match($0, /status=[a-z]+/)) {
                st = substr($0, RSTART + 7, RLENGTH - 7)
            }

            all_senders[sender] = 1
            hour_total[sender]++
            if (st == "sent") hour_sent[sender]++
            else if (st == "deferred") hour_def[sender]++
            else if (st == "bounced") hour_bnc[sender]++

            if (ts >= win_cutoff) {
                win_total[sender]++
                if (st == "sent") win_sent[sender]++
                else if (st == "deferred") win_def[sender]++
                else if (st == "bounced") win_bnc[sender]++

                if ((qid in q_ip) && q_ip[qid] != "") {
                    ip_key = sender "|" q_ip[qid]
                    if (!(ip_key in seen_ip)) {
                        seen_ip[ip_key] = 1
                        sender_ips[sender] = (sender_ips[sender] == "" ? q_ip[qid] : sender_ips[sender] "," q_ip[qid])
                    }
                }
                if (rdom != "") {
                    dom_key = sender "|" rdom
                    if (!(dom_key in seen_dom) && dom_count[sender] < 5) {
                        seen_dom[dom_key] = 1
                        dom_count[sender]++
                        sender_doms[sender] = (sender_doms[sender] == "" ? rdom : sender_doms[sender] "," rdom)
                    }
                }
            }
        }
    }
    END {
        for (s in all_senders) {
            wt = win_total[s] + 0
            ws = win_sent[s] + 0
            wd = win_def[s] + 0
            wb = win_bnc[s] + 0
            ht = hour_total[s] + 0
            hs = hour_sent[s] + 0
            hd = hour_def[s] + 0
            hb = hour_bnc[s] + 0
            ips = (sender_ips[s] != "" ? sender_ips[s] : "local/webmail")
            doms = (sender_doms[s] != "" ? sender_doms[s] : "-")
            printf "%s|%d|%d|%d|%d|%d|%d|%d|%d|%s|%s\n", s, wt, ws, wd, wb, ht, hs, hd, hb, ips, doms
        }
    }
    ' | sort -t'|' -k2,2nr -k6,6nr > "$out_file"
}

analyze_postfix_queue() {
    local out_file="$1"
    local summary_file="$2"
    : > "$out_file"
    echo "0|0|0|0" > "$summary_file"

    local pq_bin
    pq_bin=$(find_postqueue_bin)
    if [[ -z "$pq_bin" ]]; then
        return 0
    fi

    $pq_bin -p 2>/dev/null | awk '
    BEGIN {
        total_q = 0; active_q = 0; hold_q = 0; def_q = 0
        cur_sender = ""; cur_reason = ""
    }
    /^[0-9A-F]+[*!]?[[:space:]]/ {
        qid_raw = $1
        sender = tolower($7)
        if (sender == "" || sender ~ /^from=/) next

        total_q++
        if (index(qid_raw, "*") > 0) active_q++
        else if (index(qid_raw, "!") > 0) hold_q++
        else def_q++

        if (sender != "mailer-daemon" && sender != "<>") {
            q_user[sender]++
            cur_sender = sender
        } else {
            cur_sender = ""
        }
        next
    }
    /^[[:space:]]+\(/ {
        if (cur_sender != "" && !(cur_sender in q_reason)) {
            r = $0
            sub(/^[[:space:]]+\(/, "", r)
            sub(/\)[[:space:]]*$/, "", r)
            gsub(/\|/, "/", r)
            if (length(r) > 90) r = substr(r, 1, 90) "..."
            q_reason[cur_sender] = r
        }
    }
    END {
        printf "%d|%d|%d|%d\n", total_q, active_q, def_q, hold_q > "'"$summary_file"'"
        for (u in q_user) {
            reason = (u in q_reason ? q_reason[u] : "Đang chờ gửi trong hàng đợi")
            printf "%s|%d|%s\n", u, q_user[u], reason
        }
    }
    ' | sort -t'|' -k2,2nr > "$out_file"
}

# ==============================================================================
# CHU TRÌNH KIỂM TRA CHÍNH (--run)
# ==============================================================================
run_monitor_cycle() {
    load_config
    if [[ "$MONITOR_ENABLED" != "true" ]]; then
        return 0
    fi

    local lock_file="$STATE_DIR/monitor.lock"
    if [[ -f "$lock_file" ]]; then
        local old_pid
        old_pid=$(cat "$lock_file" 2>/dev/null || echo "")
        if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
            log_msg "WARN" "Tiến trình quét trước đó (PID $old_pid) vẫn đang chạy, bỏ qua chu kỳ này."
            return 0
        fi
    fi
    echo $$ > "$lock_file"

    local tmp_log_stats tmp_q_stats tmp_q_sum tmp_merged
    tmp_log_stats=$(mktemp 2>/dev/null || echo "/tmp/zsm_log_$$")
    tmp_q_stats=$(mktemp 2>/dev/null || echo "/tmp/zsm_q_$$")
    tmp_q_sum=$(mktemp 2>/dev/null || echo "/tmp/zsm_qsum_$$")
    tmp_merged=$(mktemp 2>/dev/null || echo "/tmp/zsm_merged_$$")

    analyze_zimbra_log "$tmp_log_stats"
    analyze_postfix_queue "$tmp_q_stats" "$tmp_q_sum"

    local q_summary total_queue active_queue def_queue hold_queue
    q_summary=$(cat "$tmp_q_sum" 2>/dev/null || echo "0|0|0|0")
    total_queue=$(echo "$q_summary" | cut -d'|' -f1)
    active_queue=$(echo "$q_summary" | cut -d'|' -f2)
    def_queue=$(echo "$q_summary" | cut -d'|' -f3)
    hold_queue=$(echo "$q_summary" | cut -d'|' -f4)

    awk -F'|' '
    FNR == NR {
        s = $1
        if (s == "") next
        users[s] = 1
        wt[s] = $2; ws[s] = $3; wd[s] = $4; wb[s] = $5
        ht[s] = $6; hs[s] = $7; hd[s] = $8; hb[s] = $9
        ips[s] = $10; doms[s] = $11
        next
    }
    {
        s = $1
        if (s == "") next
        users[s] = 1
        qc[s] = $2
        qr[s] = $3
    }
    END {
        for (u in users) {
            printf "%s|%d|%d|%d|%d|%d|%d|%d|%d|%d|%s|%s|%s\n",
                u,
                wt[u]+0, ws[u]+0, wd[u]+0, wb[u]+0,
                ht[u]+0, hs[u]+0, hd[u]+0, hb[u]+0,
                qc[u]+0,
                (ips[u] != "" ? ips[u] : "-"),
                (doms[u] != "" ? doms[u] : "-"),
                (qr[u] != "" ? qr[u] : "-")
        }
    }
    ' "$tmp_log_stats" "$tmp_q_stats" | sort -t'|' -k2,2nr -k10,10nr > "$tmp_merged"

    local srv_host srv_ip now_str
    srv_host=$(get_server_hostname)
    srv_ip=$(get_server_ip)
    now_str=$(date '+%Y-%m-%d %H:%M:%S')
    local alerts_triggered=0

    while IFS='|' read -r sender win_tot win_snt win_def win_bnc hr_tot hr_snt hr_def hr_bnc q_cnt s_ips s_doms q_reason; do
        [[ -z "$sender" ]] && continue

        if is_whitelisted "$sender"; then
            continue
        fi

        local severity="NORMAL"
        local reasons=()

        if (( win_tot >= CRIT_SENT_PER_WINDOW )); then
            severity="CRITICAL"
            reasons+=("Gửi ${win_tot} mail trong ${LOOKBACK_MINUTES} phút (Ngưỡng Critical: ${CRIT_SENT_PER_WINDOW})")
        fi
        if [[ "$ENABLE_HOURLY_CHECK" == "true" ]] && (( hr_tot >= CRIT_SENT_PER_HOUR )); then
            severity="CRITICAL"
            reasons+=("Gửi ${hr_tot} mail trong 60 phút (Ngưỡng Critical: ${CRIT_SENT_PER_HOUR})")
        fi
        if (( q_cnt >= CRIT_QUEUE_PER_USER )); then
            severity="CRITICAL"
            reasons+=("Đang kẹt ${q_cnt} mail trong Queue (Ngưỡng Critical: ${CRIT_QUEUE_PER_USER})")
        fi

        if [[ "$severity" == "NORMAL" ]]; then
            if (( win_tot >= WARN_SENT_PER_WINDOW )); then
                severity="WARNING"
                reasons+=("Gửi ${win_tot} mail trong ${LOOKBACK_MINUTES} phút (Ngưỡng Warning: ${WARN_SENT_PER_WINDOW})")
            fi
            if [[ "$ENABLE_HOURLY_CHECK" == "true" ]] && (( hr_tot >= WARN_SENT_PER_HOUR )); then
                severity="WARNING"
                reasons+=("Gửi ${hr_tot} mail trong 60 phút (Ngưỡng Warning: ${WARN_SENT_PER_HOUR})")
            fi
            if (( q_cnt >= WARN_QUEUE_PER_USER )); then
                severity="WARNING"
                reasons+=("Đang kẹt ${q_cnt} mail trong Queue (Ngưỡng Warning: ${WARN_QUEUE_PER_USER})")
            fi
        fi

        [[ "$severity" == "NORMAL" ]] && continue

        if ! should_send_alert "$sender" "$severity"; then
            log_msg "INFO" "Bỏ qua cảnh báo lặp lại (Cooldown) cho $sender [$severity]"
            continue
        fi

        local action_taken="Chỉ gửi cảnh báo (Mức WARNING)"
        if [[ "$severity" == "CRITICAL" ]]; then
            action_taken=$(lock_zimbra_account "$sender")
            hold_sender_queue "$sender"
        fi

        record_alert_state "$sender" "$severity"
        alerts_triggered=$(( alerts_triggered + 1 ))

        local reason_str
        reason_str=$(IFS='; '; echo "${reasons[*]}")
        log_msg "$severity" "Phát hiện Spam: user=$sender | ${LOOKBACK_MINUTES}m=${win_tot} | 1h=${hr_tot} | queue=${q_cnt} | action=${action_taken}"

        local icon="⚠️"
        [[ "$severity" == "CRITICAL" ]] && icon="🚨"

        local tg_msg
        tg_msg=$(cat <<EOF
${icon} <b>[ZIMBRA SPAM ${severity}] PHÁT HIỆN TÀI KHOẢN SPAM</b>
━━━━━━━━━━━━━━━━━━━━━━
🖥 <b>Server:</b> <code>$(html_escape "$srv_host")</code> (${srv_ip})
🕒 <b>Thời gian:</b> ${now_str}
👤 <b>Tài khoản Spam:</b> <code>$(html_escape "$sender")</code>
📌 <b>Lý do:</b> $(html_escape "$reason_str")

📊 <b>Thống kê lưu lượng gửi ra:</b>
• <b>Trong ${LOOKBACK_MINUTES} phút qua:</b> <b>${win_tot}</b> email (Sent: ${win_snt} | Deferred: ${win_def} | Bounced: ${win_bnc})
• <b>Trong 60 phút qua:</b> <b>${hr_tot}</b> email (Sent: ${hr_snt} | Deferred: ${hr_def} | Bounced: ${hr_bnc})
• <b>Đang kẹt trong Queue:</b> <b>${q_cnt}</b> email (Tổng Queue toàn server: ${total_queue})
• <b>IP nguồn gửi:</b> <code>$(html_escape "$s_ips")</code>
• <b>Domain đích:</b> <code>$(html_escape "$s_doms")</code>
• <b>Chi tiết Queue:</b> <i>$(html_escape "$q_reason")</i>

🛡 <b>Hành động tự động:</b>
<b>$(html_escape "$action_taken")</b>
━━━━━━━━━━━━━━━━━━━━━━
💡 <i>Lệnh mở khóa sau khi đổi mật khẩu:</i>
<code>zimbra-spam-monitor --unlock $(html_escape "$sender")</code>
EOF
)

        local mail_subj="[Zimbra Spam ${severity}] Phát hiện tài khoản ${sender} đang gửi spam trên ${srv_host}"
        local mail_body
        mail_body=$(cat <<EOF
======================================================================
CẢNH BÁO HỆ THỐNG GIÁM SÁT EMAIL SPAM ZIMBRA (${severity})
======================================================================
Máy chủ Zimbra  : ${srv_host} (${srv_ip})
Thời gian       : ${now_str}
Tài khoản Spam  : ${sender}
Mức độ cảnh báo : ${severity}
Nguyên nhân     : ${reason_str}

----------------------------------------------------------------------
THỐNG KÊ CHI TIẾT SỐ LƯỢNG EMAIL SPAM RA NGOÀI:
----------------------------------------------------------------------
1. Trong ${LOOKBACK_MINUTES} phút gần nhất : ${win_tot} email
   - Đã gửi thành công (Sent)   : ${win_snt}
   - Đang trì hoãn (Deferred)   : ${win_def}
   - Bị trả lại (Bounced)       : ${win_bnc}

2. Trong 60 phút (1 giờ) qua   : ${hr_tot} email
   - Đã gửi thành công (Sent)   : ${hr_snt}
   - Đang trì hoãn (Deferred)   : ${hr_def}
   - Bị trả lại (Bounced)       : ${hr_bnc}

3. Hàng đợi Postfix (Queue)    : ${q_cnt} email của tài khoản này
   - Tổng Queue toàn hệ thống   : ${total_queue} (Active: ${active_queue}, Deferred: ${def_queue}, Hold: ${hold_queue})
   - Lý do kẹt trong Queue      : ${q_reason}

4. Nguồn phát tán:
   - Địa chỉ IP đăng nhập       : ${s_ips}
   - Các tên miền nhận chính    : ${s_doms}

----------------------------------------------------------------------
HÀNH ĐỘNG XỬ LÝ TỰ ĐỘNG CỦA HỆ THỐNG:
----------------------------------------------------------------------
-> ${action_taken}

Hướng dẫn xử lý cho Quản trị viên:
1. Đổi mật khẩu tài khoản bị lộ:
   su - zimbra -c "zmprov sp ${sender} <MatKhauMoi>"
2. Mở khóa lại tài khoản:
   zimbra-spam-monitor --unlock ${sender}
======================================================================
EOF
)

        send_telegram_alert "$tg_msg"
        send_email_alert "$mail_subj" "$mail_body" "$total_queue"

    done < "$tmp_merged"

    if (( total_queue >= WARN_TOTAL_QUEUE )) && (( alerts_triggered == 0 )); then
        if should_send_alert "__SYSTEM_TOTAL_QUEUE__" "WARNING"; then
            record_alert_state "__SYSTEM_TOTAL_QUEUE__" "WARNING"
            local q_tg_msg
            q_tg_msg=$(cat <<EOF
⚠️ <b>[ZIMBRA QUEUE WARNING] HÀNG ĐỢI EMAIL TĂNG CAO</b>
━━━━━━━━━━━━━━━━━━━━━━
🖥 <b>Server:</b> <code>$(html_escape "$srv_host")</code> (${srv_ip})
🕒 <b>Thời gian:</b> ${now_str}
📦 <b>Tổng số mail trong Queue:</b> <b>${total_queue}</b> (Ngưỡng cảnh báo: ${WARN_TOTAL_QUEUE})
• Active: ${active_queue} | Deferred: ${def_queue} | Hold: ${hold_queue}
EOF
)
            send_telegram_alert "$q_tg_msg"
            send_email_alert "[Zimbra Queue Warning] Hàng đợi trên ${srv_host} đạt ${total_queue} email" \
                "Tổng số email trong hàng đợi Postfix trên ${srv_host} (${srv_ip}) hiện tại là ${total_queue} (Active: ${active_queue}, Deferred: ${def_queue}, Hold: ${hold_queue})." \
                "$total_queue"
        fi
    fi

    rm -f "$tmp_log_stats" "$tmp_q_stats" "$tmp_q_sum" "$tmp_merged" "$lock_file"
}

