WARN_RECIPIENTS=${WARN_RECIPIENTS}
CRIT_RECIPIENTS=${CRIT_RECIPIENTS}
CRIT_MIN_MESSAGES_FOR_BULK=${CRIT_MIN_MESSAGES_FOR_BULK}
WARN_UNIQUE_RECIPIENTS=${WARN_UNIQUE_RECIPIENTS}
CRIT_UNIQUE_RECIPIENTS=${CRIT_UNIQUE_RECIPIENTS}
MIN_EXTERNAL_DOMAINS_FOR_UNIQUE=${MIN_EXTERNAL_DOMAINS_FOR_UNIQUE}
MIN_RECIPIENTS_FOR_FAIL_RATE=${MIN_RECIPIENTS_FOR_FAIL_RATE}
WARN_FAILED_RATE_PCT=${WARN_FAILED_RATE_PCT}
CRIT_MIN_RECIPIENTS_FOR_FAIL_RATE=${CRIT_MIN_RECIPIENTS_FOR_FAIL_RATE}
CRIT_FAILED_RATE_PCT=${CRIT_FAILED_RATE_PCT}
WARN_SOURCE_IPS=${WARN_SOURCE_IPS}
WARN_MIN_MESSAGES_FOR_IPS=${WARN_MIN_MESSAGES_FOR_IPS}
CRIT_SOURCE_IPS=${CRIT_SOURCE_IPS}
CRIT_MIN_MESSAGES_FOR_IPS=${CRIT_MIN_MESSAGES_FOR_IPS}
WARN_SPOOF_COUNT=${WARN_SPOOF_COUNT}
CRIT_SPOOF_COUNT=${CRIT_SPOOF_COUNT}
AMAVIS_SPAM_SCORE_THRESHOLD="${AMAVIS_SPAM_SCORE_THRESHOLD}"
WARN_SPAM_SIGNALS=${WARN_SPAM_SIGNALS}
CRIT_SPAM_SIGNALS=${CRIT_SPAM_SIGNALS}
WARN_QUEUE_PER_USER=${WARN_QUEUE_PER_USER}
CRIT_QUEUE_PER_USER=${CRIT_QUEUE_PER_USER}
WARN_TOTAL_QUEUE=${WARN_TOTAL_QUEUE}
AUTO_LOCK_ON_CRITICAL="${AUTO_LOCK_ON_CRITICAL}"
AUTO_HOLD_QUEUE_ON_CRITICAL="${AUTO_HOLD_QUEUE_ON_CRITICAL}"
TELEGRAM_ENABLED="${TELEGRAM_ENABLED}"
TELEGRAM_BOT_TOKEN="${TELEGRAM_BOT_TOKEN}"
TELEGRAM_CHAT_ID="${TELEGRAM_CHAT_ID}"
EMAIL_ENABLED="${EMAIL_ENABLED}"
EMAIL_DELIVERY_MODE="${EMAIL_DELIVERY_MODE}"
ALERT_EMAIL_TO="${ALERT_EMAIL_TO}"
ALERT_EMAIL_FROM="${ALERT_EMAIL_FROM}"
SMTP_HOST="${SMTP_HOST}"
SMTP_PORT="${SMTP_PORT}"
