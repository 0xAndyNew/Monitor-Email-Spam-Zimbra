<b>System Queue :</b> <b>${total_queue}</b> emails
  <code>Active: ${active_queue} | Deferred: ${def_queue} | Hold: ${hold_queue}</code>

<b>[3] SYSTEM OUTBOUND (LAST ${LOOKBACK_MINUTES}M)</b>
<b>Total Traffic:</b> <b>${sys_tot}</b> emails
  <code>Sent: ${sys_snt} | Deferred: ${sys_def} | Bounced: ${sys_bnc}</code>
<code>==============================</code>
EOF
)

        local mail_subj="[Zimbra Spam ${severity}] ${sender} (${msgs} msgs / ${rcpts} rcpts) on ${srv_host}"
        local mail_body
        mail_body=$(cat <<EOF
============================================================
         ZIMBRA SPAM ALERT - ${severity}
============================================================
Server        : ${srv_host} (${srv_ip})
Alert Time    : ${now_str}
Spam Time     : ${spam_time_str}
Spam Account  : ${sender}
Origin        : ${s_origin}
Account State : ${action_taken}
Source IPs    : ${ip_display}
Risk Score    : ${risk_score:-0}/100
Reason        : ${reasons_disp}${next_steps_txt}

------------------------------------------------------------
[1] ACCOUNT SPAM METRICS (LAST ${LOOKBACK_MINUTES} MINS)
------------------------------------------------------------
Messages Sent : ${msgs} msgs (1h: ${h1_msgs} | 24h: ${d24_msgs})
Recipients    : ${rcpts} total (Unique: ${uniq_rcpts} | Domains: ${uniq_doms} | 1h: ${h1_rcpts})
Failed Rate   : ${fail_pct_str}% (${failed_cnt}/${rcpts} failed)
                Sent: ${snt} | Deferred: ${def} | Bounced: ${bnc}
Spam Signals  : Amavis SPAM: ${amavis_cnt} | Spoof From: ${spoof_cnt} | RBL: ${rbl_cnt}

------------------------------------------------------------
[2] REMAINING MAIL QUEUE
------------------------------------------------------------
Account Queue : ${q_cnt} emails (Hold: ${q_hold})
System Queue  : ${total_queue} emails
                Active: ${active_queue} | Deferred: ${def_queue} | Hold: ${hold_queue}

------------------------------------------------------------
[3] SYSTEM OUTBOUND (LAST ${LOOKBACK_MINUTES} MINS)
------------------------------------------------------------
Total Traffic : ${sys_tot} emails
                Sent: ${sys_snt} | Deferred: ${sys_def} | Bounced: ${sys_bnc}
============================================================
EOF
)
        local wh_json
        wh_json=$(build_webhook_payload "$mail_body" "$gjson")

        # Record cooldown after dispatching (failed channels are queued in outbox for retry)
        dispatch_notifications "alert_${sender}_${severity}" "$tg_msg" "$mail_subj" "$mail_body" "$total_queue" "$wh_json" || true
        record_alert_state "$sender" "$severity"
        detail_alerts_sent=$(( detail_alerts_sent + 1 ))

    done < "$tmp_merged"

    # Send 1 consolidated overflow summary if more than MAX_ALERTS_PER_CYCLE accounts triggered
    if (( overflow_count > 0 )); then
        local ov_tg ov_mail
        ov_tg=$(cat <<EOF
<b>[ZIMBRA SPAM OVERFLOW SUMMARY]</b>
<code>==============================</code>
<b>Server   :</b> <code>$(html_escape "$srv_host")</code> (${srv_ip})
<b>Time     :</b> ${now_str}
<b>Extra    :</b> <b>${overflow_count}</b> additional account(s) triggered (capped at ${MAX_ALERTS_PER_CYCLE} detailed alerts/cycle)
${overflow_html}<code>==============================</code>
EOF
)
        ov_mail=$(cat <<EOF
============================================================
         ZIMBRA SPAM OVERFLOW SUMMARY (+${overflow_count} accounts)
============================================================
Server : ${srv_host} (${srv_ip})
Time   : ${now_str}

Additional accounts triggered (detailed alerts capped at ${MAX_ALERTS_PER_CYCLE}/cycle):
${overflow_lines}============================================================
EOF
)
        dispatch_notifications "overflow_${now_epoch}" "$ov_tg" "[Zimbra Spam Summary] +${overflow_count} more account(s) on ${srv_host}" "$ov_mail" "$total_queue" "" || true
    fi

    # 4. Consolidated Brute-Force Summary (from audit.log + zimbra.log SASL fails)
    process_brute_force_alerts "$tmp_aux_auth" "$tmp_sasl_fail" "$srv_host" "$srv_ip" "$now_str"

    # 5. System-Wide Queue Warning (only when no per-account spam alert already fired)
    if (( total_queue >= WARN_TOTAL_QUEUE )) && (( alerts_triggered == 0 )); then
        if should_send_alert "__SYSTEM_TOTAL_QUEUE__" "WARNING"; then
            local q_tg_msg q_mail_body q_gjson q_wh_json
            q_tg_msg=$(cat <<EOF
<b>[ZIMBRA QUEUE WARNING]</b>
