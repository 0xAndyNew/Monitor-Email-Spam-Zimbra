# ==============================================================================
# ZIMBRA SPAM MONITOR CRON SCHEDULE (/etc/cron.d/zimbra-spam-monitor)
# Default: Runs every 5 minutes.
# You can change the schedule anytime via: zimbra-spam-monitor
# ==============================================================================
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin:/opt/zimbra/common/sbin:/opt/zimbra/bin

*/5 * * * * root /usr/bin/zimbra-spam-monitor --run >/dev/null 2>&1
