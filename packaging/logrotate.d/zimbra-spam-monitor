/var/log/zimbra-spam-monitor.log /var/log/zimbra-spam-monitor-events.jsonl {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root root
}

/var/lib/zimbra-spam-monitor/attacker_ips.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
